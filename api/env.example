# PocketBase 설정
PB_URL=http://127.0.0.1:8090

# API 서버 설정
PORT=3001
NODE_ENV=development
CORS_ORIGIN=*

# PocketBase 관리자 설정 (Docker Compose 사용 시)
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=changeme123

# PocketBase 인증 토큰 (필요한 경우)
# PB_TOKEN=your_token_here

# Redis 설정 (Cache-Aside 패턴용)
# Docker Compose 사용 시: redis://redis:6379
# 로컬 개발 시: redis://localhost:6379
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 조회수 캐시 설정
VIEW_CACHE_TTL=3600
VIEW_CACHE_PREFIX=view_count:

# PocketBase 관리자 설정 (Docker Compose 사용 시)
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASS=changeme123 