{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --apply .",
    "check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "dev": "tsx --env-file .env src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate:published": "tsx --env-file .env scripts/migrate-published-content.ts",
    "migrate:changed": "tsx --env-file .env scripts/migrate-changed-files.ts",
    "docker:build": "docker build -t jinmu-api .",
    "docker:run": "docker run -p 3001:3001 --env-file .env jinmu-api",
    "docker:up": "docker-compose --env-file .env up -d ",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker system prune -f && docker volume prune -f",
    "docker:redis": "docker-compose up -d redis",
    "docker:api": "docker-compose up -d api",
    "docker:restart": "docker-compose restart",
    "docker:status": "docker-compose ps"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "gray-matter": "^4.0.3",
    "ioredis": "^5.3.2",
    "pocketbase": "^0.24.0",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "22.13.0",
    "@types/supertest": "^6.0.3",
    "@types/winston": "^2.4.4",
    "@vitest/ui": "^3.2.4",
    "supertest": "^7.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  }
}
