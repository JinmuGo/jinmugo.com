  },
  "dependencies": {
    "@supabase/supabase-js": "^2.53.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "22.13.0",
    "dotenv": "^17.2.1",
    "supabase": "^2.40.7",
