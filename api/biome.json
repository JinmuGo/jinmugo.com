{
  "root": false,
  "extends": "//",
  "files": {
    "includes": ["**/*.ts", "**/*.js", "**/*.json", "**/*.prisma", "!**/*.d.ts"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "semicolons": "always"
    }
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noConsole": "warn"
      }
    }
  }
}
