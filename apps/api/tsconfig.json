{
  "extends": "../../packages/tsconfig/node.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@jinmu/types": ["../../packages/types/src"],
      "@jinmu/utils": ["../../packages/utils/src"]
    },
    "removeComments": true,
    "noImplicitReturns": false,
    "noEmit": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["vitest/globals"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "pocketbase"],
  "references": [{ "path": "../../packages/types" }, { "path": "../../packages/utils" }]
}
