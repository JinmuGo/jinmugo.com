{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --apply .",
    "check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "dev": "tsx --env-file .env src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate:published": "tsx --env-file .env scripts/migrate-published-content.ts",
    "migrate:changed": "tsx --env-file .env scripts/migrate-changed-files.ts",
    "migrate:firestore": "tsx --env-file .env scripts/migrate-to-firestore.ts",
    "docker:build": "docker build -t jinmu-api .",
    "docker:run": "docker run -p 3001:3001 --env-file .env jinmu-api",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker system prune -f && docker volume prune -f"
  },
  "dependencies": {
    "@jinmu/types": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^13.6.0",
    "gray-matter": "^4.0.3",
    "helmet": "^8.1.0",
    "node-cron": "^4.2.1",
    "pocketbase": "^0.26.5",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^6.0.2",
    "@types/helmet": "^4.0.0",
    "@types/node": "24.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.3",
    "@vitest/ui": "^4.0.15",
    "supertest": "^7.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
