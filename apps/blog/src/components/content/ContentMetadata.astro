---
import FormattedDate from "@/components/content/FormattedDate.astro"
import { PageViewIsland } from "@/components/features/PageViewIsland"

interface Props {
  category?: string
  date: Date
  slug: string
  showViews?: boolean
  variant?: "default" | "compact"
}

const { category, date, slug, showViews = true, variant = "default" } = Astro.props
---

<div class:list={[
	"text-sm",
	variant === "default" ? "text-gray-500 dark:text-gray-300" : "text-gray-600 dark:text-gray-400"
]}>
	{category && (
		<>
			<a href={`/archives/category/${category}`} class="underline">
				{category}
			</a>
			<span> / </span>
		</>
	)}
	<FormattedDate date={date} />
</div>

{showViews && (
	<div class="flex items-center gap-2">
		<PageViewIsland client:load slug={slug} />
	</div>
)}
