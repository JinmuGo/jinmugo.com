---
import Layout from "@/layouts/Layout.astro"
import ListLayouts from "@/layouts/ListLayouts"
import { getEnglishMemos, sortMemosByDate } from "@/utils/content/memos"
import { buildItemUrl, buildPageUrl, generatePostsPageSchema } from "@/utils/structuredData"

// 모든 영어 메모 가져오기
const memos = await getEnglishMemos()
const sortedMemos = sortMemosByDate(memos)

const title = "Memos"
const description = "Memo collection"

// 구조화된 데이터 생성
const jsonLd = generatePostsPageSchema({
  title,
  description,
  url: buildPageUrl("/en", "/memos"),
  keywords: "memos, notes, collection",
  inLanguage: "en",
  itemListElements: sortedMemos.map((memo, index) => ({
    "@type": "ListItem",
    url: buildItemUrl(`/en/memos/${memo.slug}`),
    position: index + 1,
    item: {
      "@type": "Article",
      name: memo.data.title,
      url: buildItemUrl(`/en/memos/${memo.slug}`),
    },
  })),
})
---

<Layout
  title={title}
  description={description}
  lang="en"
  jsonLd={jsonLd}
  type="website"
>
  <ListLayouts
    posts={sortedMemos.map((memo) => ({
      ...memo.data,
      slug: memo.slug,
    }))}
    title={title}
    postType="memo"
    client:load
  />
</Layout>
