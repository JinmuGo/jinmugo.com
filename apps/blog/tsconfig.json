{
  "extends": "astro/tsconfigs/strict",
  "include": [
    "**/*"
  ],
  "exclude": [
    "dist",
    ".astro/**"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "~/*": [
        "./*"
      ],
      "@jinmu/types": ["../../packages/types/src"],
      "@jinmu/utils": ["../../packages/utils/src"]
    }
  },
  "references": [
    { "path": "../../packages/types" }
  ]
}
