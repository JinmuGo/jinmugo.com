{
	"name": "jinmu.me",
	"title": "Jinmu Go's Blog",
	"description": "A Smooth Sea Never Made a Skilled Sailor",
	"author": "Jinmu Go",
	"email": "hi@jinmugo.com",
	"type": "module",
	"version": "0.0.1",
	"homepage": "https://jinmugo.com",
	"cdnUrl": "https://cdn.jinmugo.com",
	"social": {
		"github": "https://github.com/JinmuGo",
		"linkedin": "https://www.linkedin.com/in/jinmugo"
	},
	"packageManager": "pnpm@10.13.1",
	"scripts": {
		"dev": "OBSIDIAN_VAULT_PATH= pnpm prebuild && OBSIDIAN_VAULT_PATH= concurrently --kill-others \"node scripts/watch-obsidian.js --skip-initial-build\" \"astro dev --host\"",
		"dev:no-watch": "OBSIDIAN_VAULT_PATH= pnpm prebuild && astro dev --host",
		"prebuild": "node scripts/build-content.js",
		"build": "pnpm prebuild && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"deploy:gsc": "node scripts/submit-to-gsc.js",
		"translate": "node --env-file=.env scripts/translate.js",
		"translate:staged": "node --env-file=.env scripts/translate.js --staged-only",
		"translate:dry-run": "node scripts/translate.js --dry-run",
		"gallery:manifest": "node --env-file=.env scripts/build-gallery-manifest.js",
		"content:doctor": "node scripts/content-doctor.js",
		"content:preview": "pnpm prebuild && pnpm astro build",
		"content:publish": "node scripts/content-publish.js",
		"verify:links": "node scripts/verify-links.js",
		"ci:local": "bash scripts/ci-local.sh",
		"verify:tables": "node scripts/verify-tables.js",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"check": "biome check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "pnpm prebuild && astro check"
	},
	"dependencies": {
		"@astrojs/mdx": "^7.0.8",
		"@astrojs/react": "^5.0.7",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@aws-sdk/client-s3": "^3.1166.0",
		"@iconify-json/lucide": "^1.2.153",
		"@r4ai/remark-callout": "^0.6.2",
		"@radix-ui/react-accordion": "^1.3.1",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-popover": "^1.3.1",
		"@radix-ui/react-slot": "^1.5.0",
		"@shikijs/transformers": "^4.6.0",
		"@tailwindcss/vite": "^4.3.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"astro": "^7.4.12",
		"astro-icon": "^1.2.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"exifr": "^7.1.3",
		"lodash.debounce": "^4.0.8",
		"lucide-react": "^1.72.0",
		"markdown-it": "^14.3.3",
		"photoswipe": "^5.4.4",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"sanitize-html": "^2.18.1",
		"satori": "^0.63.2",
		"sharp": "^0.35.5",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.5",
		"unist-util-visit": "^5.2.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@biomejs/biome": "2.6.6",
		"@commitlint/cli": "^20.5.0",
		"@commitlint/config-conventional": "^20.5.0",
		"@tailwindcss/typography": "^0.5.20",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.3",
		"@types/lodash.debounce": "^4.0.9",
		"@types/markdown-it": "^14.1.2",
		"@types/mdast": "^4.0.4",
		"@types/sanitize-html": "^2.16.2",
		"@types/unist": "^3.0.3",
		"@vitest/coverage-v8": "^4.1.12",
		"chokidar": "^5.0.0",
		"concurrently": "^9.2.5",
		"dotenv": "^17.4.0",
		"google-auth-library": "^10.6.2",
		"jsdom": "^29.1.1",
		"lefthook": "^2.2.2",
		"mdast-util-mdx-jsx": "^3.2.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite-plugin-remove-console": "^2.2.0",
		"vitest": "^4.1.12"
	}
}
