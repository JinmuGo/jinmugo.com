{
	"name": "jinmu.me",
	"title": "Jinmu Go's Blog",
	"description": "A Smooth Sea Never Made a Skilled Sailor",
	"author": "Jinmu Go",
	"email": "hi@jinmu.me",
	"type": "module",
	"version": "0.0.1",
	"homepage": "https://jinmu.me",
	"cdnUrl": "https://cdn.jinmu.me",
	"social": {
		"github": "https://github.com/JinmuGo",
		"linkedin": "https://www.linkedin.com/in/jinmugo"
	},
	"packageManager": "pnpm@10.13.1",
	"scripts": {
		"dev": "OBSIDIAN_VAULT_PATH= pnpm prebuild && OBSIDIAN_VAULT_PATH= concurrently --kill-others \"node scripts/watch-obsidian.js --skip-initial-build\" \"astro dev --host\"",
		"dev:no-watch": "OBSIDIAN_VAULT_PATH= pnpm prebuild && astro dev --host",
		"prebuild": "node scripts/build-content.js",
		"build": "pnpm prebuild && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"deploy:gsc": "node scripts/submit-to-gsc.js && node scripts/submit-urls-to-gsc.js",
		"translate": "node --env-file=.env scripts/translate.js",
		"translate:staged": "node --env-file=.env scripts/translate.js --staged-only",
		"gallery:manifest": "node --env-file=.env scripts/build-gallery-manifest.js",
		"weekly:new": "node scripts/weekly-new.js",
		"content:doctor": "node scripts/content-doctor.js",
		"content:preview": "pnpm prebuild && pnpm astro build",
		"content:publish": "node scripts/content-publish.js",
		"cover": "node scripts/add-cover.js",
		"verify:tables": "node scripts/verify-tables.js",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --apply .",
		"check": "biome check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@astrojs/mdx": "^5.0.3",
		"@astrojs/react": "^5.0.2",
		"@astrojs/rss": "^4.0.18",
		"@aws-sdk/client-s3": "^3.1022.0",
		"@fuma-comment/react": "^1.4.1",
		"@iconify-json/lucide": "^1.2.101",
		"@r4ai/remark-callout": "^0.6.2",
		"@radix-ui/react-accordion": "^1.2.12",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@shikijs/transformers": "^4.0.2",
		"@tailwindcss/vite": "^4.2.2",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"astro": "^6.4.6",
		"astro-icon": "^1.1.5",
		"astro-themes": "^0.2.7",
		"better-auth": "^1.6.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.1.0",
		"exifr": "^7.1.3",
		"lodash.debounce": "^4.0.8",
		"lucide-react": "^1.7.0",
		"markdown-it": "^14.2.0",
		"motion": "^12.38.0",
		"next-themes": "^0.4.6",
		"photoswipe": "^5.4.4",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"sanitize-html": "^2.17.2",
		"satori": "^0.26.0",
		"sharp": "^0.34.5",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.2",
		"unist-util-visit": "^5.1.0",
		"uploadthing": "^7.7.4"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@biomejs/biome": "2.4.10",
		"@commitlint/cli": "^20.5.0",
		"@commitlint/config-conventional": "^20.5.0",
		"@tailwindcss/typography": "^0.5.19",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/lodash.debounce": "^4.0.9",
		"@types/markdown-it": "^14.1.2",
		"@types/sanitize-html": "^2.16.1",
		"@vitest/coverage-v8": "^4.1.2",
		"chokidar": "^5.0.0",
		"concurrently": "^9.2.1",
		"dotenv": "^17.4.0",
		"google-auth-library": "^10.6.2",
		"jsdom": "^29.1.1",
		"lefthook": "^2.1.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite-plugin-remove-console": "^2.2.0",
		"vitest": "^4.1.2"
	}
}
