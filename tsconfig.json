{
  "extends": "astro/tsconfigs/strict",
  "include": [
    "**/*"
  ],
  "exclude": [
    "dist",
    ".astro/**"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "~/*": [
        "./*"
      ]
    }
  }
}
