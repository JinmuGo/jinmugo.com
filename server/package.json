{
  "name": "jinmu-comment-server",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "pnpm build && node --test test/*.test.js",
    "db:backup": "node dist/backup.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/migrate.js",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fuma-comment/server": "1.4.1",
    "@hono/node-server": "1.19.15",
    "better-auth": "1.6.22",
    "better-sqlite3": "12.8.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.34"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.5.2",
    "drizzle-kit": "0.31.10",
    "tsx": "4.21.0",
    "typescript": "6.0.2"
  }
}
