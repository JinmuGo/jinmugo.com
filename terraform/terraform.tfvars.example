# Terraform 변수 설정
# 이 파일을 terraform.tfvars로 복사하고 실제 값으로 수정하세요.
# 주의: terraform.tfvars는 .gitignore에 포함되어 있어야 합니다.

project_id  = "adept-depth-310523"  # GCP 프로젝트 ID (프로젝트 이름: blog-project)
region      = "asia-northeast3"  # GCP 리전
database_id = "(default)"  # Firestore 데이터베이스 ID (기본값: "(default)")

# 참고: 인증 정보(credentials)는 이 파일에 포함하지 않습니다.
# 대신 다음 방법 중 하나를 사용하세요:
# 1. 환경변수: export GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account-key.json"
# 2. Application Default Credentials: gcloud auth application-default login
# 3. Provider 블록에서 직접 지정 (main.tf 참고)
