---
import UserSection from "@/components/app-shell/Comment/UserSection.astro"
import ContentMetadata from "@/components/content/ContentMetadata.astro"
import Prose from "@/components/layout/Prose.astro"
import Breadcrumb from "@/components/seo/Breadcrumb.astro"
import Layout from "@/layouts/Layout.astro"
import type { PostMetadata } from "@/types/content"
import type { ContentType } from "@/types/utils"
import { getArchivePath } from "@/utils/archive"
import { generateContentSchemas } from "@/utils/contentSchemas"
import { buildContentOgImagePath } from "@/utils/openGraphMeta"

interface Props {
  frontmatter: PostMetadata
  contentType?: ContentType
}

const { frontmatter, contentType = "post" } = Astro.props
const { title, date, lastmod, summary, category, slug, tags } = frontmatter

// Generate all schemas using consolidated utility
const { pageSchema, breadcrumbSchema, breadcrumbItems, lang } = generateContentSchemas({
  frontmatter,
  pathname: Astro.url.pathname,
  origin: Astro.url.origin,
  contentType,
})
---

<Layout
  frontmatter={frontmatter}
  title={title}
  description={summary || title}
  lang={lang}
  jsonLd={[pageSchema, breadcrumbSchema]}
  ogImage={buildContentOgImagePath({ contentType, slug, pathname: Astro.url.pathname })}
  type="article"
  tags={tags}
  publishedTime={date}
  modifiedTime={lastmod}
>
  <Breadcrumb items={breadcrumbItems}/>
  <header class="text-center">
    <div id="post-title" class="pt-10 space-y-4">
      <h1 class="font-semibold text-3xl md:text-4xl leading-tight tracking-tight text-gray-900 dark:text-gray-50 text-balance break-keep">{title}</h1>
      {summary && <p class="text-lg text-gray-500 dark:text-gray-400 text-balance break-keep">{summary}</p>}
      <div class="flex items-center justify-center gap-3 pt-2 text-sm text-gray-600 dark:text-gray-400 flex-wrap">
        {category && (
          <>
            <a
              class="inline-flex items-center px-2.5 py-1 rounded-full bg-primary-50 dark:bg-primary-950/30 text-primary-700 dark:text-primary-300 hover:bg-primary-100 dark:hover:bg-primary-900/40 transition-colors duration-200 font-medium"
              href={getArchivePath(lang === "en" ? "/en" : "", "category", category)}
            >
              {category}
            </a>
            <span class="text-gray-400 dark:text-gray-500">•</span>
          </>
        )}
        <ContentMetadata date={date} />
      </div>
    </div>
  </header>
  <Prose as="article">
    <slot />
  </Prose>
  <UserSection slug={slug} frontmatter={frontmatter} type="post" />
</Layout>
