---
import { Image } from "astro:assets"
import Prose from "@/components/layout/Prose.astro"
import PersonHeader from "@/components/library/PersonHeader.astro"
import Breadcrumb from "@/components/seo/Breadcrumb.astro"
import Layout from "@/layouts/Layout.astro"
import type { DirectorWithSlug, MovieWithSlug } from "@/types/library"

interface Props {
  director: DirectorWithSlug
  works: MovieWithSlug[]
  hasEssay: boolean
  lang?: "ko" | "en"
}

const { director, works, hasEssay, lang = "ko" } = Astro.props
const data = director.data

const formatDate = (d?: Date) =>
  d ? `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}` : "—"

const basePath = lang === "en" ? "/en" : ""
const breadcrumbItems = [
  { name: "Library", item: `${basePath}/library/` },
  { name: "Movies", item: `${basePath}/library/movies/` },
  { name: "Directors", item: `${basePath}/library/movies/` },
  { name: data.name, item: `${basePath}${director.href}` },
]

const meta = [data.birthYear, data.country].filter(Boolean).join(" · ")
const aboutHeading = lang === "en" ? "About the director" : "이 감독에 대해"
const worksHeading = lang === "en" ? "Watched Works" : "본 작품"
---

<Layout title={`${data.name} · Directors`} description={data.bio ?? data.name} lang={lang}>
  <div class="py-10">
    <Breadcrumb items={breadcrumbItems} />

    <PersonHeader
      name={data.name}
      role="Director"
      meta={meta}
      bio={data.bio}
      photo={data.photo}
    />

    <section class="pt-7">
      <div class="font-mono text-[11px] uppercase tracking-wider text-stone-500 font-semibold mb-4">
        {worksHeading} · {works.length}
      </div>
      <ul class="flex flex-col divide-y divide-stone-200 dark:divide-stone-700">
        {
          works.map((w, idx) => (
            <li class="flex gap-3.5 py-3.5 items-center">
              <span class="font-mono tabular-nums text-xs text-stone-400 w-7">
                {String(idx + 1).padStart(3, "0")}
              </span>
              {w.data.cover ? (
                <Image
                  src={w.data.cover}
                  alt={w.data.title}
                  width={72}
                  height={108}
                  class="w-9 aspect-[2/3] rounded-sm object-cover bg-stone-200"
                  loading="lazy"
                />
              ) : (
                <div class="w-9 aspect-[2/3] rounded-sm bg-stone-300 dark:bg-stone-700" aria-hidden="true" />
              )}
              <div class="flex-1 text-sm text-stone-700 dark:text-stone-200">
                {w.hasEssay ? (
                  <a href={w.href} class="hover:text-[#D97706]">
                    {w.data.title}
                    <span class="text-stone-400 text-xs ml-1.5">{w.data.year}</span>
                  </a>
                ) : (
                  <span>
                    {w.data.title}
                    <span class="text-stone-400 text-xs ml-1.5">{w.data.year}</span>
                  </span>
                )}
              </div>
              <div class="text-xs text-stone-500">
                {w.data.rating && (
                  <span class="text-[#D97706] mr-2">{"★".repeat(w.data.rating)}</span>
                )}
                {formatDate(w.data.dateWatched)}
                {w.hasEssay && <span class="text-[#D97706] ml-2">✎</span>}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    {
      hasEssay && (
        <section class="pt-7 mt-6 border-t border-stone-200 dark:border-stone-700">
          <h3 class="font-display text-base font-semibold mb-3">{aboutHeading}</h3>
          <Prose as="div">
            <slot />
          </Prose>
        </section>
      )
    }
  </div>
</Layout>
