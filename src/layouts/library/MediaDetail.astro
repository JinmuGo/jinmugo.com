---
import PostBannerY from "@/layouts/PostBannerY.astro"
import type { PostMetadata } from "@/types/content"
import type { MediaItem } from "@/types/library"

interface Props {
  item: MediaItem
}

const { item } = Astro.props

const frontmatter = {
  title: item.title,
  date: item.dateConsumed ?? new Date(item.year, 0, 1),
  draft: false,
  tags: item.tags,
  summary: item.oneLiner,
  slug: item.slug,
  href: item.href,
  category: item.kind,
} as PostMetadata
---

<PostBannerY frontmatter={frontmatter} bannerImage={item.cover!}>
  <slot />
</PostBannerY>
