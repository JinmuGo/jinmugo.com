---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"
import UserSection from "@/components/app-shell/Comment/UserSection.astro"
import ContentMetadata from "@/components/content/ContentMetadata.astro"
import Prose from "@/components/layout/Prose.astro"
import Breadcrumb from "@/components/seo/Breadcrumb.astro"
import Layout from "@/layouts/Layout.astro"
import type { WeeklyMetadata } from "@/types/content"
import { generateContentSchemas } from "@/utils/contentSchemas"
import { buildContentOgImagePath } from "@/utils/openGraphMeta"

interface Props {
  coverImage?: ImageMetadata
  frontmatter: WeeklyMetadata
}

const { coverImage, frontmatter } = Astro.props
const { title, date, lastmod, summary, slug, tags, coverAlt, year, week } = frontmatter

const { pageSchema, breadcrumbSchema, breadcrumbItems, lang } = generateContentSchemas({
  frontmatter,
  pathname: Astro.url.pathname,
  origin: Astro.url.origin,
  contentType: "weekly",
  imageUrl: coverImage ? `${Astro.url.origin}${coverImage.src}` : undefined,
})
---

<Layout
  frontmatter={frontmatter}
  title={title}
  description={summary || title}
  lang={lang}
  jsonLd={[pageSchema, breadcrumbSchema]}
  ogImage={buildContentOgImagePath({ contentType: "weekly", slug, pathname: Astro.url.pathname })}
  type="article"
  tags={tags}
  publishedTime={date}
  modifiedTime={lastmod}
>
  <Breadcrumb items={breadcrumbItems} />
  <article class="pt-4">
    <header class="mb-12 space-y-6 text-center">
      <div id="weekly-title" class="space-y-3">
        <h1 class="text-3xl font-semibold leading-tight tracking-tight text-gray-900 dark:text-gray-50 md:text-4xl text-balance break-keep">
          {title}
        </h1>
        <div class="flex flex-wrap items-center justify-center gap-3 text-sm text-gray-600 dark:text-gray-400">
          <ContentMetadata date={date} />
          {
            tags?.length ? (
              <>
                <span class="text-gray-300 dark:text-gray-600">/</span>
                <span>{tags.join(", ")}</span>
              </>
            ) : null
          }
        </div>
        {
          summary ? (
            <p class="mx-auto max-w-2xl text-lg leading-8 text-gray-600 dark:text-gray-300 text-balance break-keep">
              {summary}
            </p>
          ) : null
        }
      </div>

      {
        coverImage && (
          <figure class="overflow-hidden rounded-xl border border-gray-200 bg-gray-100 dark:border-gray-800 dark:bg-gray-900">
            <Image
              src={coverImage}
              alt={coverAlt ?? title}
              width={1200}
              class="h-auto w-full object-cover"
              sizes="(max-width: 768px) 100vw, 768px"
            />
          </figure>
        )
      }
    </header>

    <Prose as="article">
      <slot />
    </Prose>
  </article>

  <UserSection slug={slug} frontmatter={frontmatter} type="weekly" />
</Layout>
