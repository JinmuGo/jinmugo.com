---
import type { ImageMetadata, MarkdownHeading } from "astro"
import UserSection from "@/components/app-shell/Comment/UserSection.astro"
import PostHeader from "@/components/content/PostHeader.astro"
import SideRail from "@/components/content/SideRail.astro"
import Prose from "@/components/layout/Prose.astro"
import Layout from "@/layouts/Layout.astro"
import type { WeeklyMetadata } from "@/types/content"
import { generateContentSchemas } from "@/utils/contentSchemas"
import { buildContentOgImagePath } from "@/utils/openGraphMeta"
import { tocItems } from "@/utils/toc"

interface Props {
  coverImage?: ImageMetadata
  frontmatter: WeeklyMetadata
  headings?: MarkdownHeading[]
}

const { coverImage, frontmatter, headings = [] } = Astro.props
const { title, date, lastmod, summary, slug, tags, coverAlt } = frontmatter

const { pageSchema, breadcrumbSchema, lang } = generateContentSchemas({
  frontmatter,
  pathname: Astro.url.pathname,
  origin: Astro.url.origin,
  contentType: "weekly",
  imageUrl: coverImage ? `${Astro.url.origin}${coverImage.src}` : undefined,
})
---

<Layout
  frontmatter={frontmatter}
  title={title}
  description={summary || title}
  lang={lang}
  jsonLd={[pageSchema, breadcrumbSchema]}
  ogImage={buildContentOgImagePath({ contentType: "weekly", slug, pathname: Astro.url.pathname })}
  type="article"
  tags={tags}
  publishedTime={date}
  modifiedTime={lastmod}
>
  <SideRail label="Table of contents" items={tocItems(headings)} />
  <article>
    <PostHeader title={title} summary={summary} date={date} image={coverImage} imageAlt={coverAlt} />
    <Prose>
      <slot />
    </Prose>
  </article>

  <UserSection slug={slug} frontmatter={frontmatter} type="weekly" />
</Layout>
