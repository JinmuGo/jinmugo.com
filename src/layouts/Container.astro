---
import Footer from "@/components/app-shell/Footer/Footer.astro"
import { cn } from "@/utils/cn"

export interface Props {
  class?: string
  widthClass: string
}

const { class: className, widthClass } = Astro.props
---

<main
  class={cn(
    `mx-auto min-h-screen divide-gray-200 dark:divide-gray-800 flex flex-col justify-between ${widthClass}`,
    className,
  )}
>
  <section class="flex-1">
    <slot />
  </section>
  <Footer />
</main>
