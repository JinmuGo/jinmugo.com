---
import Layout from "@/layouts/Layout.astro"
import type { Post, Weekly } from "@/types/content"
import { generateArchiveBreadcrumbs } from "@/utils/breadcrumbUtils"
import { getKoreanPosts } from "@/utils/content/posts"
import { getKoreanWeeklies } from "@/utils/content/weekly"
import { withTrailingSlash } from "@/utils/language"
import { buildPageUrl, generateBreadcrumbSchema, generatePageSchema } from "@/utils/structuredData"

export async function getStaticPaths() {
  const posts = await getKoreanPosts()
  const weeklies = await getKoreanWeeklies()

  const allContent = [...posts, ...weeklies] as (Post | Weekly)[]

  const categories = [
    ...new Set(
      allContent
        .map((item) => ("category" in item.data ? item.data.category : undefined))
        .filter(Boolean),
    ),
  ]
  const tags = [...new Set([...allContent.flatMap((item) => item.data.tags ?? [])].filter(Boolean))]
  const years = [
    ...new Set([
      ...allContent
        .map((item) => (item.data.date ? new Date(item.data.date).getFullYear().toString() : null))
        .filter(Boolean),
    ]),
  ]

  const paths = [
    ...categories.map((category) => ({
      params: { classify: "category", target: category }, // 인코딩 X
    })),
    ...tags.map((tag) => ({
      params: { classify: "tag", target: tag }, // 인코딩 X
    })),
    ...years.map((year) => ({
      params: { classify: "year", target: year }, // 인코딩 X
    })),
  ]

  return paths
}

const { classify, target } = Astro.params
const decodeTarget = decodeURIComponent(target ?? "")

const posts = await getKoreanPosts()
const weeklies = await getKoreanWeeklies()
const allContent = [...posts, ...weeklies] as (Post | Weekly)[]

const capitalizeFirst = (str: string) => str.charAt(0).toUpperCase() + str.slice(1)

function getContentBySlug(allContent: (Post | Weekly)[], classify: string, target: string) {
  if (!classify || !target) {
    return []
  }

  switch (classify) {
    case "category":
      return allContent
        .filter((item) => "category" in item.data && item.data.category === target)
        .map((item) => ({ ...item, type: item.type }))
    case "tag":
      return [
        ...allContent
          .filter((item) => item.data.tags?.includes(target))
          .map((item) => ({ ...item, type: item.type })),
      ]
    case "year":
      return [
        ...allContent
          .filter(
            (item) =>
              item.data.date && new Date(item.data.date).getFullYear().toString() === target,
          )
          .map((item) => ({ ...item, type: item.type })),
      ]
    default:
      return []
  }
}

const contentWithSlug = getContentBySlug(allContent, classify ?? "", decodeTarget ?? "")
const title = `${capitalizeFirst(decodeTarget ?? "")} - ${capitalizeFirst(classify ?? "")}`
const description = `Archives of ${capitalizeFirst(decodeTarget ?? "")} in ${capitalizeFirst(classify ?? "")}`
const url = buildPageUrl("", `/archives/${classify}/${decodeTarget}`)

// Breadcrumb 항목 생성
const breadcrumbItems = generateArchiveBreadcrumbs({
  pathname: `/archives/${classify}/${target}`,
  origin: Astro.url.origin,
  lang: "ko",
  classify: classify ?? "",
  target: decodeTarget ?? "",
})

const pageSchema = generatePageSchema({
  type: "CollectionPage",
  title,
  description,
  url,
  keywords: `archives, ${classify}, ${decodeTarget}`,
  inLanguage: "ko",
})

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbItems)
const jsonLd = [pageSchema, breadcrumbSchema]
---

<Layout 
  title={title} 
  description={description}
  lang="ko"
  jsonLd={jsonLd}
  type="website"
>
  <div class="min-h-screen px-2 sm:px-4">
    <div class="space-y-2 py-6 md:space-y-1">
      <h1
        class="text-3xl capitalize leading-9 font-extrabold tracking-tight text-gray-900 sm:text-4xl sm:leading-10 md:text-6xl md:leading-14 dark:text-gray-100"
      >
        {decodeTarget}
      </h1>
      <p class="text-lg leading-7 text-gray-500 dark:text-gray-400">
        {description}
      </p>
    </div>
    {contentWithSlug.length === 0 && "No content found."}
    <ul>
      {
        contentWithSlug.map((item) => (
          <li class:list={["flex", "justify-between", "items-center", "py-3"]}>
            <div class="flex items-center space-x-2">
              <a
                href={
                  withTrailingSlash(
                    item.type === "weekly"
                      ? `/weekly/${item.slug}`
                      : `/posts/${item.slug}`,
                  )
                }
                class="text-base sm:text-lg font-medium text-gray-900 hover:text-primary-500 dark:text-gray-100 dark:hover:text-primary-400"
              >
                {item.data.title}
              </a>
              {item.type === "weekly" && (
                <span class="rounded bg-primary-50 px-1.5 py-0.5 text-xs font-medium text-primary-700 dark:bg-primary-950/40 dark:text-primary-300">
                  Weekly
                </span>
              )}
            </div>
            <div class="flex-1 border-b-2 min-w-2.5 border-dotted border-gray-300 mx-2" />
            <span class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 min-w-[90px] text-right">
              {item.data.date
                ? new Date(item.data.date).toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "2-digit",
                  })
                : ""}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
