---
import { ObsidianDownloadCount } from "@/components/features/ObsidianDownloadCount"
import { Popover, PopoverContent, PopoverTrigger } from "@/components/ui/popover"
import Layout from "@/layouts/Layout.astro"
import { type Project, type ProjectSection, projectsData } from "@/utils/projectsData"
import { generatePageSchema } from "@/utils/structuredData"
import pkg from "~/package.json"

const cdnUrl = `${pkg.homepage}/banner/`

function groupBySection(projects: Project[]): ProjectSection {
  return projects.reduce((acc: ProjectSection, cur: Project) => {
    if (cur.section in acc) {
      acc[cur.section]?.push(cur)
    } else {
      acc[cur.section] = [cur]
    }
    return acc
  }, {} as ProjectSection)
}

const projects: ProjectSection = groupBySection(projectsData)

const title = "Projects"
const description = "고진무가 만들고 운영 중인 사이드 프로젝트와 오픈소스 작업을 모았습니다."
const url = `${pkg.homepage}/projects`
const jsonLd = generatePageSchema({
  title,
  description,
  url,
  keywords: "projects, portfolio, collection",
  inLanguage: "ko",
})
---

<Layout wide 
  title={title} 
  description={description} 
  lang="ko"
  jsonLd={jsonLd}
  type="website"
>
  <h1 class="sr-only">{title}</h1>
  {
    Object.entries(projects).map(([section, projects]: [string, Project[]]) => (
      <section class="my-2">
        <h2 class="mb-6 pb-1 text-xl border-b border-gray-200 dark:border-gray-500 lg:text-2xl xl:text-3xl font-semibold capitalize">
          {section}
        </h2>
        <ul class="pl-4 my-4 list-disc">
          {projects.map((project: Project) => (
            <li class="mb-3">
              {project.hasPreview ? (
                <Popover>
                  <PopoverTrigger asChild>
                    <a
                      href={project.href}
                      class="text-blue-600 dark:text-blue-500 font-bold cursor-pointer"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {project.name}
                    </a>
                  </PopoverTrigger>
                  <PopoverContent className="w-64 p-0 shadow-lg">
                    <img
                      src={cdnUrl + project.name + ".jpg"}
                      alt={project.name + " 대표 이미지"}
                      width={256}
                      height={160}
                      class="rounded-md object-cover"
                      loading="lazy"
                    />
                  </PopoverContent>
                </Popover>
              ) : (
                <a
                  href={project.href}
                  class="text-blue-600 dark:text-blue-500 font-bold"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {project.name}
                  {project.person !== undefined && project.person === 1
                    ? ""
                    : project.person !== undefined
                      ? `(${project.person} people)`
                      : ""}
                      {project.section === "obsidian" && project.obsidianPluginId && (
                        <ObsidianDownloadCount client:load pluginId={project.obsidianPluginId} />
                      )}
                    </a>
                  )}
              <span class="text-gray-600 dark:text-gray-400">
                : {project.description}
              </span>
              {project.subProject && (
                <ul class="pl-4 my-4 list-disc">
                  {project.subProject.map((sub: Project) => (
                    <li class="mb-3">
                      <a
                        href={sub.href}
                        class="text-blue-600 dark:text-blue-500 font-bold"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {sub.name}
                      </a>
                      <span class="text-gray-600 dark:text-gray-400">
                        : {sub.description}
                      </span>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Layout>
