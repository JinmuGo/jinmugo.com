---
import Gallery from "@/components/features/Gallery.astro"
import Layout from "@/layouts/Layout.astro"
import { generateBreadcrumbItems } from "@/utils/breadcrumbUtils"
import { generateBreadcrumbSchema, generatePageSchema } from "@/utils/structuredData"
import pkg from "~/package.json"

const title = "Gallery"
const description =
  "고진무가 직접 찍은 사진을 모았습니다. 달리며 지나친 풍경과 여행지에서 남긴 기록입니다."

// Breadcrumb 항목 생성
const breadcrumbItems = generateBreadcrumbItems({
  pathname: "/gallery",
  origin: pkg.homepage,
  title: "Gallery",
})

const pageSchema = generatePageSchema({
  type: "ImageGallery",
  title,
  description,
  url: `${pkg.homepage}/gallery`,
  inLanguage: "ko",
})

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbItems)
const jsonLd = [pageSchema, breadcrumbSchema]
---

<Layout
  title={title} 
  description={description}
  lang="ko"
  jsonLd={jsonLd}
  type="website"
>
  <h1 class="sr-only">{title}</h1>
  <Gallery locale="ko" />
</Layout>
