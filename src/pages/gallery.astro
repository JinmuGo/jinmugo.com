---
import { Image } from "astro:assets"
import type { _Object } from "@aws-sdk/client-s3"
import { HeadObjectCommand, ListObjectsV2Command, S3Client } from "@aws-sdk/client-s3"
import Layout from "@/layouts/Layout.astro"
import { generateBreadcrumbItems } from "@/utils/breadcrumbUtils"
import { generateBreadcrumbSchema, generatePageSchema } from "@/utils/structuredData"
import pkg from "~/package.json"

// S3 클라이언트 생성 (CI/preview에서는 비활성화)
const GALLERY_PREFIX = "jinmu.me/"
const galleryDisableReasons: string[] = []
const isForcedDisabled =
  (import.meta.env.DISABLE_REMOTE_GALLERY ?? process.env.DISABLE_REMOTE_GALLERY) === "true"
if (isForcedDisabled) {
  galleryDisableReasons.push("DISABLE_REMOTE_GALLERY=true")
}
if (!import.meta.env.R2_BUCKET_NAME) {
  galleryDisableReasons.push("missing R2_BUCKET_NAME")
}
if (!import.meta.env.R2_ACCESS_KEY_ID) {
  galleryDisableReasons.push("missing R2_ACCESS_KEY_ID")
}
if (!import.meta.env.R2_SECRET_ACCESS_KEY) {
  galleryDisableReasons.push("missing R2_SECRET_ACCESS_KEY")
}
if (!import.meta.env.R2_ACCOUNT_ID) {
  galleryDisableReasons.push("missing R2_ACCOUNT_ID")
}

const DISABLE_REMOTE_GALLERY =
  isForcedDisabled ||
  !import.meta.env.R2_BUCKET_NAME ||
  !import.meta.env.R2_ACCESS_KEY_ID ||
  !import.meta.env.R2_SECRET_ACCESS_KEY ||
  !import.meta.env.R2_ACCOUNT_ID

const decodeS3Key = (key: string): string => {
  try {
    return decodeURIComponent(key)
  } catch {
    return key
  }
}

const encodeCdnKey = (key: string): string =>
  key
    .split("/")
    .map((part) => encodeURIComponent(part))
    .join("/")

let images: Array<{ key: string; src: string; width: number; height: number }> = []

if (DISABLE_REMOTE_GALLERY) {
  console.warn(`[gallery] remote gallery disabled: ${galleryDisableReasons.join(", ")}`)
}

if (!DISABLE_REMOTE_GALLERY) {
  const bucketName = import.meta.env.R2_BUCKET_NAME
  const accessKeyId = import.meta.env.R2_ACCESS_KEY_ID
  const secretAccessKey = import.meta.env.R2_SECRET_ACCESS_KEY
  const accountId = import.meta.env.R2_ACCOUNT_ID

  if (bucketName && accessKeyId && secretAccessKey && accountId) {
    const s3Client = new S3Client({
      credentials: {
        accessKeyId,
        secretAccessKey,
      },
      endpoint: `https://${accountId}.r2.cloudflarestorage.com`,
      region: "auto",
    })

    try {
      // S3에서 이미지 목록 가져오기 (빌드 타임)
      const { Contents, KeyCount } = await s3Client.send(
        new ListObjectsV2Command({
          Bucket: bucketName,
          Prefix: GALLERY_PREFIX,
          EncodingType: "url",
        }),
      )

      const normalizedContents = ((Contents ?? []) as _Object[]).map((obj) => ({
        ...obj,
        Key: obj.Key ? decodeS3Key(obj.Key) : obj.Key,
      }))

      const filtered = normalizedContents.filter(
        (obj: _Object) =>
          obj.Key &&
          !obj.Key.toLowerCase().endsWith(".heic") &&
          !obj.Key.toLowerCase().endsWith(".mov"),
      )

      console.info(
        `[gallery] fetched ${filtered.length}/${KeyCount ?? 0} objects from prefix "${GALLERY_PREFIX}"`,
      )

      images = await Promise.all(
        filtered.map(async (obj: _Object) => {
          let width = 1200
          let height = 800
          try {
            if (!obj.Key) {
              throw new Error("Key is undefined")
            }
            const head = await s3Client.send(
              new HeadObjectCommand({
                Bucket: bucketName,
                Key: obj.Key,
              }),
            )
            if (head.Metadata?.width && head.Metadata?.height) {
              width = Number(head.Metadata.width)
              height = Number(head.Metadata.height)
            }
          } catch {
            // 무시하고 기본값 사용
          }
          return {
            key: obj.Key ?? "",
            src: obj.Key ? `${pkg.cdnUrl}/${encodeCdnKey(obj.Key)}` : "",
            width,
            height,
          }
        }),
      )
    } catch (error) {
      console.error("[gallery] failed to fetch images from S3:", error)
      images = []
    }
  }
}

const title = "Gallery"
const description = "Jinmu's gallery"

// Breadcrumb 항목 생성
const breadcrumbItems = generateBreadcrumbItems({
  pathname: "/gallery",
  origin: pkg.homepage,
  lang: "ko",
  title: "Gallery",
})

const pageSchema = generatePageSchema({
  type: "ImageGallery",
  title,
  description,
  url: `${pkg.homepage}/gallery`,
  inLanguage: "ko",
})

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbItems)
const jsonLd = [pageSchema, breadcrumbSchema]
---

<Layout 
  title={title} 
  description={description}
  lang="ko"
  jsonLd={jsonLd}
  type="website"
>
  <div class="space-y-2 pt-6 pb-8 md:space-y-5">
    <h1
      class="text-3xl font-extrabold tracking-tight leading-9 text-gray-900 dark:text-gray-100 sm:text-4xl sm:leading-10 md:text-6xl md:leading-14"
    >
      {title}
    </h1>
  </div>
  <div class="columns-1 sm:columns-2 lg:columns-3 gap-4" id="gallery">
    {
      images.length === 0 ? (
        <p class="text-sm text-gray-500 dark:text-gray-400">
          이미지를 불러오지 못했습니다. 잠시 후 다시 시도해주세요.
        </p>
      ) : (
        images.map(
          (img: { key: string; src: string; width: number; height: number }, index: number) => (
            <a
              href={img.src}
              data-pswp-width={img.width}
              data-pswp-height={img.height}
              class="break-inside-avoid mb-4 block cursor-zoom-in"
              target="_blank"
            >
              <Image
                src={img.src}
                alt={img.key}
                width={img.width}
                height={img.height}
                loading={index < 6 ? "eager" : "lazy"}
                decoding="async"
                fetchpriority={index === 0 ? "high" : undefined}
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                class="rounded-lg shadow-md w-full h-auto object-cover"
              />
            </a>
          ),
        )
      )
    }
  </div>
</Layout>

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";

  const lightbox = new PhotoSwipeLightbox({
    gallery: "#gallery",
    children: "a",
    pswpModule: () => import("photoswipe"),
    bgOpacity: 0.85,
    escKey: true,
    pinchToClose: true,
  });

  lightbox.init();
</script>
