---
import { render } from "astro:content"
import PhotoSwipe from "@/components/features/PhotoSwipe.astro"
import { components } from "@/components/mdx/components.astro"
import PostLayout from "@/layouts/PostLayout.astro"
import type { Post } from "@/types/content"
import { getBannerImageBySlug } from "@/utils/banner"
import { getKoreanPosts } from "@/utils/content/posts"

export async function getStaticPaths() {
  const posts = await getKoreanPosts()

  return posts.map((entry: Post) => {
    return {
      params: {
        slug: entry.slug,
      },
      props: { entry, slug: entry.slug, href: entry.href },
    }
  })
}

const { entry, slug, href }: { entry: Post; slug: string; href: string } = Astro.props
const { Content, headings } = await render(entry)
const frontmatterWithSlug = {
  ...entry.data,
  slug,
  href,
}

const bannerImageBySlug = getBannerImageBySlug(slug)
---

<PostLayout frontmatter={frontmatterWithSlug} bannerImage={bannerImageBySlug} headings={headings}>
  <Content components={components} />
</PostLayout>

<PhotoSwipe />
