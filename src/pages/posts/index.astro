---
import Title from "@/components/layout/Title"
import Layout from "@/layouts/Layout.astro"
import ListLayouts from "@/layouts/ListLayouts"
import { getKoreanPosts, sortPostsByDate } from "@/utils/content/posts"
import { buildItemUrl, buildPageUrl, generatePostsPageSchema } from "@/utils/structuredData"

// 모든 한국어 포스트 가져오기
const posts = await getKoreanPosts()
const sortedPosts = sortPostsByDate(posts)

const title = "Posts"
const description = "개발·네트워크·러닝·독서까지, 고진무가 쓴 글 전체 목록입니다."

const jsonLd = generatePostsPageSchema({
  title,
  description,
  url: buildPageUrl("", "/posts"),
  keywords: "posts, articles, collection",
  inLanguage: "ko",
  itemListElements: sortedPosts.map((post, index) => ({
    "@type": "ListItem",
    url: buildItemUrl(`/posts/${post.slug}`),
    position: index + 1,
    item: {
      "@type": "Article",
      name: post.data.title,
      url: buildItemUrl(`/posts/${post.slug}`),
    },
  })),
})
---

<Layout
  title={title}
  description={description}
  lang="ko"
  jsonLd={jsonLd}
  type="website"
>
  <section class="space-y-10 pt-6 pb-12">
    <Title>{title}</Title>
    <ListLayouts
      posts={sortedPosts.map((post) => ({
        ...post.data,
        slug: post.slug,
      }))}
      lang="ko"
    />
  </section>
</Layout>
