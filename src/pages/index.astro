---
import { Image } from "astro:assets"
import PostList from "@/components/content/PostList.astro"
import Layout from "@/layouts/Layout.astro"
import { postToListItem } from "@/utils/content/listItem"
import { getKoreanPosts, sortPostsByDate } from "@/utils/content/posts"
import {
  AUTHOR_URL,
  generatePageSchema,
  generatePersonSchema,
  generateWebsiteSchema,
} from "@/utils/structuredData"
import pkg from "~/package.json"
import Avatar from "~/public/avatar.webp"
import HeroImageSrc from "~/public/sea-boat.webp"

const posts = sortPostsByDate(await getKoreanPosts())
const recentPosts = posts.slice(0, 5)

const title = "Jinmu Go"
const description = "Love Nature. Love Machine."
const url = pkg.homepage

// Website 스키마
const websiteSchema = generateWebsiteSchema({
  name: title,
  url,
  description,
  inLanguage: "ko",
})

const personSchema = generatePersonSchema({
  name: pkg.author,
  url: AUTHOR_URL,
  description,
  image: `${url}/avatar.webp`,
  sameAs: Object.values(pkg.social),
})

// 페이지 스키마
const pageSchema = generatePageSchema({
  title,
  description,
  url,
  keywords: "blog, posts",
  inLanguage: "ko",
  itemListElements: recentPosts.map((post, index) => postToListItem(post, index + 1)),
})

const jsonLd = [websiteSchema, personSchema, pageSchema]
---

<Layout
  title={title}
  description={description}
  image={Avatar}
  lang="ko"
  jsonLd={jsonLd}
  type="website"
>
  <Image
    src={HeroImageSrc}
    alt="hero image"
    width={1440}
    layout="constrained"
    class="mt-2 w-full h-auto rounded-xl object-cover"
    loading="eager"
    fetchpriority="high"
    data-blur-src="sea-boat-blur.webp"
  />
  <h1 class="sr-only">{title}</h1>
  <PostList items={posts} />
</Layout>
