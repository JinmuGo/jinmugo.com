---
import { Image } from "astro:assets"
import Bleed from "@/components/layout/Bleed.astro"
import ContentTimeline from "@/components/Timeline/ContentTimeline.astro"
import Layout from "@/layouts/Layout.astro"
import { getKoreanPosts } from "@/utils/content/posts"
import { mergeTimelineEntries, timelineEntryToListItem } from "@/utils/content/timeline"
import { getKoreanWeeklies } from "@/utils/content/weekly"
import {
  generatePageSchema,
  generatePersonSchema,
  generateWebsiteSchema,
} from "@/utils/structuredData"
import pkg from "~/package.json"
import Avatar from "~/public/avatar.webp"
import HeroImageSrc from "~/public/sea-boat.webp"

const posts = await getKoreanPosts()
const weeklies = await getKoreanWeeklies()
const timelineEntries = mergeTimelineEntries(posts, weeklies)
const recentEntries = timelineEntries.slice(0, 5)

const title = "Jinmu Go"
const description = pkg.description
const url = pkg.homepage

// Website 스키마
const websiteSchema = generateWebsiteSchema({
  name: title,
  url,
  description,
  inLanguage: "ko",
})

const personSchema = generatePersonSchema({
  name: pkg.author,
  url,
  description,
  image: `${url}/avatar.webp`,
  sameAs: Object.values(pkg.social),
})

// 페이지 스키마
const pageSchema = generatePageSchema({
  title,
  description,
  url,
  keywords: "blog, posts, weekly, timeline",
  inLanguage: "ko",
  itemListElements: recentEntries.map((entry, index) => timelineEntryToListItem(entry, index + 1)),
})

const jsonLd = [websiteSchema, personSchema, pageSchema]
---

<Layout
  title={title}
  description={description}
  image={Avatar}
  lang="ko"
  jsonLd={jsonLd}
  type="website"
>
  <Bleed>
    <Image
      src={HeroImageSrc}
      alt="hero image"
      class="object-cover w-full h-full"
      loading="eager"
      fetchpriority="high"
      data-blur-src="sea-boat-blur.webp"
    />
  </Bleed>
  <h1 class="sr-only">{title}</h1>
  <ContentTimeline items={timelineEntries} />
</Layout>
