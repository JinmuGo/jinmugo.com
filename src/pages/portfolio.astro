---
import Layout from "@/layouts/Layout.astro"
import { leadership, profile, projects, proofMetrics, skills } from "@/utils/careerData"
import { buildPageUrl, generatePageSchema } from "@/utils/structuredData"
import pkg from "~/package.json"

const title = "Portfolio"
const description =
  "Go 백엔드, self-hosted 인프라, 개발자 도구를 만드는 고진무의 엔지니어링 포트폴리오"
const url = buildPageUrl(pkg.homepage, "/portfolio")
const jsonLd = generatePageSchema({
  title,
  description,
  url,
  keywords: "portfolio, backend engineer, go, infrastructure, developer tools",
  inLanguage: "ko",
})

const featuredProject = projects[0]
const selectedProjects = projects.slice(1, 4)
const systemsProject = projects[4]
---

<Layout wide
  title={title}
  description={description}
  lang="ko"
  jsonLd={jsonLd}
  type="website"
>
  <section class="pt-10 pb-16 md:pt-16 md:pb-20">
    <p
      class="font-mono text-xs font-semibold uppercase tracking-[0.28em] text-primary-600 dark:text-primary-400"
    >
      {profile.headline}
    </p>
    <div class="mt-5 grid gap-8 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-end">
      <div>
        <h1
          class="max-w-3xl text-4xl font-semibold tracking-tight text-gray-900 dark:text-gray-100 sm:text-5xl md:text-6xl"
        >
          {profile.name}
          <span class="block text-gray-500 dark:text-gray-400">{profile.englishName}</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-gray-700 dark:text-gray-300">
          {profile.summary}
        </p>
      </div>
      <div class="space-y-3 text-sm text-gray-600 dark:text-gray-400">
        <p class="text-base font-medium text-gray-900 dark:text-gray-100">
          {profile.focus}
        </p>
        <div class="flex flex-wrap gap-x-4 gap-y-2">
          <a class="hover:text-primary-600 dark:hover:text-primary-400" href={`mailto:${profile.email}`}>
            Email
          </a>
          <a class="hover:text-primary-600 dark:hover:text-primary-400" href={profile.github}>
            GitHub
          </a>
          <a class="hover:text-primary-600 dark:hover:text-primary-400" href="/resume/">
            Resume
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-gray-200 py-6 dark:border-gray-800">
    <dl class="grid grid-cols-2 gap-6 md:grid-cols-4">
      {proofMetrics.map((metric) => (
        <div>
          <dt class="text-sm text-gray-500 dark:text-gray-400">{metric.label}</dt>
          <dd class="mt-2 text-2xl font-semibold text-gray-900 dark:text-gray-100">
            {metric.value}
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="py-16 md:py-20">
    <div class="grid gap-10 lg:grid-cols-[16rem_minmax(0,1fr)]">
      <div>
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.22em] text-primary-600 dark:text-primary-400">
          Featured Case
        </p>
        <h2 class="mt-3 text-2xl font-semibold text-gray-900 dark:text-gray-100">
          {featuredProject.name}
        </h2>
        <p class="mt-3 text-gray-600 dark:text-gray-400">
          {featuredProject.meta}
        </p>
      </div>
      <div>
        <p class="text-xl leading-8 text-gray-800 dark:text-gray-200">
          {featuredProject.problem}
        </p>
        <ul class="mt-8 space-y-4">
          {featuredProject.bullets.map((item) => (
            <li class="grid gap-3 sm:grid-cols-[8rem_minmax(0,1fr)]">
              <span class="font-mono text-xs uppercase tracking-[0.18em] text-gray-400">
                Build
              </span>
              <span class="text-gray-700 dark:text-gray-300">{item}</span>
            </li>
          ))}
        </ul>
        <div class="mt-8 flex flex-wrap gap-2">
          {featuredProject.metrics.map((metric) => (
            <span class="rounded-md bg-gray-100 px-3 py-1 text-sm text-gray-700 dark:bg-gray-900 dark:text-gray-300">
              {metric}
            </span>
          ))}
        </div>
        <div class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm">
          {featuredProject.links.map((link) => (
            <a
              href={link.href}
              class="font-medium text-primary-700 hover:text-primary-800 dark:text-primary-400 dark:hover:text-primary-300"
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-gray-200 py-16 dark:border-gray-800 md:py-20">
    <div class="mb-10 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.22em] text-primary-600 dark:text-primary-400">
          Selected Work
        </p>
        <h2 class="mt-3 text-2xl font-semibold text-gray-900 dark:text-gray-100">
          운영까지 가져간 프로젝트
        </h2>
      </div>
      <a
        href="/projects/"
        class="text-sm font-medium text-gray-600 hover:text-primary-700 dark:text-gray-400 dark:hover:text-primary-400"
      >
        전체 프로젝트 보기
      </a>
    </div>

    <div class="divide-y divide-gray-200 dark:divide-gray-800">
      {selectedProjects.map((project) => (
        <article class="grid gap-5 py-8 md:grid-cols-[12rem_minmax(0,1fr)]">
          <div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100">
              {project.name}
            </h3>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
              {project.role} · {project.period}
            </p>
          </div>
          <div>
            <p class="text-gray-700 dark:text-gray-300">{project.problem}</p>
            <ul class="mt-4 space-y-2 text-sm text-gray-600 dark:text-gray-400">
              {project.bullets.map((item) => <li>· {item}</li>)}
            </ul>
            <div class="mt-5 flex flex-wrap gap-2">
              {project.metrics.map((metric) => (
                <span class="text-sm text-gray-500 dark:text-gray-400">{metric}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="border-t border-gray-200 py-16 dark:border-gray-800 md:py-20">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <div>
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.22em] text-primary-600 dark:text-primary-400">
          Systems Background
        </p>
        <h2 class="mt-3 text-2xl font-semibold text-gray-900 dark:text-gray-100">
          {systemsProject.name}
        </h2>
        <p class="mt-4 text-gray-700 dark:text-gray-300">
          {systemsProject.problem}
        </p>
        <ul class="mt-5 space-y-2 text-gray-600 dark:text-gray-400">
          {systemsProject.bullets.map((item) => <li>· {item}</li>)}
        </ul>
      </div>
      <div>
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.22em] text-primary-600 dark:text-primary-400">
          Engineering Focus
        </p>
        <div class="mt-5 grid gap-5 sm:grid-cols-2">
          {skills.slice(1).map((skill) => (
            <div class="border-t border-gray-200 pt-4 dark:border-gray-800">
              <h3 class="font-semibold text-gray-900 dark:text-gray-100">{skill.category}</h3>
              <p class="mt-2 text-sm leading-6 text-gray-600 dark:text-gray-400">
                {skill.items.join(" · ")}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-gray-200 py-16 dark:border-gray-800 md:py-20">
    <div class="grid gap-10 md:grid-cols-[16rem_minmax(0,1fr)]">
      <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">
        Leadership & Awards
      </h2>
      <div class="space-y-8">
        {leadership.map((item) => (
          <article>
            <h3 class="font-semibold text-gray-900 dark:text-gray-100">{item.name}</h3>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{item.meta}</p>
            <ul class="mt-3 space-y-2 text-gray-700 dark:text-gray-300">
              {item.bullets.map((bullet) => <li>· {bullet}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-gray-200 py-16 dark:border-gray-800">
    <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">
      Go 백엔드와 인프라 자동화가 필요한 팀에 맞습니다.
    </h2>
    <div class="mt-6 flex flex-wrap gap-4 text-sm font-medium">
      <a
        href="/resume/"
        class="rounded-md bg-gray-900 px-4 py-2 text-gray-50 hover:bg-gray-700 dark:bg-gray-100 dark:text-gray-950 dark:hover:bg-gray-300"
      >
        이력서 보기
      </a>
      <a
        href={`mailto:${profile.email}`}
        class="rounded-md border border-gray-300 px-4 py-2 text-gray-800 hover:border-gray-900 dark:border-gray-700 dark:text-gray-200 dark:hover:border-gray-400"
      >
        연락하기
      </a>
    </div>
  </section>
</Layout>
