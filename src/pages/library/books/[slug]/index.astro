---
import { render } from "astro:content"
import { components } from "@/components/mdx/components.astro"
import MediaDetail from "@/layouts/library/MediaDetail.astro"
import type { BookMedia } from "@/types/library"
import { getBookMedia, getBooks, sortMediaByDate } from "@/utils/library/books"

export async function getStaticPaths() {
  const items = sortMediaByDate(await getBookMedia()).filter((b) => b.cover)
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }))
}

const { item } = Astro.props as { item: BookMedia }
const entries = await getBooks()
const entry = entries.find((e) => e.slug === item.slug)
if (!entry) {
  throw new Error(`Book entry not found for slug: ${item.slug}`)
}
const { Content } = await render(entry)
---

<MediaDetail item={item}>
  <Content components={components} />
</MediaDetail>
