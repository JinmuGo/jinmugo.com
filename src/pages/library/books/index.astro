---
import Title from "@/components/layout/Title"
import MediaList from "@/components/library/MediaList.astro"
import Layout from "@/layouts/Layout.astro"
import { getBookMedia } from "@/utils/library/books"
import { sortMediaByDate } from "@/utils/library/common"

const items = sortMediaByDate(await getBookMedia("ko")).filter((b) => b.cover)
---

<Layout wide
	title="Books · Library"
	description="읽은 책의 기록입니다. 한 줄 감상과 별점, 인상 깊었던 문장을 함께 남깁니다."
	lang="ko"
>
  <div class="px-2 sm:px-4">
    <div class="space-y-2 pt-6 pb-8 md:space-y-5">
      <Title>Books</Title>
    </div>
    <MediaList items={items} />
  </div>
</Layout>
