---
import Title from "@/components/layout/Title"
import MediaList from "@/components/library/MediaList.astro"
import Layout from "@/layouts/Layout.astro"
import { getMovieMedia, sortMediaByDate } from "@/utils/library/movies"

const items = sortMediaByDate(await getMovieMedia()).filter((m) => m.cover)
---

<Layout title="Movies · Library" description="본 영화들" lang="ko">
  <div class="px-2 sm:px-4">
    <div class="space-y-2 pt-6 pb-8 md:space-y-5">
      <Title>Movies</Title>
    </div>
    <MediaList items={items} />
  </div>
</Layout>
