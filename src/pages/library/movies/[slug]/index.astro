---
import { render } from "astro:content"
import PhotoSwipe from "@/components/features/PhotoSwipe.astro"
import { components } from "@/components/mdx/components.astro"
import PostLayout from "@/layouts/PostLayout.astro"
import type { MovieMedia } from "@/types/library"
import { sortMediaByDate } from "@/utils/library/common"
import { getCover } from "@/utils/library/cover"
import { getMovieMedia, getMovies } from "@/utils/library/movies"

export async function getStaticPaths() {
  const items = sortMediaByDate(await getMovieMedia("ko")).filter((m) => m.cover)
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }))
}

const { item } = Astro.props as { item: MovieMedia }
const entries = await getMovies("ko")
const entry = entries.find((e) => e.slug === item.slug)
if (!entry) {
  throw new Error(`Movie entry not found for slug: ${item.slug}`)
}
const { Content, headings } = await render(entry)

const frontmatterWithSlug = {
  title: item.title,
  date: item.dateConsumed ?? new Date(item.year, 0, 1),
  draft: false,
  tags: item.tags,
  summary: item.oneLiner,
  slug: item.slug,
  href: item.href,
}

const coverImage = getCover("movie", item.slug)
---

<PostLayout frontmatter={frontmatterWithSlug} bannerImage={coverImage} headings={headings} contentType="movie">
  <Content components={components} />
</PostLayout>

<PhotoSwipe />
