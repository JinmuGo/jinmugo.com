---
import Title from "@/components/layout/Title"
import Layout from "@/layouts/Layout.astro"
import { getBookMedia } from "@/utils/library/books"
import { getMovieMedia } from "@/utils/library/movies"
import { buildPageUrl, generatePageSchema } from "@/utils/structuredData"

interface Section {
  num: string
  title: string
  href: string | null
  /** Short line under title (e.g. book count aligned with MediaList visibility) */
  meta?: string
}

const [bookCount, movieCount] = await Promise.all([
  getBookMedia().then((items) => items.filter((b) => b.cover).length),
  getMovieMedia().then((items) => items.filter((m) => m.cover).length),
])

const sections: Section[] = [
  {
    num: "001",
    title: "Books",
    href: "/library/books/",
    meta: `${bookCount} books`,
  },
  {
    num: "002",
    title: "Movies",
    href: "/library/movies/",
    meta: `${movieCount} films`,
  },
  {
    num: "003",
    title: "Music",
    href: null,
  },
]

const title = "Library"
const description = "읽고 본 것들의 색인 — 책, 영화, 음악."
const jsonLd = generatePageSchema({
  type: "CollectionPage",
  title,
  description,
  url: buildPageUrl("", "/library"),
  keywords: "library, books, movies, music",
  inLanguage: "ko",
})
---

<Layout title={title} description={description} lang="ko" jsonLd={jsonLd} type="website">
  <div class="px-2 sm:px-4">
    <div class="space-y-2 pt-6 pb-8 md:space-y-5">
      <Title>Library</Title>
    </div>

    <ul
      class="border-t border-b border-stone-200 dark:border-stone-800 divide-y divide-stone-200 dark:divide-stone-800"
    >
        {sections.map((s) =>
          s.href ? (
            <li>
              <a
                href={s.href}
                class="flex items-start gap-6 py-8 px-1 transition-colors hover:bg-stone-50 dark:hover:bg-stone-900/40"
              >
                <div class="font-mono tabular-nums text-[11px] text-stone-400 dark:text-stone-500 pt-2 w-8 shrink-0">
                  {s.num}
                </div>
                <div class="flex-1 min-w-0">
                  <h2 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight text-stone-900 dark:text-stone-50">
                    {s.title}
                  </h2>
                  {
                    s.meta ? (
                      <p class="mt-1 font-mono tabular-nums text-[11px] tracking-wide text-stone-500 dark:text-stone-400">
                        {s.meta}
                      </p>
                    ) : null
                  }
                </div>
                <div class="text-right pt-2 shrink-0 flex flex-col items-end gap-2">
                  <span
                    aria-hidden="true"
                    class="font-mono text-stone-400 dark:text-stone-500 text-base"
                  >
                    →
                  </span>
                </div>
              </a>
            </li>
          ) : null
        )}
    </ul>
  </div>
</Layout>
