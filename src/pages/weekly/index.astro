---
import Title from "@/components/layout/Title"
import Layout from "@/layouts/Layout.astro"
import ListLayouts from "@/layouts/ListLayouts"
import { getKoreanWeeklies, sortWeekliesByDate } from "@/utils/content/weekly"
import { buildItemUrl, buildPageUrl, generatePostsPageSchema } from "@/utils/structuredData"

const weeklies = sortWeekliesByDate(await getKoreanWeeklies())

const title = "Weekly"
const description = "한 주 동안 읽고 보고 만든 것들을 정리한 주간 기록입니다."

const jsonLd = generatePostsPageSchema({
  title,
  description,
  url: buildPageUrl("", "/weekly"),
  keywords: "weekly, newsletter, journal, curation",
  inLanguage: "ko",
  itemListElements: weeklies.map((weekly, index) => ({
    "@type": "ListItem",
    url: buildItemUrl(`/weekly/${weekly.slug}`),
    position: index + 1,
    item: {
      "@type": "Article",
      name: weekly.data.title,
      url: buildItemUrl(`/weekly/${weekly.slug}`),
    },
  })),
})
---

<Layout title={title} description={description} lang="ko" jsonLd={jsonLd} type="website">
  <section class="space-y-10 pt-6 pb-12">
    <Title>Weekly</Title>
    <div class="space-y-4">
      <ListLayouts
        posts={weeklies.map((weekly) => ({
          ...weekly.data,
          slug: weekly.slug,
        }))}
        postType="weekly"
        lang="ko"
      />
    </div>
  </section>
</Layout>
