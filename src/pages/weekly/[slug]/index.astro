---
import { render } from "astro:content"
import PhotoSwipe from "@/components/features/PhotoSwipe.astro"
import { components } from "@/components/mdx/components.astro"
import WeeklyDefault from "@/layouts/WeeklyDefault.astro"
import type { Weekly } from "@/types/content"
import { getKoreanWeeklies } from "@/utils/content/weekly"
import { getWeeklyCoverImage } from "@/utils/weeklyCover"

export async function getStaticPaths() {
  const weeklies = await getKoreanWeeklies()

  return weeklies.map((entry: Weekly) => ({
    params: {
      slug: entry.slug,
    },
    props: { entry, slug: entry.slug, href: entry.href },
  }))
}

const { entry, slug, href }: { entry: Weekly; slug: string; href: string } = Astro.props
const { Content, headings } = await render(entry)
const frontmatterWithSlug = {
  ...entry.data,
  slug,
  href,
}
const coverImage = getWeeklyCoverImage(entry)
---

<WeeklyDefault frontmatter={frontmatterWithSlug} coverImage={coverImage} headings={headings}>
  <Content components={components} />
</WeeklyDefault>

<PhotoSwipe />
