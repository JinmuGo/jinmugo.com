---
import { Image } from "astro:assets"
import { render } from "astro:content"
import Breadcrumb from "@/components/seo/Breadcrumb.astro"
import Layout from "@/layouts/Layout.astro"
import { generateBreadcrumbItems } from "@/utils/breadcrumbUtils"
import { getEnglishApp } from "@/utils/content/apps"
import {
  AUTHOR_URL,
  buildPageUrl,
  generateBreadcrumbSchema,
  generatePageSchema,
  generatePersonSchema,
} from "@/utils/structuredData"
import pkg from "~/package.json"
import Avatar from "~/public/avatar.webp"

// Breadcrumb 항목 생성
const breadcrumbItems = generateBreadcrumbItems({
  pathname: "/en/about",
  origin: pkg.homepage,
  lang: "en",
  title: "About",
})

const pageSchema = generatePageSchema({
  type: "ProfilePage",
  title: "About",
  description: "About Jinmu",
  url: buildPageUrl(pkg.homepage, "/en/about"),
  keywords: "about, author, profile",
  inLanguage: "en",
})

const personSchema = generatePersonSchema({
  name: pkg.author,
  url: AUTHOR_URL,
  description: pkg.description,
  image: new URL("/avatar.webp", pkg.homepage).href,
  sameAs: Object.values(pkg.social),
})
const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbItems)
const jsonLd = [pageSchema, personSchema, breadcrumbSchema]

const app = await getEnglishApp()
const fallback = {
  name: pkg.author,
  bio: pkg.description,
}
const hasContent = app.length > 0
const { name, bio } = hasContent ? app[0].data : fallback
const Content = hasContent ? (await render(app[0])).Content : undefined
const title = "About"
const description = "About Jinmu"
---

<Layout
  title={title}
  description={description}
  image={Avatar}
  lang="en"
  jsonLd={jsonLd}
  type="website"
>
  <Breadcrumb items={breadcrumbItems} />
  <div class="relative w-full mx-auto aspect-square sm:aspect-[16/9]">
    <Image
      src={Avatar}
      alt={name}
      widths={[640, 960, 1200]}
      sizes="(max-width: 1024px) 100vw, 1024px"
      class="h-full w-full object-cover"
      loading="eager"
    />
    <div class="absolute bottom-6 left-6 text-white drop-shadow-lg">
      <h1
        class="text-3xl leading-9 font-semibold tracking-tight text-gray-50 sm:text-4xl sm:leading-10 md:text-6xl md:leading-14 dark:text-gray-200"
      >
        {name}
      </h1>
      <h2
        class="text-sm sm:text-lg leading-8 font-medium text-gray-100 dark:text-gray-300"
      >
        {bio}
      </h2>
    </div>
  </div>
  {
    Content && (
      <div class="prose dark:prose-invert max-w-none pt-8 pb-8 xl:col-span-2">
        <Content />
      </div>
    )
  }

</Layout>
