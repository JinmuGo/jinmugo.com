---
import { Image } from "astro:assets"
import FormattedDate from "@/components/content/FormattedDate.astro"
import Title from "@/components/layout/Title"
import Layout from "@/layouts/Layout.astro"
import ListLayouts from "@/layouts/ListLayouts"
import { formatWeeklyLabel, getEnglishWeeklies, sortWeekliesByDate } from "@/utils/content/weekly"
import { buildItemUrl, buildPageUrl, generatePostsPageSchema } from "@/utils/structuredData"
import { getWeeklyCoverImage } from "@/utils/weeklyCover"

const weeklies = sortWeekliesByDate(await getEnglishWeeklies())
const latestWeekly = weeklies[0]

const title = "Weekly"
const description =
  "Jinmu Weekly - a personal weekly journal of what I saw, made, read, and thought about."

const jsonLd = generatePostsPageSchema({
  title,
  description,
  url: buildPageUrl("/en", "/weekly"),
  keywords: "weekly, newsletter, journal, curation",
  inLanguage: "en",
  itemListElements: weeklies.map((weekly, index) => ({
    "@type": "ListItem",
    url: buildItemUrl(`/en/weekly/${weekly.slug}`),
    position: index + 1,
    item: {
      "@type": "Article",
      name: weekly.data.title,
      url: buildItemUrl(`/en/weekly/${weekly.slug}`),
    },
  })),
})
---

<Layout title={title} description={description} lang="en" jsonLd={jsonLd} type="website">
  <section class="space-y-10 pt-6 pb-12">
    <div class="max-w-3xl space-y-4">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary-600 dark:text-primary-400">
        Jinmu Weekly
      </p>
      <Title>Weekly</Title>
      <p class="text-lg leading-8 text-gray-600 dark:text-gray-300">
        A weekly note that starts from one scene and collects what I saw, made, read, and thought about.
      </p>
    </div>

    {
      latestWeekly && (
        <a
          href={latestWeekly.href}
          class="group grid overflow-hidden rounded-xl border border-gray-200 bg-white transition-colors hover:border-primary-200 dark:border-gray-800 dark:bg-gray-900 dark:hover:border-primary-800 md:grid-cols-[1.1fr_0.9fr]"
        >
          <div class="space-y-4 p-6 md:p-8">
            <div class="flex items-center gap-3 text-sm text-gray-500 dark:text-gray-400">
              <span class="rounded-full bg-primary-50 px-3 py-1 font-semibold text-primary-700 dark:bg-primary-950/40 dark:text-primary-300">
                Latest {formatWeeklyLabel(latestWeekly)}
              </span>
              <FormattedDate date={latestWeekly.data.date} />
            </div>
            <div class="space-y-3">
              <h2 class="text-2xl font-semibold tracking-tight text-gray-900 group-hover:text-primary-600 dark:text-gray-50 dark:group-hover:text-primary-400 md:text-3xl">
                {latestWeekly.data.title}
              </h2>
              <p class="text-base leading-7 text-gray-600 dark:text-gray-300">
                {latestWeekly.data.summary}
              </p>
            </div>
          </div>
          {
            getWeeklyCoverImage(latestWeekly) ? (
              <Image
                src={getWeeklyCoverImage(latestWeekly)!}
                alt={latestWeekly.data.coverAlt ?? latestWeekly.data.title}
                width={900}
                class="h-full min-h-64 w-full object-cover"
                sizes="(max-width: 768px) 100vw, 420px"
              />
            ) : (
              <div class="min-h-64 bg-gray-100 dark:bg-gray-800" aria-hidden="true" />
            )
          }
        </a>
      )
    }

    <div class="space-y-4">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100">All Issues</h2>
      <ListLayouts
        posts={weeklies.map((weekly) => ({
          ...weekly.data,
          slug: weekly.slug,
        }))}
        postType="weekly"
        lang="en"
      />
    </div>
  </section>
</Layout>
