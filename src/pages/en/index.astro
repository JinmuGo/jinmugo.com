---
import { Image } from "astro:assets"
import Bleed from "@/components/layout/Bleed.astro"
import PostTimeline from "@/components/Timeline/PostTimeline.astro"
import Layout from "@/layouts/Layout.astro"
import { getEnglishPosts, sortPostsByDate } from "@/utils/content/posts"
import { generatePageSchema } from "@/utils/structuredData"
import pkg from "~/package.json"
import HeroImageSrc from "~/public/sea-boat.webp"

const posts = await getEnglishPosts()
const sortedPosts = sortPostsByDate(posts)

const title = "Jinmu Go"
const description = pkg.description
const url = `${pkg.homepage}/en`
const jsonLd = generatePageSchema({
  title,
  description,
  url,
  keywords: "blog, posts, timeline",
  inLanguage: "en",
})
---

<Layout 
  title={title} 
  description={description}
  image={HeroImageSrc}
  lang="en"
  jsonLd={jsonLd}
  type="website"
>
  <Bleed>
    <Image
      src={HeroImageSrc}
      alt="boat"
      class="object-cover w-full h-full"
      loading="eager"
      fetchpriority="high"
      data-blur-src="sea-boat-blur.webp"
    />
  </Bleed>
  <PostTimeline posts={sortedPosts} />
</Layout>
