---
import { Image } from "astro:assets"
import PostList from "@/components/content/PostList.astro"
import Layout from "@/layouts/Layout.astro"
import { postToListItem } from "@/utils/content/listItem"
import { getEnglishPosts, sortPostsByDate } from "@/utils/content/posts"
import { generatePageSchema } from "@/utils/structuredData"
import pkg from "~/package.json"
import HeroImageSrc from "~/public/sea-boat.webp"

const posts = sortPostsByDate(await getEnglishPosts())
const recentPosts = posts.slice(0, 5)

const title = "Jinmu Go"
const description = pkg.description
const url = `${pkg.homepage}/en`
const jsonLd = generatePageSchema({
  title,
  description,
  url,
  keywords: "blog, posts",
  inLanguage: "en",
  itemListElements: recentPosts.map((post, index) => postToListItem(post, index + 1)),
})
---

<Layout 
  title={title} 
  description={description}
  image={HeroImageSrc}
  lang="en"
  jsonLd={jsonLd}
  type="website"
>
  <Image
    src={HeroImageSrc}
    alt="boat"
    width={1440}
    layout="constrained"
    class="mt-2 w-full h-auto rounded-xl object-cover"
    loading="eager"
    fetchpriority="high"
    data-blur-src="sea-boat-blur.webp"
  />
  <PostList items={posts} />
</Layout>
