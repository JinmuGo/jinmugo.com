---
import Title from "@/components/layout/Title"
import Layout from "@/layouts/Layout.astro"
import { getBooks } from "@/utils/library/books"
import { getMovies } from "@/utils/library/movies"
import { buildPageUrl, generatePageSchema } from "@/utils/structuredData"

const [books, movies] = await Promise.all([getBooks("en"), getMovies("en")])

interface Section {
  num: string
  title: string
  description: string
  href: string | null
  meta: string
  status: "live" | "soon"
}

const sections: Section[] = [
  {
    num: "001",
    title: "Books",
    description: "Books I've read — one-liners, notes, and longer essays.",
    href: "/en/library/books/",
    meta: `${books.length} volumes`,
    status: "live",
  },
  {
    num: "002",
    title: "Movies",
    description: "Films I've watched. Ratings, impressions, occasional thoughts.",
    href: "/en/library/movies/",
    meta: `${movies.length} films`,
    status: "live",
  },
  {
    num: "003",
    title: "Music",
    description: "Records I've listened to. Tracks, moods, and seasons.",
    href: null,
    meta: "Soon",
    status: "soon",
  },
]

const title = "Library"
const description = "An index of what I've read and seen — books, films, music."
const jsonLd = generatePageSchema({
  type: "CollectionPage",
  title,
  description,
  url: buildPageUrl("/en", "/library"),
  keywords: "library, books, movies, music",
  inLanguage: "en",
})
---

<Layout wide title={title} description={description} lang="en" jsonLd={jsonLd} type="website">
  <div class="px-2 sm:px-4">
    <div class="space-y-2 pt-6 pb-8 md:space-y-5">
      <Title>Library</Title>
    </div>

    <ul
      class="border-t border-b border-stone-200 dark:border-stone-800 divide-y divide-stone-200 dark:divide-stone-800"
    >
      {
        sections.map((s) =>
          s.status === "live" && s.href ? (
            <li>
              <a
                href={s.href}
                class="flex items-start gap-6 py-8 px-1 transition-colors hover:bg-stone-50 dark:hover:bg-stone-900/40"
              >
                <div class="font-mono tabular-nums text-[11px] text-stone-400 dark:text-stone-500 pt-2 w-8 shrink-0">
                  {s.num}
                </div>
                <div class="flex-1 min-w-0">
                  <h2 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight text-stone-900 dark:text-stone-50">
                    {s.title}
                  </h2>
                  <p class="text-[14px] text-stone-600 dark:text-stone-300 mt-2 leading-relaxed max-w-[56ch]">
                    {s.description}
                  </p>
                </div>
                <div class="text-right pt-2 shrink-0 flex flex-col items-end gap-2">
                  <span class="font-mono text-[11px] tabular-nums uppercase tracking-[0.08em] text-stone-500 dark:text-stone-400">
                    {s.meta}
                  </span>
                  <span
                    aria-hidden="true"
                    class="font-mono text-stone-400 dark:text-stone-500 text-base"
                  >
                    →
                  </span>
                </div>
              </a>
            </li>
          ) : (
            <li>
              <div
                class="flex items-start gap-6 py-8 px-1 opacity-55"
                aria-disabled="true"
              >
                <div class="font-mono tabular-nums text-[11px] text-stone-400 dark:text-stone-500 pt-2 w-8 shrink-0">
                  {s.num}
                </div>
                <div class="flex-1 min-w-0">
                  <h2 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight text-stone-900 dark:text-stone-50">
                    {s.title}
                  </h2>
                  <p class="text-[14px] text-stone-600 dark:text-stone-300 mt-2 leading-relaxed max-w-[56ch]">
                    {s.description}
                  </p>
                </div>
                <div class="text-right pt-2 shrink-0">
                  <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-stone-500 dark:text-stone-400">
                    {s.meta}
                  </span>
                </div>
              </div>
            </li>
          ),
        )
      }
    </ul>
  </div>
</Layout>
