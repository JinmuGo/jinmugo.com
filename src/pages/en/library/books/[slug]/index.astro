---
import { render } from "astro:content"
import PhotoSwipe from "@/components/features/PhotoSwipe.astro"
import { components } from "@/components/mdx/components.astro"
import PostBannerX from "@/layouts/PostBannerX.astro"
import PostBannerY from "@/layouts/PostBannerY.astro"
import PostDefault from "@/layouts/PostDefault.astro"
import type { BookMedia } from "@/types/library"
import { selectPostLayout } from "@/utils/layoutSelector"
import { getBookMedia, getBooks } from "@/utils/library/books"
import { sortMediaByDate } from "@/utils/library/common"
import { getCover } from "@/utils/library/cover"

export async function getStaticPaths() {
  const items = sortMediaByDate(await getBookMedia("en")).filter((b) => b.cover)
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }))
}

const { item } = Astro.props as { item: BookMedia }
const entries = await getBooks("en")
const entry = entries.find((e) => e.slug === item.slug)
if (!entry) {
  throw new Error(`Book entry not found for slug: ${item.slug}`)
}
const { Content } = await render(entry)

const frontmatterWithSlug = {
  title: item.title,
  date: item.dateConsumed ?? new Date(item.year, 0, 1),
  draft: false,
  tags: item.tags,
  summary: item.oneLiner,
  slug: item.slug,
  href: item.href,
}

const coverImage = getCover("book", item.slug)
const { layout, bannerImage } = selectPostLayout(coverImage)
---

{
  layout === "PostDefault" ? (
    <PostDefault frontmatter={frontmatterWithSlug} contentType="book">
      <Content components={components} />
    </PostDefault>
  ) : layout === "PostBannerX" ? (
    <PostBannerX frontmatter={frontmatterWithSlug} bannerImage={bannerImage!} contentType="book">
      <Content components={components} />
    </PostBannerX>
  ) : (
    <PostBannerY frontmatter={frontmatterWithSlug} bannerImage={bannerImage!} contentType="book">
      <Content components={components} />
    </PostBannerY>
  )
}

<PhotoSwipe />
