---
import Title from "@/components/layout/Title"
import MediaList from "@/components/library/MediaList.astro"
import Layout from "@/layouts/Layout.astro"
import { sortMediaByDate } from "@/utils/library/common"
import { getMovieMedia } from "@/utils/library/movies"

const items = sortMediaByDate(await getMovieMedia("en")).filter((m) => m.cover)
---

<Layout wide title="Movies · Library" description="Films I've watched" lang="en">
  <div class="px-2 sm:px-4">
    <div class="space-y-2 pt-6 pb-8 md:space-y-5">
      <Title>Movies</Title>
    </div>
    <MediaList items={items} />
  </div>
</Layout>
