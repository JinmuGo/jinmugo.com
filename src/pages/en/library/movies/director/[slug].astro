---
import { render } from "astro:content"
import { components } from "@/components/mdx/components.astro"
import DirectorDetail from "@/layouts/library/DirectorDetail.astro"
import type { DirectorWithSlug } from "@/types/library"
import { getDirectors, moviesByDirector } from "@/utils/library/directors"
import { hasEssay } from "@/utils/library/hasEssay"
import { getMovies, sortMoviesByDateWatched } from "@/utils/library/movies"

export async function getStaticPaths() {
  const directors = await getDirectors()
  const movies = sortMoviesByDateWatched(await getMovies())
  return directors.map((director) => ({
    params: { slug: director.slug },
    props: {
      director,
      works: moviesByDirector(movies, director.slug),
    },
  }))
}

const { director, works } = Astro.props as {
  director: DirectorWithSlug
  works: Awaited<ReturnType<typeof getMovies>>
}

const { Content } = await render(director)
const directorHasEssay = hasEssay(director.body ?? "")
---

<DirectorDetail director={director} works={works} hasEssay={directorHasEssay} lang="en">
  <Content components={components} />
</DirectorDetail>
