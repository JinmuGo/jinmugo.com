---
import { Image } from "astro:assets"
import Breadcrumb from "@/components/seo/Breadcrumb.astro"
import Layout from "@/layouts/Layout.astro"
import { buildGalleryCaption, type GalleryImage, getGalleryImagesFromR2 } from "@/lib/gallery"
import { generateBreadcrumbItems } from "@/utils/breadcrumbUtils"
import { generateBreadcrumbSchema, generatePageSchema } from "@/utils/structuredData"
import pkg from "~/package.json"

const GALLERY_PREFIX = "jinmu.me/"
const bucketName = import.meta.env.R2_BUCKET_NAME
const accessKeyId = import.meta.env.R2_ACCESS_KEY_ID
const secretAccessKey = import.meta.env.R2_SECRET_ACCESS_KEY
const accountId = import.meta.env.R2_ACCOUNT_ID
const galleryDisableReasons: string[] = []
const isForcedDisabled =
  (import.meta.env.DISABLE_REMOTE_GALLERY ?? process.env.DISABLE_REMOTE_GALLERY) === "true"
if (isForcedDisabled) {
  galleryDisableReasons.push("DISABLE_REMOTE_GALLERY=true")
}
if (!bucketName) {
  galleryDisableReasons.push("missing R2_BUCKET_NAME")
}
if (!accessKeyId) {
  galleryDisableReasons.push("missing R2_ACCESS_KEY_ID")
}
if (!secretAccessKey) {
  galleryDisableReasons.push("missing R2_SECRET_ACCESS_KEY")
}
if (!accountId) {
  galleryDisableReasons.push("missing R2_ACCOUNT_ID")
}

const DISABLE_REMOTE_GALLERY =
  isForcedDisabled || !bucketName || !accessKeyId || !secretAccessKey || !accountId

let images: GalleryImage[] = []

if (DISABLE_REMOTE_GALLERY) {
  console.warn(`[gallery/en] remote gallery disabled: ${galleryDisableReasons.join(", ")}`)
}

if (!DISABLE_REMOTE_GALLERY && bucketName && accessKeyId && secretAccessKey && accountId) {
  try {
    images = await getGalleryImagesFromR2({
      bucketName,
      accessKeyId,
      secretAccessKey,
      accountId,
      cdnUrl: pkg.cdnUrl,
      prefix: GALLERY_PREFIX,
      logPrefix: "[gallery/en]",
    })
  } catch (error) {
    console.error("[gallery/en] failed to fetch images from R2:", error)
    images = []
  }
}

const title = "Gallery"
const description = "Jinmu's gallery"

// Breadcrumb 항목 생성
const breadcrumbItems = generateBreadcrumbItems({
  pathname: "/en/gallery",
  origin: pkg.homepage,
  lang: "en",
  title: "Gallery",
})

const pageSchema = generatePageSchema({
  type: "ImageGallery",
  title,
  description,
  url: `${pkg.homepage}/en/gallery`,
  inLanguage: "en",
})

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbItems)
const jsonLd = [pageSchema, breadcrumbSchema]
---

<Layout wide 
  title={title} 
  description={description}
  lang="en"
  jsonLd={jsonLd}
  type="website"
>
  <Breadcrumb items={breadcrumbItems} />
  <div class="space-y-2 pt-6 pb-8 md:space-y-5">
    <h1
      class="text-3xl font-semibold tracking-tight leading-9 text-gray-900 dark:text-gray-100 sm:text-4xl sm:leading-10 md:text-6xl md:leading-14"
    >
      {title}
    </h1>
    <p class="text-lg text-gray-600 dark:text-gray-300">{description}</p>
  </div>
  <div class="columns-1 sm:columns-2 lg:columns-3 gap-4" id="gallery">
    {
      images.length === 0 ? (
        <p class="text-sm text-gray-500 dark:text-gray-400">
          Images could not be loaded right now. Please try again later.
        </p>
      ) : (
        images.map(
          (img: GalleryImage, index: number) => (
            <a
              href={img.src}
              data-pswp-width={img.width}
              data-pswp-height={img.height}
              data-taken-at={img.takenAt}
              data-location-label={img.locationLabel}
              data-gallery-caption={buildGalleryCaption({
                takenAt: img.takenAt,
                locationLabel: img.locationLabel,
                locale: "en",
              })}
              class="break-inside-avoid mb-4 block cursor-zoom-in"
              target="_blank"
            >
              <Image
                src={img.src}
                alt={img.key}
                width={img.width}
                height={img.height}
                loading={index < 6 ? "eager" : "lazy"}
                decoding="async"
                fetchpriority={index === 0 ? "high" : undefined}
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                class="rounded-lg shadow-md w-full h-auto object-cover"
              />
            </a>
          ),
        )
      )
    }
  </div>
</Layout>

<script>
  import type PhotoSwipe from "photoswipe";
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";

  const lightbox = new PhotoSwipeLightbox({
    gallery: "#gallery",
    children: "a",
    pswpModule: () => import("photoswipe"),
    bgOpacity: 0.85,
    escKey: true,
    pinchToClose: true,
  });

  lightbox.on("uiRegister", () => {
    lightbox.pswp?.ui?.registerElement({
      name: "gallery-caption",
      order: 9,
      isButton: false,
      appendTo: "root",
      html: '<div class="gallery-pswp-caption"><span data-gallery-caption-text></span></div>',
      onInit: (captionEl: HTMLElement, pswp: PhotoSwipe) => {
        const captionTextEl = captionEl.querySelector<HTMLElement>("[data-gallery-caption-text]");
        const updateCaption = () => {
          const slideElement = pswp.currSlide?.data?.element;
          const caption = slideElement instanceof HTMLElement ? slideElement.dataset.galleryCaption : "";

          if (!captionTextEl || !caption) {
            captionEl.hidden = true;
            return;
          }

          captionTextEl.textContent = caption;
          captionEl.hidden = false;
        };

        pswp.on("change", updateCaption);
        pswp.on("afterInit", updateCaption);
        updateCaption();
      },
    });
  });

  lightbox.init();
</script>

<style is:global>
  .gallery-pswp-caption {
    position: absolute;
    right: 0;
    bottom: 2rem;
    left: 0;
    z-index: 10;
    display: flex;
    justify-content: center;
    padding: 0 1rem;
    pointer-events: none;
  }

  .gallery-pswp-caption[hidden] {
    display: none;
  }

  .gallery-pswp-caption [data-gallery-caption-text] {
    max-width: min(40rem, calc(100vw - 2rem));
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: #fafaf8;
    text-align: center;
    background: rgba(28, 25, 23, 0.72);
    border: 1px solid rgba(245, 245, 240, 0.14);
    border-radius: 9999px;
    backdrop-filter: blur(12px);
  }
</style>
