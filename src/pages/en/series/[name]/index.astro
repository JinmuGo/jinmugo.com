---
import Layout from "@/layouts/Layout.astro"
import { generateBreadcrumbItems } from "@/utils/breadcrumbUtils"
import { getEnglishPosts } from "@/utils/content/posts"
import { withTrailingSlash } from "@/utils/language"
import { groupContentBySeries } from "@/utils/series"
import { buildPageUrl, generateBreadcrumbSchema, generatePageSchema } from "@/utils/structuredData"

export async function getStaticPaths() {
  const posts = await getEnglishPosts()
  const seriesList = groupContentBySeries(posts)
  return seriesList.map((series) => ({
    params: { name: series.name },
    props: { series },
  }))
}

const { series } = Astro.props
const seriesName = series.name
const title = `${seriesName} Series`
const description = `${series.totalPosts} post${series.totalPosts !== 1 ? "s" : ""} in the ${seriesName} series`
const url = buildPageUrl("/en", `/series/${encodeURIComponent(seriesName)}`)

const breadcrumbItems = generateBreadcrumbItems({
  pathname: `/en/series/${encodeURIComponent(seriesName)}`,
  origin: Astro.url.origin,
  lang: "en",
  title,
})

const pageSchema = generatePageSchema({
  type: "CollectionPage",
  title,
  description,
  url,
  keywords: `series, ${seriesName}`,
  inLanguage: "en",
})
const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbItems)
const jsonLd = [pageSchema, breadcrumbSchema]
---

<Layout title={title} description={description} lang="en" jsonLd={jsonLd} type="website">
  <div class="min-h-screen px-2 sm:px-4">
    <div class="space-y-2 py-6 md:space-y-1">
      <h1
        class="text-3xl leading-9 font-extrabold tracking-tight text-gray-900 sm:text-4xl sm:leading-10 md:text-6xl md:leading-14 dark:text-gray-100"
      >
        {seriesName}
      </h1>
      <p class="text-lg leading-7 text-gray-500 dark:text-gray-400">{description}</p>
    </div>
    <ul>
      {
        series.posts.map((post, idx) => (
          <li class="flex justify-between items-center py-3">
            <div class="flex items-center space-x-2">
              <span class="text-sm text-gray-400 dark:text-gray-500 min-w-[1.5rem]">
                {idx + 1}.
              </span>
              <a
                href={withTrailingSlash(`/en/posts/${post.slug}`)}
                class="text-base sm:text-lg font-medium text-gray-900 hover:text-primary-500 dark:text-gray-100 dark:hover:text-primary-400"
              >
                {post.data.title}
              </a>
            </div>
            <div class="flex-1 border-b-2 min-w-2.5 border-dotted border-gray-300 mx-2" />
            <span class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 min-w-[90px] text-right">
              {post.data.date
                ? new Date(post.data.date).toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "2-digit",
                  })
                : ""}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
