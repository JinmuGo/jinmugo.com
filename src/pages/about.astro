---
import { Image } from "astro:assets"
import { render } from "astro:content"
import { generateBreadcrumbItems } from "@/utils/breadcrumbUtils"
import { getKoreanApp } from "@/utils/content/apps"
import {
  AUTHOR_URL,
  buildPageUrl,
  generateBreadcrumbSchema,
  generatePageSchema,
  generatePersonSchema,
} from "@/utils/structuredData"
import pkg from "~/package.json"
import Avatar from "~/public/avatar.webp"
import Layout from "../layouts/Layout.astro"

// Breadcrumb 항목 생성
const breadcrumbItems = generateBreadcrumbItems({
  pathname: "/about",
  origin: buildPageUrl(pkg.homepage, ""),
  lang: "ko",
  title: "About",
})

const pageSchema = generatePageSchema({
  type: "ProfilePage",
  title: "About",
  description: "About Jinmu",
  url: buildPageUrl(pkg.homepage, "/about"),
  keywords: "about, author, profile",
  inLanguage: "ko",
})

const personSchema = generatePersonSchema({
  name: pkg.author,
  url: AUTHOR_URL,
  description: pkg.description,
  image: new URL("/avatar.webp", pkg.homepage).href,
  sameAs: Object.values(pkg.social),
})
const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbItems)
const jsonLd = [pageSchema, personSchema, breadcrumbSchema]

const app = await getKoreanApp()
const { name, bio } = app[0].data
const { Content } = await render(app[0])
const title = "About"
const description =
  "고진무를 소개합니다. 어떤 개발자인지, 무엇에 관심을 두고 어떻게 일하는지 정리했습니다."
---

<Layout
  title={title}
  description={description}
  image={Avatar}
  lang="ko"
  jsonLd={jsonLd}
  type="website"
>
  <section class="relative w-full mx-auto aspect-square sm:aspect-video">
    <Image
      src={Avatar}
      alt={name}
      widths={[640, 960, 1200]}
      sizes="(max-width: 1024px) 100vw, 1024px"
      class="h-full w-full object-cover"
      loading="eager"
    />
    <div class="absolute bottom-6 left-6 text-white drop-shadow-lg">
      <h1
        class="text-3xl leading-9 font-semibold tracking-tight text-gray-900 sm:text-4xl sm:leading-10 sm:text-gray-50 md:text-6xl md:leading-14 dark:text-gray-50 sm:dark:text-gray-200"
      >
        {name}
      </h1>
      <h2
        class="text-sm sm:text-lg leading-8 font-medium text-gray-800 sm:text-gray-100 dark:text-gray-100 sm:dark:text-gray-300"
      >
        {bio}
      </h2>
    </div>
  </section>
  {
    Content && (
      <div class="prose dark:prose-invert max-w-none pt-8 pb-8 xl:col-span-2">
        <Content />
      </div>
    )
  }

</Layout>
