---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "@/styles/global.css"
import { Font } from "astro:assets"
import type { ImageMetadata } from "astro"
import { getEnglishPosts, getKoreanPosts } from "@/utils/content/posts"
import { detectLanguage } from "@/utils/language"
import { getOpenGraphImageSource } from "@/utils/openGraphMeta"
import pkg from "~/package.json"
import FallbackImage from "~/public/avatar.webp"

interface Props {
  title: string
  description: string
  image?: ImageMetadata | string
  ogImage?: string
  tags?: string[]
  type?: "article" | "website"
  robots?: "index,follow" | "noindex,follow"
  publishedTime?: Date
  modifiedTime?: Date
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const pathname = Astro.url.pathname
const lang = detectLanguage(pathname)
const isEnglish = lang === "en"
const ogLocale = isEnglish ? "en_US" : "ko_KR"

// hreflang: build alternate URL for the other language
const pathWithoutLang = isEnglish ? pathname.replace(/^\/en/, "") || "/" : pathname
const koUrl = new URL(pathWithoutLang, Astro.site).href
const enUrl = new URL(`/en${pathWithoutLang}`, Astro.site).href
const postMatch = pathWithoutLang.match(/^\/posts\/([^/]+)\/?$/)
let hasAlternate = !/^\/404\/?$/.test(pathWithoutLang)

if (postMatch) {
  const slug = decodeURIComponent(postMatch[1])
  const items = await (isEnglish ? getKoreanPosts() : getEnglishPosts())
  hasAlternate = items.some((item: { slug: string }) => item.slug === slug)
}

// RSS feed path based on language
const rssFeedPath = isEnglish ? "en/rss.xml" : "rss.xml"

const {
  title,
  description,
  image = FallbackImage,
  ogImage,
  tags,
  type = "website",
  robots,
  publishedTime,
  modifiedTime,
} = Astro.props

const resolvedOgImage = ogImage ?? getOpenGraphImageSource(image) ?? FallbackImage.src
---

<title>{title.includes("Jinmu Go") ? title : `${title} | Jinmu Go`}</title>
<Font cssVariable="--font-asta-sans" preload={[{ subset: "latin" }]} />
<Font cssVariable="--font-jetbrains-mono" />

<script is:inline>
  // 테마는 시스템 설정만 따른다. 브라우저에 남아 있는 theme 선택값은 지운다.
  ;(() => {
    try {
      localStorage.removeItem("theme")
    } catch {}
    const media = window.matchMedia("(prefers-color-scheme: dark)")
    const apply = () => {
      const theme = media.matches ? "dark" : "light"
      document.documentElement.setAttribute("data-theme", theme)
      document.documentElement.style.colorScheme = theme
    }
    apply()
    media.addEventListener("change", apply)
  })()
</script>

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="google-site-verification" content="pPf0Fz99AaHpsLgkHGJ_dgabmv2foYDp3SEm7p_Oa_I" />
<meta name="naver-site-verification" content="61dcd4cded96b0142fc3825c00bd7d316d48766c" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={pkg.title}
  href={new URL(rssFeedPath, Astro.site).href}
/>
<meta name="generator" content={Astro.generator} />
<meta name="author" content={pkg.author} />
{robots && <meta name="robots" content={robots} />}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL.href} />

<!-- hreflang -->
{
  hasAlternate && (
    <>
      <link rel="alternate" hreflang="ko" href={koUrl} />
      <link rel="alternate" hreflang="en" href={enUrl} />
      <link rel="alternate" hreflang="x-default" href={koUrl} />
    </>
  )
}

<!-- Primary Meta Tags -->
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={Astro.url.href} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={pkg.title} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:image" content={new URL(resolvedOgImage, Astro.url).href} />
<meta property="og:image:alt" content={title} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{isEnglish && <meta property="og:locale:alternate" content="ko_KR" />}
{!isEnglish && <meta property="og:locale:alternate" content="en_US" />}
{tags && tags.map(tag => <meta property="article:tag" content={tag} />)}
{tags && <meta property="og:keywords" content={tags.join(", ")} />}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url.href} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(resolvedOgImage, Astro.url).href} />
<meta name="twitter:creator" content="@jinmugo" />
