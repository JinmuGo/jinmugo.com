---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"

const { src, alt, title, width: suppliedWidth, height: suppliedHeight, ...attrs } = Astro.props

const localImage =
  typeof src === "object" && src !== null && "src" in src ? (src as ImageMetadata) : undefined
const imageSrc = localImage?.src ?? src
const width = localImage?.width ?? suppliedWidth
const height = localImage?.height ?? suppliedHeight
const hasDimensions = width && height

// Responsive sizes for better performance
const sizes = "(max-width: 640px) 100vw, (max-width: 1024px) 80vw, 720px"
---

{
  hasDimensions ? (
    <a
      class="photo-swipe cursor-zoom-in"
      href={imageSrc}
      data-pswp-width={width}
      data-pswp-height={height}
      data-pswp-caption={title || alt}
      target="_blank"
    >
      {localImage ? (
        <Image
          src={localImage}
          alt={alt || ""}
          width={Math.min(localImage.width, 720)}
          layout="constrained"
          sizes={sizes}
          title={title}
          loading="lazy"
          decoding="async"
          class="mx-auto rounded-xl my-8"
          {...attrs}
        />
      ) : (
        <img
          src={imageSrc}
          alt={alt || ""}
          width={width}
          height={height}
          title={title}
          sizes={sizes}
          loading="lazy"
          decoding="async"
          class="mx-auto rounded-xl my-8"
          {...attrs}
        />
      )}
    </a>
  ) : (
    <img
      src={imageSrc}
      alt={alt || ""}
      loading="lazy"
      decoding="async"
      class="mx-auto rounded-xl my-8"
      {...attrs}
    />
  )
}
