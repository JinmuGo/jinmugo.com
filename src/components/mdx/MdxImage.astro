---
const props = Astro.props

// Astro automatically passes width and height for local images in markdown
const { src, alt, title, ...attrs } = props

let imageSrc = src
let width = props.width
let height = props.height

// MDX에서 이미지가 객체(ImageMetadata)로 전달될 경우 처리
if (typeof src === "object" && src !== null && "src" in src) {
  imageSrc = src.src
  width = src.width
  height = src.height
}

const isOptimized = width && height

// Responsive sizes for better performance
const sizes = "(max-width: 640px) 100vw, (max-width: 1024px) 80vw, 720px"
---

{
  isOptimized ? (
    <a
      class="photo-swipe cursor-zoom-in"
      href={imageSrc}
      data-pswp-width={width}
      data-pswp-height={height}
      data-pswp-caption={title || alt}
      target="_blank"
    >
      <img
        src={imageSrc}
        alt={alt || ""}
        width={width}
        height={height}
        title={title}
        sizes={sizes}
        loading="lazy"
        decoding="async"
        class="mx-auto rounded-lg shadow-md my-8"
        {...attrs}
      />
    </a>
  ) : (
    <img
      src={imageSrc}
      alt={alt || ""}
      loading="lazy"
      decoding="async"
      class="mx-auto rounded-lg shadow-md my-8"
      {...attrs}
    />
  )
}
