---
import { Icon } from "astro-icon/components"
import { callouts } from "./callout.astro"

export interface Props {
  type: string
  isFoldable: boolean | string
  className?: string
}
const { type, isFoldable, className } = Astro.props
const callout = callouts[type as keyof typeof callouts] ?? callouts.note
const isFoldableBool = isFoldable === true || isFoldable === "true"
---

{
  isFoldableBool ? (
    <summary
      class={`flex flex-row items-center gap-2 font-semibold ${callout.className.title} ${className ?? ""}`}
    >
      <Icon name={callout.iconName} class="size-5 shrink-0" />
      <slot />
      <Icon
        name="lucide:chevron-down"
        class="size-5 shrink-0 group-open/root:rotate-180 transition-transform"
      />
    </summary>
  ) : (
    <div
      class={`flex flex-row items-center gap-2 font-semibold ${callout.className.title} ${className ?? ""}`}
    >
      <Icon name={callout.iconName} class="size-5 shrink-0" />
      <slot />
    </div>
  )
}
