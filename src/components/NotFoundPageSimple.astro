---
interface Props {
  lang: "ko" | "en"
}

const { lang } = Astro.props

const content = {
  ko: {
    title: "페이지를 찾을 수 없습니다",
    description: "요청하신 페이지가 존재하지 않거나 이동되었을 수 있습니다.",
    homeButton: "홈으로 돌아가기",
    postsLink: "포스트 목록",
  },
  en: {
    title: "Page Not Found",
    description: "The page you requested does not exist or has been moved.",
    homeButton: "Back to Home",
    postsLink: "Posts",
  },
}

const currentContent = content[lang]
const baseUrl = lang === "en" ? "/en" : ""
---

<div class="text-center max-w-2xl mx-auto mt-20">
  <div class="mb-8">
    <h1 class="text-6xl font-semibold text-gray-900 dark:text-gray-100 mb-4">
      404
    </h1>
    <h2 class="text-2xl font-semibold text-gray-700 dark:text-gray-300 mb-4">
      {currentContent.title}
    </h2>
    <p class="text-gray-600 dark:text-gray-400 mb-8">
      {currentContent.description}
    </p>
  </div>

  <div class="space-y-4">
    <a
      href={baseUrl + "/"}
      class="inline-flex items-center px-6 py-3 bg-primary-600 text-white rounded-md hover:bg-primary-700 transition-colors"
    >
      {currentContent.homeButton}
    </a>
    
    <div class="flex justify-center space-x-4">
      <a
        href={`${baseUrl}/posts`}
        class="text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300 transition-colors"
      >
        {currentContent.postsLink}
      </a>
    </div>
  </div>
</div> 