---
import RelatedPosts from "@/components/content/RelatedPosts.astro"
import type { PostMetadata, WeeklyMetadata } from "@/types/content"
import { GiscusComments } from "./GiscusComments"
import { Flower } from "./LikeFlower"

interface Props {
  slug: string
  frontmatter?: PostMetadata | WeeklyMetadata
  type: "post" | "weekly"
}

const { slug, frontmatter, type } = Astro.props
const relatedFrontmatter = frontmatter as PostMetadata | undefined
---

<section class="flex flex-col gap-2 mt-28 mb-6 text md:text-lg">
	<div class="flex flex-col gap-2 items-center justify-center">
		<Flower client:load slug={slug} maxLikesPerIP={5} />
	</div>
	<GiscusComments client:load />
	{relatedFrontmatter && type !== "weekly" && <RelatedPosts current={{ slug, data: relatedFrontmatter, type }} />}
</section> 