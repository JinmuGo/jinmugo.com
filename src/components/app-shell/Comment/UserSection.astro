---
import RelatedPosts from "@/components/content/RelatedPosts.astro"
import type { PostMetadata } from "@/types/content"
import { FumaComments } from "./FumaComments"

interface Props {
  slug: string
  frontmatter?: PostMetadata
}

const { slug, frontmatter } = Astro.props
---

<section class="flex flex-col gap-8 mt-28 mb-12 text md:text-lg">
	<FumaComments client:visible slug={slug} />
	{frontmatter && <RelatedPosts current={{ slug, data: frontmatter, type: "post" }} />}
</section>
