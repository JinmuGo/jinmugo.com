---
import DraftLabel from "@/components/content/DraftLabel.astro"
import type { Post } from "@/types/content"
import { withTrailingSlash } from "@/utils/language"
import Timeline from "./Timeline.astro"
import TimelineDescription from "./TimelineDescription.astro"
import TimelineDot from "./TimelineDot.astro"
import TimelineHeader from "./TimelineHeader.astro"
import TimelineItem from "./TimelineItem.astro"
import TimelineTime from "./TimelineTime.astro"
import TimelineTitle from "./TimelineTitle.astro"

const { posts } = Astro.props

const isEnglish = Astro.url.pathname.startsWith("/en")
const basePath = isEnglish ? "/en" : ""

const allContent = [...posts].sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
)
---

<Timeline>
  {
    allContent.map((item: Post, index: number) => {
      const itemUrl = withTrailingSlash(`${basePath}/posts/${item.slug}`);
      const formattedDate = item.data.date.toISOString().split("T")[0];
      const isLatest = index === 0;
      const isDraft = item.data.draft && import.meta.env.DEV;

      return (
        <TimelineItem>
          <TimelineHeader>
            <TimelineTime datetime={item.data.date.toISOString()}>
              {formattedDate}
            </TimelineTime>
            <TimelineDot isLatest={isLatest} />
            <TimelineTitle href={itemUrl}>
              <div class="flex items-center space-x-2">
                <span>{item.data.title}</span>
                {isDraft && <DraftLabel />}
              </div>
              {item.data.summary && (
                <TimelineDescription class="mt-1 text-gray-500 dark:text-gray-400 text-xs sm:text-sm">
                  {item.data.summary}
                </TimelineDescription>
              )}
            </TimelineTitle>
          </TimelineHeader>
        </TimelineItem>
      );
    })
  }
</Timeline>
