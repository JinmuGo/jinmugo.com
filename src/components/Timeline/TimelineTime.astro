---
// TimelineTime.astro
interface Props {
  class?: string
  datetime?: string
}

const { class: className = "", datetime } = Astro.props
---

<time
  datetime={datetime}
  class={`absolute min-w-2 max-w-2.5 left-0 top-0 text-xs sm:text-sm leading-6 sm:leading-7 text-nowrap text-gray-500 dark:text-gray-400 group-hover:text-gray-700 dark:group-hover:text-gray-300 w-16 sm:w-24 text-right pr-2 sm:pr-4 transition-colors duration-200 ${className}`}
>
  <slot />
</time>
