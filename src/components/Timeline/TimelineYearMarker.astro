---
interface Props {
  year: number
}

const { year } = Astro.props
---

<li
  class="relative mb-6 sm:mb-8 min-h-7 sm:min-h-8 list-none"
  aria-label={`${year}년 게시물`}
>
  <p
    class="absolute top-0 left-[4.73rem] z-10 -translate-x-1/2 px-1 bg-transparent text-gray-400 text-lg tabular-nums sm:left-[6.73rem] sm:text-xl dark:text-gray-500"
  >
    {year}
  </p>
</li>
