<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import type { PhotoSwipeOptions } from "photoswipe";
  import "photoswipe/style.css";

  const initPhotoSwipe = () => {
    const photoScale = 2;
    const gallerySelector = "#prose";
    const childrenSelector = "a.photo-swipe";
    const options: PhotoSwipeOptions = {
      arrowNext: false,
      arrowPrev: false,
      children: childrenSelector,
      counter: false,
      gallery: gallerySelector,
      pswpModule: () => import("photoswipe"),
      showHideAnimationType: "fade",
      zoom: false,
      pinchToClose: true,
      escKey: true,
    };
    const galleryEl = document.querySelector(gallerySelector);
    if (!galleryEl) {
      return;
    }
    const imgEls: HTMLImageElement[] = [];
    const els = galleryEl.querySelectorAll<HTMLImageElement>(
      "img:not(.emoji):not(#embed-card-image)",
    );

    els.forEach((el) => {
      if (el.src.trim() == "") {
        return;
      }
      // 이미 MdxImage 등으로 래핑된 경우 건너뛰기
      if (el.closest("a.photo-swipe")) {
        return;
      }
      if (!imgEls.includes(el)) {
        imgEls.push(el);
      }
    });
    if (imgEls.length === 0 && !galleryEl.querySelector(childrenSelector)) {
      return;
    }
    imgEls.forEach((imgEl) => {
      imgEl.outerHTML = `
  <a class="photo-swipe cursor-zoom-in"
    href="${imgEl.src}"
    data-pswp-width="${(Math.max(imgEl.naturalWidth, imgEl.width) * photoScale).toString()}"
    data-pswp-height="${(Math.max(imgEl.naturalHeight, imgEl.height) * photoScale).toString()}"
    data-pswp-caption="${imgEl.getAttribute("caption") ?? imgEl.alt}"
    target="_blank">
    ${imgEl.outerHTML}
  </a>`;
    });
    // Initialize PhotoSwipe 5
    const lightbox = new PhotoSwipeLightbox(options);
    lightbox.init();
  };

  initPhotoSwipe();
</script>
