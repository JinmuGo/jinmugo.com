---
interface Props {
  years: number[]
}

const { years } = Astro.props
---

<nav
  aria-label="Year navigation"
  class="group/years fixed left-0 top-1/2 z-20 hidden -translate-y-1/2 flex-col pl-6 lg:flex"
>
  {
    years.map((year) => (
      <a
        href={`#year-${year}`}
        class="flex min-h-[44px] items-center gap-2 text-xs font-medium tabular-nums text-gray-400 hover:text-gray-700 dark:text-gray-500 dark:hover:text-gray-200"
      >
        <span aria-hidden="true" class="h-0.5 w-3 rounded-full bg-gray-300 dark:bg-gray-600" />
        <span class="-translate-x-2 opacity-0 transition duration-150 ease-out group-hover/years:translate-x-0 group-hover/years:opacity-100 group-focus-within/years:translate-x-0 group-focus-within/years:opacity-100 motion-reduce:transition-none">
          {year}
        </span>
      </a>
    ))
  }
</nav>
