---
type LabelVariant = "draft" | "weekly"

interface Props {
  variant: LabelVariant
  class?: string
}

const { variant, class: className = "" } = Astro.props

const baseClass =
  "inline-flex shrink-0 items-center text-xs px-2.5 py-1 rounded-full font-medium border"

const variantClass: Record<LabelVariant, string> = {
  draft:
    "bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 border-gray-300 dark:border-gray-600",
  weekly:
    "bg-primary-50 dark:bg-primary-950/40 text-primary-700 dark:text-primary-300 border-primary-200 dark:border-primary-800 font-semibold",
}

const text = variant === "draft" ? "Draft" : "Weekly"
---

<span class:list={[baseClass, variantClass[variant], className]}>
  {text}
</span>
