---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"
import FormattedDate from "@/components/content/FormattedDate.astro"

interface Props {
  title: string
  summary?: string
  date: Date
  image?: ImageMetadata
  imageAlt?: string
}

const { title, summary, date, image, imageAlt } = Astro.props
// 가로 이미지는 칼럼 폭 2:1로 자르고, 세로 이미지(책 표지 등)는 자르지 않고 작게 보여준다.
const isPortrait = image ? image.height > image.width : false
---

<header class="mb-12 pt-10 text-center">
  <h1 id="post-title" class="mb-3 text-2xl font-semibold leading-tight tracking-tight text-balance break-keep text-gray-900 sm:text-3xl dark:text-gray-50">
    {title}
  </h1>
  {
    summary && (
      <p class="mb-6 text-lg leading-relaxed text-balance break-keep text-gray-500 dark:text-gray-400">
        {summary}
      </p>
    )
  }
  {
    image &&
      (isPortrait ? (
        <Image
          src={image}
          alt={imageAlt ?? title}
          width={384}
          class="mx-auto mb-6 h-auto w-48 rounded-xl"
          loading="eager"
        />
      ) : (
        <Image
          src={image}
          alt={imageAlt ?? title}
          width={1440}
          class="mb-6 aspect-2/1 w-full rounded-2xl object-cover"
          loading="eager"
        />
      ))
  }
  <p class="text-sm text-gray-500 dark:text-gray-400">
    <FormattedDate date={date} />
  </p>
</header>
