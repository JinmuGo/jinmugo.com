---
import FormattedDate from "@/components/content/FormattedDate.astro"
import pkg from "~/package.json"

interface Props {
  date: Date
}

const { date } = Astro.props
const aboutPath = Astro.url.pathname.startsWith("/en/") ? "/en/about/" : "/about/"
---

<span class="inline-flex items-center">
  <a href={aboutPath} rel="author" class="underline underline-offset-2">{pkg.author}</a>
  {" · "}
  <FormattedDate date={date} />
</span>
