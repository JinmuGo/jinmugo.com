---
import FormattedDate from "@/components/content/FormattedDate.astro"
import pkg from "~/package.json"

interface Props {
  date: Date
}

const { date } = Astro.props
const aboutPath = Astro.url.pathname.startsWith("/en/") ? "/en/about/" : "/about/"
---

<div class="flex items-center justify-center text-sm text-gray-500 dark:text-gray-400">
  <a href={aboutPath} rel="author" class="font-medium text-gray-700 hover:underline dark:text-gray-300">
    {pkg.author}
  </a>
  <span class="mx-2" aria-hidden="true">·</span>
  <FormattedDate date={date} />
</div>
