---
import FormattedDate from "@/components/content/FormattedDate.astro"
import { getArchivePath } from "@/utils/archive"

interface Props {
  category?: string
  date: Date
  slug: string
  variant?: "default" | "compact"
}

const { category, date, slug, variant = "default" } = Astro.props
---

<div class:list={[
	"text-sm",
	variant === "default" ? "text-gray-500 dark:text-gray-300" : "text-gray-600 dark:text-gray-400"
]}>
	{category && (
		<>
			<a
				href={getArchivePath(Astro.url.pathname.startsWith("/en") ? "/en" : "", "category", category)}
				class="underline"
			>
				{category}
			</a>
			<span> / </span>
		</>
	)}
	<FormattedDate date={date} />
</div>
