---
import type { ArchiveClassification, ArchiveEntry, ArchivePrefix } from "@/utils/archive"
import { getArchivePath } from "@/utils/archive"

interface Props {
  title: string
  items: ArchiveEntry[]
  classify: ArchiveClassification
  prefix: ArchivePrefix
  itemClass?: string
}

const { title, items, classify, prefix, itemClass = "" } = Astro.props
---

<h2 class="text-fg font-semibold text-[26px]">{title}</h2>
<ul
  class="grid grid-cols-2 md:grid-cols-3 2xl:grid-cols-4 gap-x-4 my-3 list-none"
  data-animate
>
  {
    items.map(({ label, count }) => (
      <li
        class={`mb-3 italic hover:text-primary-500 dark:hover:text-primary-400 ${itemClass}`}
        style="will-change: opacity"
      >
        <a
          href={getArchivePath(prefix, classify, label)}
          data-archive-label={label}
          class="flex justify-between py-1 no-underline border-b"
        >
          {label} <span>{count}</span>
        </a>
      </li>
    ))
  }
</ul>
