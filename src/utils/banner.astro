---
import type { ImageMetadata } from "astro"

export const getBannerImageBySlug = (slug: string) => {
  const images = import.meta.glob<{ default: ImageMetadata }>("~/obsidian/post/**/*.jpg", {
    eager: true,
  })
  const image = images[`/obsidian/post/${slug}/${slug}.jpg`]
  return image?.default
}
