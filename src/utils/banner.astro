---
import type { ImageMetadata } from "astro"

export const getBannerImageBySlug = (slug: string) => {
  const images = import.meta.glob<{ default: ImageMetadata }>(
    "../../obsidian/post/**/*.{jpg,jpeg,png,webp}",
    { eager: true },
  )

  for (const ext of ["webp", "png", "jpg", "jpeg"] as const) {
    const image = images[`../../obsidian/post/${slug}/${slug}.${ext}`]
    if (image) {
      return image.default
    }
  }

  return undefined
}
