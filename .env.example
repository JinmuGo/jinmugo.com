PUBLIC_ENV=development
PUBLIC_COMMENT_API_URL=http://localhost:3001
DEEPL_API_KEY=

# Obsidian content source path.
# Local development can point this at a real vault folder, for example:
# OBSIDIAN_VAULT_PATH=/Users/jinmu/Obsidian/PKM/0.Blog
# Leave empty in CI/other machines to use the checked-out blog_obsidian/ submodule.
OBSIDIAN_VAULT_PATH=

# R2 Storage
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=

# Gallery metadata manifest generation
# Used by `pnpm gallery:manifest <icloudpd-directory> -- --upload`
GALLERY_GEOCODER_USER_AGENT=jinmugo.com gallery metadata (hi@jinmugo.com)

# Google Search Console
GSC_PROPERTY_ID=
GSC_SITE_URL=
GOOGLE_APPLICATION_CREDENTIALS=
