---
import type { ImageMetadata } from "astro";

export const getBannerImageBySlug = (slug: string) => {
  const images = import.meta.glob<{ default: ImageMetadata }>(
    "~/blog_obsidian/post/**/*.jpg",
    {
      eager: true,
    },
  );
  const image = images[`/blog_obsidian/post/${slug}/${slug}.jpg`];
  return image?.default;
};
---
