---
import RelatedPosts from "@/components/RelatedPosts.astro"
import type { MemoMetadata, PostMetadata } from "@/types/content"
import { GiscusComments } from "./GiscusComments"
import { UserSectionHeader } from "./UserSectionHeader"

interface Props {
  slug: string
  frontmatter?: PostMetadata | MemoMetadata
  type: "post" | "memo"
}

const { slug, frontmatter, type } = Astro.props
---

<section class="flex flex-col gap-2 mt-28 mb-6 text md:text-lg">
  <UserSectionHeader client:load slug={slug} maxLikesPerIP={5} frontmatter={frontmatter} />
  <GiscusComments client:load />
  {frontmatter && <RelatedPosts current={{ slug, data: frontmatter, type }} />}
</section> 