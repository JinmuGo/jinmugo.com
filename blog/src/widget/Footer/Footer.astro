---
import pkg from "~/package.json"
import SocialIcon from "./SocialIcon.astro"
---

<footer id="footer" class="py-10 border-t border-gray-200 dark:border-gray-700">
  <div
    class="flex flex-col gap-4 justify-end w-full md:flex-row md:justify-between md:items-center"
  >
    <div class="space-x-4 flex">
      <SocialIcon kind="mail" href={`mailto:${pkg.email}`} size={6} />
      <SocialIcon kind="github" href={pkg.social.github} size={6} />
      <SocialIcon kind="linkedin" href={pkg.social.linkedin} size={6} />
    </div>
    <div>
      <p class="text-gray-500 dark:text-gray-400">
        © {new Date().getFullYear()} Jinmu Go. All rights reserved.
      </p>
    </div>
  </div>
</footer>
