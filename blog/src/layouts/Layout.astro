---
import BaseHead from "@/components/BaseHead.astro"
import GoogleTag from "@/components/GoogleTag.astro"
import Umami from "@/components/Umami.astro"
import Container from "@/layouts/Container.astro"
import type { Post } from "@/types/content"
import StructuredData from "@/utils/structuredData.astro"
import Header from "@/widget/Header/Header.tsx"
import pkg from "~/package.json"

const pathname = Astro.url.pathname

const frontmatter = Astro.props.frontmatter as Post
const title = Astro.props.title ?? pkg.title
const description = Astro.props.description ?? pkg.description
const image = Astro.props.image
const lang = Astro.props.lang ?? "ko"
const jsonLd = Astro.props.jsonLd
const ogImage = Astro.props.ogImage
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} image={image} ogImage={ogImage} />
    {jsonLd && <StructuredData schema={jsonLd} />}
    <GoogleTag />
    <Umami />
  </head>
  <body class="text-foreground font-sans dark:bg-gray-950">
    <Header frontmatter={frontmatter} pathname={pathname} client:load />
    <Container>
      <slot />
    </Container>
  </body>
</html>
