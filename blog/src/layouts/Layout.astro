---
import BaseHead from "@/components/seo/BaseHead.astro"
import GoogleTag from "@/components/seo/GoogleTag.astro"
import Umami from "@/components/seo/Umami.astro"
import Container from "@/layouts/Container.astro"
import type { Post } from "@/types/content"
import StructuredData from "@/utils/structuredData.astro"
import Header from "@/components/app-shell/Header/Header.tsx"

const pathname = Astro.url.pathname

const frontmatter = Astro.props.frontmatter as Post
const title = Astro.props.title
const description = Astro.props.description
const image = Astro.props.image
const lang = Astro.props.lang ?? "ko"
const jsonLd = Astro.props.jsonLd
const ogImage = Astro.props.ogImage
const type = Astro.props.type ?? "website"
const tags = Astro.props.tags ?? frontmatter?.tags
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} image={image} ogImage={ogImage} type={type} tags={tags} />
    {jsonLd && <StructuredData schema={jsonLd} />}
    <GoogleTag />
    <Umami />
  </head>
  <body class="text-foreground font-sans dark:bg-gray-950">
    <Header frontmatter={frontmatter} pathname={pathname} client:load />
    <Container>
      <slot />
    </Container>
  </body>
</html>
