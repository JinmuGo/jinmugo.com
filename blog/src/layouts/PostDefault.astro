---
import type { CollectionEntry } from "astro:content";
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import Prose from "@/components/Prose.astro";
import Container from "@/components/Container.astro";
import PageViews from "@/components/PageViews.astro";
import AICollaborationBadge from "@/components/AICollaborationBadge.astro";

interface Props {
  frontmatter: CollectionEntry<"post">["data"] & { slug: string };
}

const { frontmatter } = Astro.props;
const { title, date, summary, category, withAI, slug } = frontmatter;
---

<html lang="ko">
  <head>
    <BaseHead title={title} description={summary || title} />
  </head>

  <body>
    <Header />
    <Container>
      <main>
        <article>
          <header class="space-y-1 pb-5">
            <div id="post-title" class="pt-5 space-y-1">
              <h1 class="font-bold text-xl md:text-2xl">{title}</h1>
              <div class="text-sm text-gray-500 dark:text-gray-300">
                <a class="underline" href={`/archives/category/${category}`}>
                  {category}
                </a>{" "}
                / <FormattedDate date={date} />
              </div>
              <div class="flex items-center gap-2">
                <PageViews slug={slug} />
                <AICollaborationBadge withAI={withAI} lang="ko" />
              </div>
            </div>
          </header>
          <Prose>
            <slot />
          </Prose>
        </article>
      </main>
    </Container>
  </body>
</html>
