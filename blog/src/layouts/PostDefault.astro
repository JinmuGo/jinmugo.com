---
import Breadcrumb from "@/components/Breadcrumb.astro"
import FormattedDate from "@/components/FormattedDate.astro"
import { PageViewIsland } from "@/components/PageViewIsland"
import Prose from "@/components/Prose.astro"
import Layout from "@/layouts/Layout.astro"
import type { PostMetadata } from "@/types/content"
import { generateContentBreadcrumbs } from "@/utils/breadcrumbUtils"
import {
  buildPageUrl,
  generateBlogPostingSchema,
  generateBreadcrumbSchema,
} from "@/utils/structuredData"
import UserSection from "@/widget/Comment/UserSection.astro"

interface Props {
  frontmatter: PostMetadata
}

const { frontmatter } = Astro.props
const { title, date, summary, category, slug, tags, href } = frontmatter
const lang = Astro.url.pathname.startsWith("/en") ? "en" : "ko"

const pageSchema = generateBlogPostingSchema({
  title: title,
  description: summary || title,
  url: href,
  keywords: tags?.join(", ") || "",
  inLanguage: lang,
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
  authorName: "Jinmu",
  authorUrl: "https://jinmu.me/about",
  wordCount: frontmatter.wordCount,
  readingTime: frontmatter.readingTime,
  imageUrl: frontmatter.image ? `${Astro.url.origin}${frontmatter.image}` : undefined,
})

// Breadcrumb 항목 생성
const breadcrumbItems = generateContentBreadcrumbs({
  pathname: Astro.url.pathname,
  origin: Astro.url.origin,
  lang,
  title,
  category,
  contentType: "post",
})

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbItems)
---

<Layout
  frontmatter={frontmatter}
  title={title}
  description={summary || title}
  lang={lang}
  jsonLd={[pageSchema, breadcrumbSchema]}
  ogImage={`/posts/${slug}/og.png`}
  type="article"
  tags={tags}
>
  <Breadcrumb items={breadcrumbItems}/>
  <header class="space-y-3 mb-16 md:mb-20">
    <div id="post-title" class="pt-6 space-y-3">
      <h1 class="font-bold text-2xl md:text-3xl xl:text-4xl leading-tight tracking-tight text-gray-900 dark:text-gray-50">{title}</h1>
      <div class="flex items-center gap-3 text-sm text-gray-600 dark:text-gray-400 flex-wrap">
        <a 
          class="inline-flex items-center px-2.5 py-1 rounded-full bg-primary-50 dark:bg-primary-950/30 text-primary-700 dark:text-primary-300 hover:bg-primary-100 dark:hover:bg-primary-900/40 transition-colors duration-200 font-medium" 
          href={`/archives/category/${category}`}
        >
          {category}
        </a>
        <span class="text-gray-400 dark:text-gray-500">•</span>
        <FormattedDate date={date} />
      </div>
      <div class="flex items-center gap-2 pt-1">
        <PageViewIsland client:load slug={slug} />
      </div>
    </div>
  </header>
  <Prose as="article">
    <slot />
  </Prose>
  <UserSection slug={slug} frontmatter={frontmatter} type="post" />
</Layout>
