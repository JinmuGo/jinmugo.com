---
import AICollaborationBadge from "@/components/AICollaborationBadge.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import PageView from "@/components/PageView.astro";
import Prose from "@/components/Prose.astro";
import Layout from "@/layouts/Layout.astro";
import type { PostMetadata } from "@/types/content";
import { buildPageUrl, generatePostsPageSchema } from "@/utils/structuredData";

interface Props {
	frontmatter: PostMetadata;
}

const { frontmatter } = Astro.props;
const { title, date, summary, category, withAI, slug, tags } = frontmatter;
const lang = Astro.url.pathname.startsWith("/en") ? "en" : "ko";
const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL;

const jsonLd = generatePostsPageSchema({
	title: title,
	description: summary || title,
	url: buildPageUrl("", `/${category}/${slug}`),
	keywords: tags?.join(", ") || "",
	inLanguage: lang,
});
---

<Layout
  frontmatter={frontmatter}
  title={title}
  description={summary || title}
  lang={lang}
  jsonLd={jsonLd}
>
  <header class="space-y-1">
    <div id="post-title" class="pt-5 space-y-1">
      <h1 class="font-bold text-xl xl:text-2xl">{title}</h1>
      <div class="text-sm text-gray-500 dark:text-gray-300">
        <a class="underline" href={`/archives/category/${category}`}>
          {category}
        </a>{" "}
        / <FormattedDate date={date} />
      </div>
      <div class="flex items-center gap-2">
        <PageView slug={slug} apiBaseUrl={apiBaseUrl} />
        <AICollaborationBadge withAI={withAI} lang="ko" />
      </div>
    </div>
  </header>
  <Prose as="article">
    <slot />
  </Prose>
</Layout>
