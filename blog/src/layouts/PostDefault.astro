---
import Breadcrumb from "@/components/Breadcrumb.astro"
import FormattedDate from "@/components/FormattedDate.astro"
import { PageViewIsland } from "@/components/PageViewIsland"
import Prose from "@/components/Prose.astro"
import Layout from "@/layouts/Layout.astro"
import type { PostMetadata } from "@/types/content"
import { generateContentBreadcrumbs } from "@/utils/breadcrumbUtils"
import {
  buildPageUrl,
  generateBreadcrumbSchema,
  generatePostsPageSchema,
} from "@/utils/structuredData"
import UserSection from "@/widget/Comment/UserSection.astro"

interface Props {
  frontmatter: PostMetadata
}

const { frontmatter } = Astro.props
const { title, date, summary, category, slug, tags } = frontmatter
const lang = Astro.url.pathname.startsWith("/en") ? "en" : "ko"

const pageSchema = generatePostsPageSchema({
  title: title,
  description: summary || title,
  url: buildPageUrl("", `/${category}/${slug}`),
  keywords: tags?.join(", ") || "",
  inLanguage: lang,
})

// Breadcrumb 항목 생성
const breadcrumbItems = generateContentBreadcrumbs({
  pathname: Astro.url.pathname,
  origin: Astro.url.origin,
  lang,
  title,
  category,
  contentType: "post",
})

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbItems)
---

<Layout
  frontmatter={frontmatter}
  title={title}
  description={summary || title}
  lang={lang}
  jsonLd={[pageSchema, breadcrumbSchema]}
  ogImage={`/posts/${slug}/og.png`}
>
  <Breadcrumb items={breadcrumbItems}/>
  <header class="space-y-1 mb-20">
    <div id="post-title" class="pt-5 space-y-1">
      <h1 class="font-bold text-xl xl:text-3xl">{title}</h1>
      <div class="text-sm text-gray-500 dark:text-gray-300">
        <a class="underline" href={`/archives/category/${category}`}>
          {category}
        </a>{" "}
        / <FormattedDate date={date} />
      </div>
      <div class="flex items-center gap-2">
        <PageViewIsland client:load slug={slug} />
      </div>
    </div>
  </header>
  <Prose as="article">
    <slot />
  </Prose>
  <UserSection slug={slug} frontmatter={frontmatter} />
</Layout>
