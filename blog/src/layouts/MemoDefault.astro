---
import Breadcrumb from "@/components/Breadcrumb.astro"
import FormattedDate from "@/components/FormattedDate.astro"
import { PageViewIsland } from "@/components/PageViewIsland"
import Prose from "@/components/Prose.astro"
import Layout from "@/layouts/Layout.astro"
import type { Memo } from "@/types/content"
import { generateContentBreadcrumbs } from "@/utils/breadcrumbUtils"
import { generateBreadcrumbSchema } from "@/utils/structuredData"
import UserSection from "@/widget/Comment/UserSection.astro"

interface Props {
  frontmatter: Memo
}

const { frontmatter } = Astro.props
const { title, date, summary, category, slug } = frontmatter
const lang = Astro.url.pathname.startsWith("/en") ? "en" : "ko"

// Breadcrumb 항목 생성
const breadcrumbItems = generateContentBreadcrumbs({
  pathname: Astro.url.pathname,
  origin: Astro.url.origin,
  lang,
  title,
  category,
  contentType: "memo",
})

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbItems)
---

<Layout
  frontmatter={frontmatter}
  title={title}
  description={summary || title}
  lang={lang}
  jsonLd={breadcrumbSchema}
  ogImage={`/memos/${slug}/og.png`}
>
  <Breadcrumb items={breadcrumbItems} />
  <main>
    <article>
      <header class="space-y-1 pb-5">
        <div id="memo-title" class="pt-5 space-y-1">
          <h1 class="font-bold text-xl md:text-2xl">{title}</h1>
          <p class="text-sm text-gray-500 dark:text-gray-300">
            {summary}
          </p>
          <div class="text-sm text-gray-500 dark:text-gray-300">
            {
              category && (
                <a
                  class="underline"
                  href={`/archives/category/${category}`}
                >
                  {category}
                </a>
              )
            }
            {category && " / "}
            <FormattedDate date={date} />
          </div>
          <div class="flex items-center gap-2">
            <PageViewIsland client:load slug={slug} />
          </div>
        </div>
      </header>
      <Prose as="article">
        <slot />
      </Prose>
    </article>
  </main>
      <UserSection slug={slug} frontmatter={frontmatter} />
</Layout>
