---
import type { CollectionEntry } from "astro:content";
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import { Image } from "astro:assets";
import { getBannerImage } from "@/utils/banner";
import Prose from "@/components/Prose.astro";
import PageViews from "@/components/PageViews.astro";
import AICollaborationBadge from "@/components/AICollaborationBadge.astro";
import Container from "@/components/Container.astro";

interface Props {
  frontmatter: CollectionEntry<"post">["data"] & { slug: string };
}

const { frontmatter } = Astro.props;
const { title, date, lastmod, banner, summary, withAI, category, slug } =
  frontmatter;

// banner 이미지 가져오기
const bannerSrc = await getBannerImage(banner, frontmatter.slug);
const { width, height } = bannerSrc;
---

<html lang="ko">
  <head>
    <BaseHead title={title} description={summary || title} />
  </head>
  <body>
    <Header />
    <Container>
      <main>
        <article>
          <header
            class="space-y-1 pb-5 md:flex md:flex-row-reverse md:justify-between items-end"
          >
            <Image
              width={width}
              height={height}
              src={bannerSrc}
              alt={`${title} 배너`}
            />
          </header>
          <div id="post-title" class="pt-10">
            <div class="flex items-center gap-2">
              <PageViews slug={slug} />
              <AICollaborationBadge withAI={withAI} lang="ko" />
            </div>
            <h1 class="font-bold text-xl md:text-2xl">{title}</h1>
            <p>{summary}</p>
            <div class="text-sm text-gray-500 dark:text-gray-300">
              <a class="underline" href={`/archives/category/${category}`}>
                {category}
              </a>{" "}
              / <FormattedDate date={date} />
            </div>
          </div>
          <Prose>
            <slot />
          </Prose>
        </article>
      </main>
    </Container>
  </body>
</html>
