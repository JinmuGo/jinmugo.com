---
import { Image } from "astro:assets"
import FormattedDate from "@/components/FormattedDate.astro"
import { PageViewIsland } from "@/components/PageViewIsland"
import Prose from "@/components/Prose.astro"
import Layout from "@/layouts/Layout.astro"
import type { PostMetadata } from "@/types/content"
import { buildPageUrl, generatePostsPageSchema } from "@/utils/structuredData"
import { UserSection } from "@/widget/Comment/UserSection"

interface Props {
  frontmatter: PostMetadata
  bannerImage: ImageMetadata
}

const { frontmatter, bannerImage } = Astro.props
const { title, date, summary, category, slug, tags } = frontmatter

const { width, height } = bannerImage
const lang = Astro.url.pathname.startsWith("/en") ? "en" : "ko"

const jsonLd = generatePostsPageSchema({
  title: title,
  description: summary || title,
  url: buildPageUrl("", `/${category}/${slug}`),
  keywords: tags?.join(", ") || "",
  inLanguage: lang,
})
---

<Layout
  frontmatter={frontmatter}
  title={title}
  description={summary || title}
  lang={lang}
  jsonLd={jsonLd}
  ogImage={`/posts/${slug}/og.png`}
>
    <header
      class="space-y-1 pb-5 md:flex md:flex-row-reverse md:justify-between items-end"
    >
      <Image
        width={width}
        height={height}
        src={bannerImage}
        alt={`${title} 배너`}
      />
      <div id="post-title" class="pt-10">
        <div class="flex items-center gap-2">
          <PageViewIsland slug={slug} client:load />
        </div>
        <h1 class="font-bold text-xl md:text-2xl">{title}</h1>
        <p>{summary}</p>
        <div class="text-sm text-gray-500 dark:text-gray-300">
          <a href={`/archives/category/${category}`} class="underline">
            {category}
          </a> / <FormattedDate date={date} />
        </div>
      </div>
    </header>
  <Prose as="article">
    <slot />
  </Prose>
  <UserSection client:load slug={slug} frontmatter={frontmatter} />
</Layout>
