---
import { Image } from "astro:assets"
import Breadcrumb from "@/components/Breadcrumb.astro"
import FormattedDate from "@/components/FormattedDate.astro"
import { PageViewIsland } from "@/components/PageViewIsland"
import Prose from "@/components/Prose.astro"
import Layout from "@/layouts/Layout.astro"
import type { PostMetadata } from "@/types/content"
import { generateContentBreadcrumbs } from "@/utils/breadcrumbUtils"
import {
  buildPageUrl,
  generateBlogPostingSchema,
  generateBreadcrumbSchema,
} from "@/utils/structuredData"
import UserSection from "@/widget/Comment/UserSection.astro"

interface Props {
  frontmatter: PostMetadata
  bannerImage: ImageMetadata
}

const { frontmatter, bannerImage } = Astro.props
const { title, date, summary, category, slug, tags, href } = frontmatter

const { width, height } = bannerImage
const lang = Astro.url.pathname.startsWith("/en") ? "en" : "ko"

const pageSchema = generateBlogPostingSchema({
  title: title,
  description: summary || title,
  url: href,
  keywords: tags?.join(", ") || "",
  inLanguage: lang,
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
  authorName: "Jinmu",
  authorUrl: "https://jinmu.me/about",
  wordCount: frontmatter.wordCount,
  readingTime: frontmatter.readingTime,
  imageUrl: bannerImage ? `${Astro.url.origin}/posts/${slug}/banner.webp` : undefined,
})

// Breadcrumb 항목 생성
const breadcrumbItems = generateContentBreadcrumbs({
  pathname: Astro.url.pathname,
  origin: Astro.url.origin,
  lang,
  title,
  category,
  contentType: "post",
})

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbItems)
---

<Layout
  frontmatter={frontmatter}
  title={title}
  description={summary || title}
  lang={lang}
  jsonLd={[pageSchema, breadcrumbSchema]}
  ogImage={`/posts/${slug}/og.png`}
  type="article"
  tags={tags}
>
  <Breadcrumb items={breadcrumbItems}/>
    <header
      class="space-y-1 pb-5 md:flex md:flex-row-reverse md:justify-between items-end"
    >
      <Image
        width={width}
        height={height}
        src={bannerImage}
        alt={`${title} 배너`}
      />
      <div id="post-title" class="pt-10">
        <div class="flex items-center gap-2">
          <PageViewIsland slug={slug} client:load />
        </div>
        <h1 class="font-bold text-xl md:text-2xl">{title}</h1>
        <p>{summary}</p>
        <div class="text-sm text-gray-500 dark:text-gray-300">
          <a href={`/archives/category/${category}`} class="underline">{category}</a>
          / <FormattedDate date={date} />
        </div>
      </div>
    </header>
  <Prose as="article">
    <slot />
  </Prose>
  <UserSection slug={slug} frontmatter={frontmatter} type="post" />
</Layout>
