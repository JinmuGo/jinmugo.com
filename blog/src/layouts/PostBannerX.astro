---
import { Image } from "astro:assets";
import AICollaborationBadge from "@/components/AICollaborationBadge.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import PageView from "@/components/PageView.astro";
import Prose from "@/components/Prose.astro";
import Layout from "@/layouts/Layout.astro";
import type { PostMetadata } from "@/types/content";
import { buildPageUrl, generatePostsPageSchema } from "@/utils/structuredData";

interface Props {
  frontmatter: PostMetadata;
  bannerImage: ImageMetadata;
}

const { frontmatter, bannerImage } = Astro.props;
const { title, date, summary, category, slug, withAI, tags } = frontmatter;
const lang = Astro.url.pathname.startsWith("/en") ? "en" : "ko";
const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL;

const jsonLd = generatePostsPageSchema({
  title: title,
  description: summary || title,
  url: buildPageUrl("", `/${category}/${slug}`),
  keywords: tags?.join(", ") || "",
  inLanguage: lang,
});
---

<Layout
  frontmatter={frontmatter}
  title={title}
  description={summary || title}
  lang={lang}
  jsonLd={jsonLd}
>
  <Prose>
    <header class="space-y-1 pb-5 text-center">
      <div class="w-11/12 mx-auto">
        <Image
          width={1200}
          height={300}
          src={bannerImage}
          alt={`${title} 배너`}
        />
      </div>
      <div id="post-title" class="pt-10">
        <h1 class="text-3xl md:text-4xl">{title}</h1>
        <p>{summary}</p>
        <div class="text-sm text-gray-500 dark:text-gray-300">
          <a href={`/archives/category/${category}`} class="underline">
            {category}
          </a> / <FormattedDate date={date} />
          <div>
            <PageView slug={slug} apiBaseUrl={apiBaseUrl} />
            <AICollaborationBadge withAI={withAI} lang={lang} />
          </div>
        </div>
      </div>
    </header>
    <slot />
  </Prose>
</Layout>
