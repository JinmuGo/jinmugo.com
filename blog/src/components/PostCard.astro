---
import type { CollectionEntry } from "astro:content";

interface Props {
	post: CollectionEntry<"post">;
	basePath?: string;
	showImage?: boolean;
}

const { post, basePath = "", showImage = true } = Astro.props;
const postUrl = `${basePath}/posts/${post.data.category}/${post.slug}`;
const categoryUrl = `${basePath}/archives/category/${post.data.category}`;
---

<article class="group relative flex flex-col space-y-2">
  {
    showImage && (
      <a href={postUrl}>
        <div class="aspect-video overflow-hidden rounded-lg border border-gray-200 dark:border-gray-700">
          {post.data.banner ? (
            <img
              src={post.data.banner}
              alt={`${post.data.title} 배너`}
              class="object-cover transition-transform group-hover:scale-105"
              loading="lazy"
            />
          ) : (
            <div class="flex h-full items-center justify-center bg-gray-100 dark:bg-gray-800">
              <span class="text-gray-500 dark:text-gray-400">No Image</span>
            </div>
          )}
        </div>
      </a>
    )
  }

  <div class="space-y-1">
    <h2 class="font-semibold leading-none tracking-tight">
      <a href={postUrl} class="hover:underline">
        {post.data.title}
      </a>
    </h2>

    {
      post.data.summary && (
        <p class="text-sm text-gray-500 dark:text-gray-400 line-clamp-2">
          {post.data.summary}
        </p>
      )
    }

    <div
      class="flex items-center space-x-2 text-sm text-gray-500 dark:text-gray-400"
    >
      {
        post.data.category && (
          <a href={categoryUrl} class="hover:underline">
            {post.data.category}
          </a>
        )
      }
      <span>/</span>
      <time datetime={post.data.date.toISOString()}>
        {
          post.data.date.toLocaleDateString("ko-KR", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }
      </time>
    </div>
  </div>
</article>
