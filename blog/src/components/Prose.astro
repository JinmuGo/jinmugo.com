---
interface Props {
  as?: string
}

const { as = "div" } = Astro.props
const id = "prose"
const defaultClass = "prose-custom"
---

{
  as === "div" && (
    <div id={id} class={defaultClass}>
      <slot />
    </div>
  )
}

{
  as === "section" && (
    <section id={id} class={defaultClass}>
      <slot />
    </section>
  )
}

{
  as === "article" && (
    <article id={id} class={defaultClass}>
      <slot />
    </article>
  )
}

{
  as === "main" && (
    <main id={id} class={defaultClass}>
      <slot />
    </main>
  )
}
