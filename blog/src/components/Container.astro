---
import { cn } from "@/utils/tailwind";
import Footer from "@/components/Footer.astro";

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<main
  class={cn(
    `mx-auto divide-y divide-gray-200 dark:divide-gray-800 min-h-dvh flex flex-col justify-between max-w-2xl lg:max-w-3xl xl:max-w-4xl px-4 sm:px-6 xl:px-0`,
    className,
  )}
>
  <slot />
  <Footer />
</main>
