---
// TimelineTitle.astro
interface Props {
  class?: string;
  href?: string;
}

const { class: className = "", href } = Astro.props;
const baseStyle =
  "pl-[5.5rem] sm:pl-[7.5rem] flex-1 inline-link text-base sm:text-lg  text-gray-900 hover:text-primary-500 dark:text-gray-100 dark:hover:text-primary-400";
---

{
  href ? (
    <a href={href} class={`${baseStyle} ${className}`}>
      <slot />
    </a>
  ) : (
    <div class={`${baseStyle} ${className}`}>
      <slot />
    </div>
  )
}
