---
import FormattedDate from "@/components/FormattedDate.astro"
import { getEnglishPosts, getKoreanPosts } from "@/content-utils/posts"
import type { Post } from "@/types/content"

interface Props {
  current: Post
}

const { current } = Astro.props as Props

// 현재 포스트가 영어인지 한국어인지 확인
const isEnglish = current.slug.endsWith("en") || (current.id ?? "").includes("/en/")
const allPosts = isEnglish ? await getEnglishPosts() : await getKoreanPosts()

// 날짜순으로 정렬 (최신순)
const sortedPosts = allPosts.sort(
  (a: Post, b: Post) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
)

const currentIndex = sortedPosts.findIndex((post: Post) => post.slug === current.slug)

const prevPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null
const nextPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null
---

{(prevPost || nextPost) && (
  <aside class="pt-6 border-t border-gray-200 dark:border-gray-800">
    <div class="flex flex-col gap-3 md:flex-row md:gap-4">
      {/* 이전 글 */}
      {prevPost && (
        <article class="group flex-1 relative bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-lg p-4 hover:shadow-sm transition-all">
          <a href={`/posts/${prevPost.data.category}/${prevPost.slug}`} class="block h-full">
            <div class="flex items-center gap-2 mb-2">
              <svg class="w-4 h-4 text-primary-500 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
              <span class="text-xs font-medium text-primary-600 dark:text-primary-400">이전 글</span>
            </div>
            
            <h3 class="font-semibold text-base text-gray-900 dark:text-gray-100 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors leading-tight mb-2">
              {prevPost.data.title}
            </h3>
            
            <div class="flex-1 min-h-[3rem] flex items-end">
              <div class="w-full">
                {prevPost.data.summary && (
                  <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-1 leading-relaxed mb-2">
                    {prevPost.data.summary}
                  </p>
                )}
                
                <div class="flex items-center justify-between text-xs text-gray-500 dark:text-gray-400">
                  {prevPost.data.category && (
                    <span class="px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded text-xs font-medium text-gray-700 dark:text-gray-300">
                      {prevPost.data.category}
                    </span>
                  )}
                  <FormattedDate date={prevPost.data.date} />
                </div>
              </div>
            </div>
          </a>
        </article>
      )}

      {/* 다음 글 */}
      {nextPost && (
        <article class="group flex-1 relative bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-lg p-4 hover:shadow-sm transition-all">
          <a href={`/posts/${nextPost.data.category}/${nextPost.slug}`} class="block h-full">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xs font-medium text-primary-600 dark:text-primary-400">다음 글</span>
              <svg class="w-4 h-4 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </div>
            
            <h3 class="font-semibold text-base text-gray-900 dark:text-gray-100 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors leading-tight mb-2">
              {nextPost.data.title}
            </h3>
            
            <div class="flex-1 min-h-[3rem] flex items-end">
              <div class="w-full">
                {nextPost.data.summary && (
                  <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-1 leading-relaxed mb-2">
                    {nextPost.data.summary}
                  </p>
                )}
                
                <div class="flex items-center justify-between text-xs text-gray-500 dark:text-gray-400">
                  {nextPost.data.category && (
                    <span class="px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded text-xs font-medium text-gray-700 dark:text-gray-300">
                      {nextPost.data.category}
                    </span>
                  )}
                  <FormattedDate date={nextPost.data.date} />
                </div>
              </div>
            </div>
          </a>
        </article>
      )}
    </div>
  </aside>
)}

<style>
  .line-clamp-1 {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

