---
import type { BreadcrumbItem } from "@/utils/structuredData"

export interface Props {
  items: BreadcrumbItem[]
}

const { items } = Astro.props
---

<nav aria-label="Breadcrumb" class="relative z-100 mb-2 text-sm text-gray-600 dark:text-gray-400">
  <ol class="flex items-center">
    {items.map((item, index) => (
      <li class="flex items-center">
        {index > 0 && (
          <svg 
            class="w-4 h-4 mx-2 text-gray-400 dark:text-gray-500" 
            fill="none" 
            stroke="currentColor" 
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        )}
        {index === items.length - 1 ? (
          <span class="font-medium text-gray-900 dark:text-gray-100" aria-current="page">
            {item.name}
          </span>
        ) : (
          <a 
            href={item.item} 
            class="hover:text-gray-900 dark:hover:text-gray-200 transition-colors duration-200"
          >
            {item.name}
          </a>
        )}
      </li>
    ))}
  </ol>
</nav> 