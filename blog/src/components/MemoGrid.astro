---
import type { CollectionEntry } from 'astro:content';
import MemoCard from './MemoCard.astro';

interface Props {
  memos: CollectionEntry<'memo'>[];
  basePath?: string;
}

const { memos, basePath = "" } = Astro.props;
---

<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
  {memos.map((memo) => (
    <MemoCard memo={memo} basePath={basePath} />
  ))}
</div> 