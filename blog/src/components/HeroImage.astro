---
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  blurSrc?: string;
}

const { src, alt, blurSrc } = Astro.props;
---

<Image
  src={src}
  alt={alt}
  class="object-cover w-full h-full"
  loading="eager"
  fetchpriority="high"
  data-blur-src={blurSrc}
/>
