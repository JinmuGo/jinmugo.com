---
interface Props {
  title?: string;
  basePath?: string;
  lang?: 'ko' | 'en';
}

const { 
  title = "더 보기", 
  basePath = "",
  lang = 'ko'
} = Astro.props;

const postsUrl = `${basePath}/posts`;
const memosUrl = `${basePath}/memos`;
const timelineUrl = `${basePath}/timeline`;
const gridUrl = `${basePath}/grid`;

const postsText = lang === 'ko' ? '포스트' : 'Posts';
const memosText = lang === 'ko' ? '메모' : 'Memos';
const timelineText = lang === 'ko' ? '타임라인' : 'Timeline';
const gridText = lang === 'ko' ? '그리드' : 'Grid';
const postsDesc = lang === 'ko' ? '모든 포스트를 확인해보세요' : 'Check out all posts';
const memosDesc = lang === 'ko' ? '짧은 메모들을 확인해보세요' : 'Check out short memos';
const timelineDesc = lang === 'ko' ? '포스트 타임라인을 확인해보세요' : 'Check out post timeline';
const gridDesc = lang === 'ko' ? '그리드 형태로 포스트를 확인해보세요' : 'Check out posts in grid view';
---

<section>
  <h2 class="text-2xl font-bold mb-4">{title}</h2>
  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
    <a 
      href={postsUrl} 
      class="block p-6 border border-gray-200 dark:border-gray-700 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
    >
      <h3 class="text-lg font-semibold mb-2">{postsText}</h3>
      <p class="text-gray-600 dark:text-gray-400">{postsDesc}</p>
    </a>
    <a 
      href={memosUrl} 
      class="block p-6 border border-gray-200 dark:border-gray-700 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
    >
      <h3 class="text-lg font-semibold mb-2">{memosText}</h3>
      <p class="text-gray-600 dark:text-gray-400">{memosDesc}</p>
    </a>
    <a 
      href={timelineUrl} 
      class="block p-6 border border-gray-200 dark:border-gray-700 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
    >
      <h3 class="text-lg font-semibold mb-2">{timelineText}</h3>
      <p class="text-gray-600 dark:text-gray-400">{timelineDesc}</p>
    </a>
    <a 
      href={gridUrl} 
      class="block p-6 border border-gray-200 dark:border-gray-700 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
    >
      <h3 class="text-lg font-semibold mb-2">{gridText}</h3>
      <p class="text-gray-600 dark:text-gray-400">{gridDesc}</p>
    </a>
  </div>
</section> 