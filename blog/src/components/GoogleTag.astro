---
import { GOOGLE_TAG_ID } from "astro:env/client"
---

<!-- Google tag (gtag.js) -->
<script is:inline src={`https://www.googletagmanager.com/gtag/js?id=${GOOGLE_TAG_ID}`}></script>

<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag("js", new Date());
  
  gtag("consent", "default", {
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
      analytics_storage: "denied",
  });

  gtag("config", GOOGLE_TAG_ID);
</script>