---
export interface Props {
  children: string;
  class?: string;
}

const { children: code, class: className } = Astro.props;

// 언어 추출
const lang = className?.toString().split("-").at(-1)?.trim() || 'text';

// embed 처리
if (lang.includes("embed")) {
  const lines = code.split('\n');
  const props: Record<string, string> = {};
  
  lines.forEach(line => {
    const match = line.match(/^(\w+):\s*"([^"]*)"$/);
    if (match) {
      props[match[1]] = match[2];
    }
  });
  
  // EmbedCard 컴포넌트로 리다이렉트
  const { default: EmbedCard } = await import('./EmbedCard.astro');
  return <EmbedCard {...props} />;
}

// 기본 코드 블록 렌더링
---

<div class="relative">
  <button 
    class="absolute top-4 right-4 flex justify-center items-center p-0 w-[28px] h-[28px] transition-all ease-in duration-150 cursor-pointer copy-button"
    data-code={code}
  >
    <svg class="copy-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
    </svg>
    <svg class="check-icon hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="20,6 9,17 4,12"></polyline>
    </svg>
  </button>
  <pre class={className}><code>{code}</code></pre>
</div>

<script>
  // 복사 버튼 기능
  document.addEventListener('DOMContentLoaded', () => {
    const copyButtons = document.querySelectorAll('.copy-button');
    
    copyButtons.forEach(button => {
      button.addEventListener('click', async () => {
        const code = button.getAttribute('data-code');
        if (code) {
          await navigator.clipboard.writeText(code);
          
          const copyIcon = button.querySelector('.copy-icon');
          const checkIcon = button.querySelector('.check-icon');
          
          if (copyIcon && checkIcon) {
            copyIcon.classList.add('hidden');
            checkIcon.classList.remove('hidden');
            
            setTimeout(() => {
              copyIcon.classList.remove('hidden');
              checkIcon.classList.add('hidden');
            }, 2000);
          }
        }
      });
    });
  });
</script>

<style>
  .hidden {
    display: none;
  }
  
  pre {
    position: relative;
    background: #f6f8fa;
    border-radius: 6px;
    padding: 16px;
    overflow-x: auto;
  }
  
  code {
    font-family: 'SF Mono', Monaco, 'Cascadia Code', 'Roboto Mono', Consolas, 'Courier New', monospace;
    font-size: 14px;
    line-height: 1.5;
  }
  
  .copy-button {
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid #d0d7de;
    border-radius: 6px;
    color: #656d76;
  }
  
  .copy-button:hover {
    background: rgba(255, 255, 255, 1);
    border-color: #0969da;
    color: #0969da;
  }
</style> 