---
export interface Props {
  title?: string;
  image?: string;
  description?: string;
  url?: string;
  class?: string;
}

const { title = "", image = "", description = "", url = "", class: className } = Astro.props;
---

<a href={url} class:list={["no-underline", className]}>
  <div class="w-full h-32 flex-row items-center p-0 sm:p-2 rounded-md gap-4 overflow-hidden border border-gray-200 bg-white hover:shadow-md transition-shadow">
    <!-- 카드 헤더: 이미지 영역 -->
    <div class="basis-1/3 px-0 pl-1 h-full shrink-0">
      <img
        class="w-full h-full object-cover rounded"
        src={image}
        alt={title}
        loading="lazy"
      />
    </div>

    <!-- 카드 컨텐츠: 제목과 설명 -->
    <div class="basis-2/3 px-0 py-4">
      <h3 class="font-semibold text-gray-900 line-clamp-2 mb-2">{title}</h3>
      <p class="text-sm text-gray-600 line-clamp-2">{description}</p>
    </div>
  </div>
</a>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  a {
    text-decoration: none;
    color: inherit;
  }
  
  a:hover {
    text-decoration: none;
  }
</style> 