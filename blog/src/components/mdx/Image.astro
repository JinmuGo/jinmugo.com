---
export interface Props {
  src: string;
  alt?: string;
  width?: number;
  height?: number;
  class?: string;
}

const { src, alt, width, height, class: className } = Astro.props;

// 캡션 표시 여부 결정
const getShowCaption = () => {
  if (!alt) {
    return false;
  }

  const altParts = alt.split(".");
  // alt에 점이 없으면 설명으로 간주
  if (altParts.length < 2) {
    return true;
  }

  const name = altParts.slice(0, -1).join(".");
  const ext = altParts.at(-1);

  // URL에 alt의 이름과 확장자가 모두 포함되어 있으면 파일명으로 간주
  if (src.includes(name) && src.includes(ext ?? "")) {
    return false;
  }

  return true;
};

const showCaption = getShowCaption();
---

<div class="my-4 flex flex-col items-center">
  <img 
    src={src} 
    alt={alt} 
    width={width} 
    height={height}
    class:list={[className]}
    loading="lazy"
  />
  {showCaption && <div class="text-center text-sm text-gray-500 mt-2">{alt}</div>}
</div> 