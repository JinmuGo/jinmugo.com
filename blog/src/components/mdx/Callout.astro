---
export interface Props {
  type: 'note' | 'quote' | 'abstract' | 'important' | 'success' | 'question' | 'caution' | 'theorem';
  isFoldable?: boolean;
  defaultFolded?: boolean;
  title?: string;
  class?: string;
}

const { type = 'note', isFoldable = false, defaultFolded = false, title, class: className } = Astro.props;

const callouts = {
  note: {
    label: "Note",
    icon: "📝",
    className: {
      root: "border-blue-600/20 bg-blue-400/20 dark:border-blue-800/20 dark:bg-blue-600/10",
      title: "text-blue-500 dark:text-blue-400",
    },
  },
  quote: {
    label: "Quote",
    icon: "💬",
    className: {
      root: "border-zinc-600/20 bg-zinc-400/20 dark:border-zinc-800/20 dark:bg-zinc-600/15",
      title: "text-zinc-500",
    },
  },
  abstract: {
    label: "Abstract",
    icon: "🚀",
    className: {
      root: "bg-purple-500/10 border-purple-600/20 dark:border-purple-800/20",
      title: "text-purple-600 dark:text-purple-400",
    },
  },
  important: {
    label: "Important",
    icon: "📌",
    className: {
      root: "bg-purple-500/10 border-purple-600/20 dark:border-purple-800/20",
      title: "text-purple-600 dark:text-purple-400",
    },
  },
  success: {
    label: "Success",
    icon: "✅",
    className: {
      root: "bg-green-500/10 border-green-600/20 dark:border-green-800/20",
      title: "text-green-600 dark:text-green-400",
    },
  },
  question: {
    label: "Question",
    icon: "❓",
    className: {
      root: "bg-yellow-500/10 border-yellow-600/20 dark:border-yellow-800/20",
      title: "text-yellow-600 dark:text-yellow-400",
    },
  },
  caution: {
    label: "Caution",
    icon: "⚠️",
    className: {
      root: "bg-red-500/10 border-red-600/20 dark:border-red-800/20",
      title: "text-red-600 dark:text-red-400",
    },
  },
  theorem: {
    label: "Theorem",
    icon: "🧮",
    className: {
      root: "bg-purple-500/10 border-purple-600/20 dark:border-purple-800/20",
      title: "text-purple-600 dark:text-purple-400",
    },
  },
};

const callout = callouts[type] || callouts.note;
const displayTitle = title || callout.label;
---

{isFoldable ? (
  <details class:list={["group/root my-6 space-y-2 rounded-lg border bg-card p-4", callout.className.root, className]} open={!defaultFolded}>
    <summary class:list={["flex flex-row items-center gap-2 font-bold cursor-pointer", callout.className.title]}>
      <span class="text-xl">{callout.icon}</span>
      <div>{displayTitle}</div>
      <span class="text-xl transition-transform group-open/root:rotate-90">▶</span>
    </summary>
    <div class="flex flex-col gap-2 prose-lg-headings:my-0 prose-lg-p:my-0 prose-lg-blockquote:my-0 prose-lg-pre:my-0 prose-lg-ol:my-0 prose-lg-ul:my-0">
      <slot />
    </div>
  </details>
) : (
  <div class:list={["my-6 space-y-2 rounded-lg border bg-card p-4", callout.className.root, className]}>
    <div class:list={["flex flex-row items-center gap-2 font-bold", callout.className.title]}>
      <span class="text-xl">{callout.icon}</span>
      <div>{displayTitle}</div>
    </div>
    <div class="flex flex-col gap-2 prose-lg-headings:my-0 prose-lg-p:my-0 prose-lg-blockquote:my-0 prose-lg-pre:my-0 prose-lg-ol:my-0 prose-lg-ul:my-0">
      <slot />
    </div>
  </div>
)} 