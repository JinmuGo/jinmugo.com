---
export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["w-full overflow-x-auto", className]}>
  <table>
    <slot />
  </table>
</div>

<style>
  .overflow-x-auto {
    overflow-x: auto;
  }
  
  table {
    width: 100%;
    border-collapse: collapse;
  }
</style> 