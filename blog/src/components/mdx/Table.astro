---
export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class="my-6 w-full overflow-x-auto">
  <table class:list={["w-full border-collapse rounded-lg border border-gray-200 bg-white text-sm", className]}>
    <slot />
  </table>
</div>

<style>
  table {
    border-collapse: collapse;
  }
  
  th, td {
    padding: 12px 16px;
    text-align: left;
    border-bottom: 1px solid #e5e7eb;
  }
  
  th {
    font-weight: 600;
    background-color: #f9fafb;
    color: #111827;
  }
  
  tr:hover {
    background-color: #f9fafb;
  }
  
  tbody tr:last-child td {
    border-bottom: none;
  }
</style> 