---
import { callouts } from "./callout.astro"

export interface Props {
  type: string
  isFoldable: boolean | string
  className?: string
}
const { type, isFoldable, className } = Astro.props
const callout = callouts[type as keyof typeof callouts] ?? callouts.note
const isFoldableBool = isFoldable === true || isFoldable === "true"
---

{
  isFoldableBool ? (
    <details
      open={isFoldableBool}
      class={`group/root my-6 space-y-2 rounded-lg border bg-card p-4 ${callout.className.root} ${className ?? ""}`}
    >
      <slot />
    </details>
  ) : (
    <div
      class={`group/root my-6 space-y-2 rounded-lg border bg-card p-4 ${callout.className.root} ${className ?? ""}`}
    >
      <slot />
    </div>
  )
}
