---
export interface Props {
  id?: string;
  class?: string;
}

const { id, class: className } = Astro.props;
---

<div class:list={["heading", className]} id={id}>
  <slot />
  {id && (
    <a href={`#${id}`} class="anchor-link" aria-label="제목으로 이동">
      #
    </a>
  )}
</div>

<style>
  .heading {
    scroll-margin-top: 6rem;
    position: relative;
    margin: 2rem 0 1rem;
    line-height: 1.2;
  }
  
  .anchor-link {
    opacity: 0;
    margin-left: 0.5rem;
    text-decoration: none;
    color: #666;
    transition: opacity 0.2s;
  }
  
  .heading:hover .anchor-link {
    opacity: 1;
  }
  
  /* 제목 레벨별 스타일 */
  h1 {
    font-size: 2.5rem;
    font-weight: 700;
  }
  
  h2 {
    font-size: 2rem;
    font-weight: 600;
    margin: 1.5rem 0 1rem;
    line-height: 1.3;
  }
  
  h3 {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 1.25rem 0 0.75rem;
    line-height: 1.4;
  }
  
  h4 {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 1rem 0 0.5rem;
    line-height: 1.4;
  }
  
  h5 {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0.75rem 0 0.5rem;
    line-height: 1.4;
  }
  
  h6 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0.5rem 0 0.25rem;
    line-height: 1.4;
  }
</style> 