---
import type { BreadcrumbItem } from "@/utils/structuredData"

export interface Props {
  items: BreadcrumbItem[]
}

const { items } = Astro.props
---

<nav aria-label="Breadcrumb" class="relative z-100 mb-4 text-sm text-gray-600 dark:text-gray-400">
  <ol class="flex items-center flex-wrap gap-1">
    {items.map((item, index) => (
      <li class="flex items-center">
        {index > 0 && (
          <svg 
            class="w-3.5 h-3.5 mx-1.5 text-gray-400 dark:text-gray-500 flex-shrink-0" 
            fill="none" 
            stroke="currentColor" 
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        )}
        {index === items.length - 1 ? (
          <span class="font-medium text-gray-900 dark:text-gray-100 px-1 py-0.5 rounded" aria-current="page">
            {item.name}
          </span>
        ) : (
          <a 
            href={item.item} 
            class="hover:text-primary-500 dark:hover:text-primary-400 hover:underline underline-offset-2 transition-all duration-200 px-1 py-0.5 rounded-md hover:bg-gray-100 dark:hover:bg-gray-800/50"
          >
            {item.name}
          </a>
        )}
      </li>
    ))}
  </ol>
</nav> 