---
import { generatePostsPageSchema, buildPageUrl, buildItemUrl } from '@/utils/structuredData';
import { getKoreanPosts, sortPostsByDate } from '@/utils/posts';
import PageLayout from '@/components/PageLayout.astro';
import PostGrid from '@/components/PostGrid.astro';

// 모든 한국어 포스트 가져오기
const posts = await getKoreanPosts();
const sortedPosts = sortPostsByDate<"post">(posts);

const title = "Posts";
const description = "포스트 모음집입니다.";

// 구조화된 데이터 생성
const jsonLd = generatePostsPageSchema({
  title,
  description,
  url: buildPageUrl("", "/posts"),
  keywords: "posts, articles, collection",
  inLanguage: "ko",
  itemListElements: sortedPosts.map((post, index) => ({
    "@type": "ListItem",
    url: buildItemUrl(`/post/${post.data.category}/${post.slug}`),
    position: index + 1,
    item: {
      "@type": "Article",
      name: post.data.title,
      url: buildItemUrl(`/post/${post.data.category}/${post.slug}`),
    },
  })),
});
---

<PageLayout title={title} description={description} lang="ko" jsonLd={jsonLd}>
  <PostGrid posts={sortedPosts} />
</PageLayout> 