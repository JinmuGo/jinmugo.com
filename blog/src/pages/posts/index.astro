---
import PageLayout from "@/layouts/Layout.astro";
import ListLayouts from "@/layouts/ListLayouts";
import { getKoreanPosts, sortPostsByDate } from "@/utils/posts";
import {
	buildItemUrl,
	buildPageUrl,
	generatePostsPageSchema,
} from "@/utils/structuredData";
import StructuredData from "@/utils/structuredData.astro";

// 모든 한국어 포스트 가져오기
const posts = await getKoreanPosts();
const sortedPosts = sortPostsByDate<"post">(posts);

const title = "Posts";
const description = "Post collection";

const jsonLd = generatePostsPageSchema({
	title,
	description,
	url: buildPageUrl("", "/posts"),
	keywords: "posts, articles, collection",
	inLanguage: "ko",
	itemListElements: sortedPosts.map((post, index) => ({
		"@type": "ListItem",
		url: buildItemUrl(`/posts/${post.data.category}/${post.slug}`),
		position: index + 1,
		item: {
			"@type": "Article",
			name: post.data.title,
			url: buildItemUrl(`/posts/${post.data.category}/${post.slug}`),
		},
	})),
});
---

<PageLayout>
  <StructuredData schema={jsonLd} />
  <ListLayouts
    posts={sortedPosts.map((post) => ({
      ...post.data,
      slug: post.slug,
    }))}
    title={title}
    postType="post"
    client:load
  />
</PageLayout>
