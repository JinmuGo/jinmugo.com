---
import ArchiveSection from "@/components/content/ArchiveSection.astro"
import Breadcrumb from "@/components/seo/Breadcrumb.astro"
import Title from "@/components/layout/Title"
import { getEnglishMemos } from "@/utils/content/memos"
import { getEnglishPosts } from "@/utils/content/posts"
import Layout from "@/layouts/Layout.astro"
import { countBy } from "@/utils/cn"
import type { Memo, Post } from "@/types/content"
import { generateBreadcrumbItems } from "@/utils/breadcrumbUtils"
import { buildPageUrl, generateBreadcrumbSchema, generatePageSchema } from "@/utils/structuredData"

const posts = await getEnglishPosts()
const memos = await getEnglishMemos()

// 모든 콘텐츠를 하나로 합치기
const allContent = [
  ...posts.map((post: Post) => ({ ...post, type: post.type })),
  ...memos.map((memo: Memo) => ({ ...memo, type: memo.type })),
]

const years = countBy(allContent, (item) => new Date(item.data.date).getFullYear().toString())
const categories = countBy(allContent, (item) => item.data.category ?? [])
const tags = countBy(allContent, (item) => item.data.tags ?? [])

const title = "Archives"
const description = "Archives by category, tag, and year."
const url = buildPageUrl("/en", "/archives")

// Breadcrumb 항목 생성
const breadcrumbItems = generateBreadcrumbItems({
  pathname: "/en/archives",
  origin: url.replace("/en/archives", ""),
  lang: "en",
})

const pageSchema = generatePageSchema({
  type: "CollectionPage",
  title,
  description,
  url,
  keywords: "archives, category, tag, year, collection",
  inLanguage: "en",
})

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbItems)
const jsonLd = [pageSchema, breadcrumbSchema]
---

<Layout 
  title={title} 
  description={description} 
  lang="en"
  jsonLd={jsonLd}
  type="website"
>
  <Breadcrumb items={breadcrumbItems} class="mb-4" />
  <div class="space-y-2 pt-6 pb-8 md:space-y-5">
    <Title>Archives</Title>
  </div>

  <ArchiveSection
    title="Year"
    items={years}
    baseUrl="/en/archives/year/"
    itemClass="font-medium"
  />
  <ArchiveSection
    title="Category"
    items={categories}
    baseUrl="/en/archives/category/"
    itemClass="font-medium"
  />
  {
    Object.keys(tags).length > 0 && (
      <ArchiveSection
        title="Tag"
        items={tags}
        baseUrl="/en/archives/tag/"
        itemClass="font-medium"
      />
    )
  }
</Layout>
