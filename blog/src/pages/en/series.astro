---
import SeriesListIsland from "@/components/SeriesListIsland.tsx"
import { getEnglishPosts } from "@/content-utils/posts"
import Layout from "@/layouts/Layout.astro"
import type { Post } from "@/types/content"
import { buildPageUrl, generatePageSchema } from "@/utils/structuredData"

interface Series {
  name: string
  posts: Post[]
  totalPosts: number
}

function groupPostsBySeries(posts: Post[]): Series[] {
  const map = new Map<string, Series>()
  posts.forEach((post) => {
    const series = post.data.series
    if (!series) {
      return
    }
    if (!map.has(series)) {
      map.set(series, { name: series, posts: [], totalPosts: 0 })
    }
    const seriesObj = map.get(series)
    if (seriesObj) {
      seriesObj.posts.push(post)
      seriesObj.totalPosts++
    }
  })
  return Array.from(map.values())
}

const posts = await getEnglishPosts()
const seriesList = groupPostsBySeries(posts)

const title = "Series"
const description = "Blog series collection."
const jsonLd = generatePageSchema({
  type: "CollectionPage",
  title,
  description,
  url: buildPageUrl("/en", "/series"),
  keywords: "series, blog series, collections",
  inLanguage: "en",
  itemListElements: seriesList.map((series, idx) => ({
    "@type": "ListItem",
    url: `/en/series/${encodeURIComponent(series.name)}`,
    position: idx + 1,
    item: {
      "@type": "Collection",
      name: series.name,
      description: `${series.totalPosts} posts`,
      url: `/en/series/${encodeURIComponent(series.name)}`,
    },
  })),
})
---

<Layout 
  title={title} 
  description={description} 
  lang="en"
  jsonLd={jsonLd}
>
  <SeriesListIsland seriesList={seriesList} client:load />
</Layout>
