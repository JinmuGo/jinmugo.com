---
import { generatePostsPageSchema, buildPageUrl, buildItemUrl } from '@/utils/structuredData';
import { getEnglishPosts, sortPostsByDate } from '@/utils/posts';
import PageLayout from '@/components/PageLayout.astro';
import PostGrid from '@/components/PostGrid.astro';

// 모든 영어 포스트 가져오기
const posts = await getEnglishPosts();
const sortedPosts = sortPostsByDate<"post">(posts);

const title = "Posts";
const description = "A collection of posts.";

// 구조화된 데이터 생성
const jsonLd = generatePostsPageSchema({
  title,
  description,
  url: buildPageUrl("/en", "/posts"),
  keywords: "posts, articles, collection",
  inLanguage: "en",
  itemListElements: sortedPosts.map((post, index) => ({
    "@type": "ListItem",
    url: buildItemUrl(`/en/post/${post.data.category}/${post.slug}`),
    position: index + 1,
    item: {
      "@type": "Article",
      name: post.data.title,
      url: buildItemUrl(`/en/post/${post.data.category}/${post.slug}`),
    },
  })),
});
---

<PageLayout title={title} description={description} lang="en" jsonLd={jsonLd}>
  <PostGrid posts={sortedPosts} basePath="/en" />
</PageLayout> 