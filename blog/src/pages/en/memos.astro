---
import { generatePostsPageSchema, buildPageUrl, buildItemUrl } from '@/utils/structuredData';
import { getEnglishMemos, sortMemosByDate } from '@/utils/memos';
import PageLayout from '@/components/PageLayout.astro';
import MemoGrid from '@/components/MemoGrid.astro';

// 모든 영어 메모 가져오기
const memos = await getEnglishMemos();
const sortedMemos = sortMemosByDate(memos);

const title = "Memos";
const description = "A collection of memos.";

// 구조화된 데이터 생성
const jsonLd = generatePostsPageSchema({
  title,
  description,
  url: buildPageUrl("/en", "/memos"),
  keywords: "memos, notes, collection",
  inLanguage: "en",
  itemListElements: sortedMemos.map((memo, index) => ({
    "@type": "ListItem",
    url: buildItemUrl(`/en/memo/${memo.slug}`),
    position: index + 1,
    item: {
      "@type": "Article",
      name: memo.data.title,
      url: buildItemUrl(`/en/memo/${memo.slug}`),
    },
  })),
});
---

<PageLayout title={title} description={description} lang="en" jsonLd={jsonLd}>
  <MemoGrid memos={sortedMemos} basePath="/en" />
</PageLayout> 