---
import { type CollectionEntry } from "astro:content";
import { components } from "@/components/mdx/components.astro";
import PhotoSwipe from "@/components/PhotoSwipe.astro";
import PostBannerX from "@/layouts/PostBannerX.astro";
import PostBannerY from "@/layouts/PostBannerY.astro";
import PostDefault from "@/layouts/PostDefault.astro";
import { getBannerImageBySlug } from "@/utils/banner.astro";
import { getEnglishPosts } from "@/utils/posts";

export async function getStaticPaths() {
	const posts = await getEnglishPosts();

	return posts.map((entry: CollectionEntry<"post">) => {
		return {
			params: {
				category: entry.data.category,
				slug: entry.slug,
			},
			props: { entry, slug: entry.slug },
		};
	});
}

const { entry, slug }: { entry: CollectionEntry<"post">; slug: string } =
	Astro.props;
const { Content } = await entry.render();
const frontmatterWithSlug = {
	...entry.data,
	slug,
};

const bannerImage = getBannerImageBySlug(slug);
let layout = "PostDefault";
if (bannerImage) {
	const { width, height } = bannerImage;
	if (width > height) {
		layout = "PostBannerX";
	} else {
		layout = "PostBannerY";
	}
}
---

{
  layout === "PostDefault" && (
    <PostDefault frontmatter={frontmatterWithSlug}>
      <Content components={components} />
    </PostDefault>
  )
}

{
  layout === "PostBannerX" && (
    <PostBannerX frontmatter={frontmatterWithSlug} bannerImage={bannerImage!}>
      <Content components={components} />
    </PostBannerX>
  )
}

{
  layout === "PostBannerY" && (
    <PostBannerY frontmatter={frontmatterWithSlug} bannerImage={bannerImage!}>
      <Content components={components} />
    </PostBannerY>
  )
}

<PhotoSwipe />
