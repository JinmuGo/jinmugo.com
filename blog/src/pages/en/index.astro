---
import { Image } from "astro:assets";
import Bleed from "@/components/Bleed.astro";
import PostTimeline from "@/components/Timeline/PostTimeline.astro";
import siteMetadata from "@/consts";
import Layout from "@/layouts/Layout.astro";
import { getEnglishPosts, sortPostsByDate } from "@/utils/posts";
import { generatePageSchema } from "@/utils/structuredData";
import StructuredData from "@/utils/structuredData.astro";
import HeroImageSrc from "~/public/sea-boat.webp";

const posts = await getEnglishPosts();
const sortedPosts = sortPostsByDate<"post">(posts);

const title = siteMetadata.title;
const description = siteMetadata.description;
const url = `${siteMetadata.siteUrl}/en`;
const jsonLd = generatePageSchema({
	title,
	description,
	url,
	keywords: "blog, posts, timeline",
	inLanguage: "en",
});
---

<Layout title={title} description={description}>
  <StructuredData schema={jsonLd} />
  <Bleed>
    <Image
      src={HeroImageSrc}
      alt="boat"
      class="object-cover w-full h-full"
      loading="eager"
      fetchpriority="high"
      data-blur-src="sea-boat-blur.webp"
    />
  </Bleed>
  <PostTimeline posts={sortedPosts} />
</Layout>
