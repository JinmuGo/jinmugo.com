---
import { Image } from "astro:assets";
import Breadcrumb from "@/components/seo/Breadcrumb.astro";
import { generateBreadcrumbItems } from "@/utils/breadcrumbUtils";
import {
  buildPageUrl,
  generateBreadcrumbSchema,
  generatePageSchema,
} from "@/utils/structuredData";
import pkg from "~/package.json";
import Layout from "@/layouts/Layout.astro";
import { ObsidianDownloadCount } from "@/components/features/ObsidianDownloadCount";
import { PortfolioList } from "@/components/features/PortfolioList";
import { getEnglishPortfolio } from "@/utils/content/apps";

// GitHub stars를 빌드 타임에 가져오는 함수
async function fetchGitHubStars(
  owner: string,
  repo: string,
): Promise<number | null> {
  try {
    const token = import.meta.env.GITHUB_TOKEN;
    const headers: HeadersInit = {
      Accept: "application/vnd.github.v3+json",
      "User-Agent": "jinmu.me-portfolio",
    };

    // GitHub Token이 있으면 사용 (rate limit 증가)
    if (token) {
      headers.Authorization = `Bearer ${token}`;
    }

    const response = await fetch(
      `https://api.github.com/repos/${owner}/${repo}`,
      {
        headers,
      },
    );

    // Rate limit 체크
    const remaining = response.headers.get("x-ratelimit-remaining");
    const resetTime = response.headers.get("x-ratelimit-reset");

    if (response.status === 403) {
      // Rate limit 초과 시 조용히 실패
      if (remaining === "0" && resetTime) {
        const resetDate = new Date(parseInt(resetTime) * 1000);
        console.warn(
          `GitHub API rate limit exceeded. Resets at: ${resetDate.toLocaleString()}`,
        );
      }
      return null;
    }

    if (!response.ok) {
      // 403 외의 다른 에러는 조용히 처리
      return null;
    }

    const data = await response.json();
    return data.stargazers_count ?? 0;
  } catch (error) {
    // 네트워크 에러 등은 조용히 처리
    return null;
  }
}

// Breadcrumb 항목 생성
const breadcrumbItems = generateBreadcrumbItems({
  pathname: "/en/portfolio",
  origin: pkg.homepage,
  lang: "en",
  title: "Portfolio",
});

const pageSchema = generatePageSchema({
  title: "Portfolio",
  description: "Jinmu's Portfolio",
  url: buildPageUrl(pkg.homepage, "/en/portfolio"),
  keywords: "portfolio, projects, works",
  inLanguage: "en",
});

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbItems);
const jsonLd = [pageSchema, breadcrumbSchema];

const title = "Portfolio";
const description = "Portfolio of Jinmu Ko, Developer Finding Leverage Points";

// Portfolio 데이터를 마크다운 파일에서 가져오기
const portfolio = await getEnglishPortfolio();
const portfolioData = portfolio[0]?.data || {
  name: "Jinmu Ko",
  philosophy: `My name 撫 (Mu) carries the meaning of 'soothing formless things by hand.'
Discovering invisible problems like user inconveniences,
and solving them one by one with code, I am a developer growing through this process.`,
  contact: {
    email: "hi@jinmu.me",
    github: "https://github.com/JinmuGo",
  },
  sections: [],
};

const intro = {
  name: portfolioData.name,
  philosophy: portfolioData.philosophy,
  contact: portfolioData.contact,
};

// 섹션 데이터 구조 (마크다운에서 가져온 데이터 사용)
const sections = portfolioData.sections || [];

// opensource 섹션의 stars 초기화 및 빌드 타임에 GitHub stars 가져오기
const opensourceSection = sections.find((s: any) => s.type === "opensource");
if (opensourceSection) {
  for (let i = 0; i < opensourceSection.data.length; i++) {
    const project = opensourceSection.data[i] as any;
    // stars가 없으면 null로 초기화
    if (project.stars === undefined) {
      project.stars = null;
    }
    if (project.githubRepo && project.stars === null) {
      const [owner, repo] = project.githubRepo.split("/");
      project.stars = await fetchGitHubStars(owner, repo);
      // Rate limit 방지를 위해 요청 간 딜레이 (마지막 요청 제외)
      if (i < opensourceSection.data.length - 1) {
        await new Promise((resolve) => setTimeout(resolve, 500));
      }
    }
  }
}
---

<Layout
  title={title}
  description={description}
  lang="en"
  jsonLd={jsonLd}
  type="website"
>
  <Breadcrumb items={breadcrumbItems} />

  <!-- Intro Section -->
  <section class="pb-12">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-4">
      {intro.name}
    </h1>
    <blockquote
      class="border-l-4 border-primary-500 pl-4 mb-8 text-base text-gray-700 dark:text-gray-300 italic whitespace-pre-line"
    >
      {intro.philosophy}
    </blockquote>
    <div class="flex flex-wrap gap-4 text-sm text-gray-600 dark:text-gray-400">
      <a
        href={`mailto:${intro.contact.email}`}
        class="flex items-center gap-1 group hover:text-primary-600 dark:hover:text-primary-400"
      >
        <svg
          class="w-4 h-4 fill-current text-gray-600 dark:text-gray-400"
          viewBox="0 0 24 24"
        >
          <path
            d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
          ></path>
        </svg>
        <span
          class="group-hover:text-primary-600 dark:group-hover:text-primary-400"
        >
          {intro.contact.email}
        </span>
      </a>
      <a
        href={intro.contact.github}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1 group"
      >
        <svg
          class="w-4 h-4 fill-current text-gray-600 dark:text-gray-400"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
          ></path>
        </svg>
        <span
          class="group-hover:text-primary-600 dark:group-hover:text-primary-400"
          >GitHub</span
        >
      </a>
    </div>
  </section>

  {
    sections.map((section: any) => {
      if (section.type === "skills") {
        return (
          <section class="border-t border-gray-200 dark:border-gray-700 pt-12 pb-12">
            <h2
              class={`${section.titleClass} text-xl font-bold text-gray-900 dark:text-gray-100 mb-8`}
            >
              {section.title}
            </h2>
            <div class="space-y-12">
              {(section.data as any[]).map((skill: any) => (
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                  <div>
                    <h3 class="text-base font-medium text-gray-900 dark:text-gray-100">
                      {skill.category}
                    </h3>
                  </div>
                  <div class="md:col-span-3">
                    <ul class="space-y-2 text-base text-gray-700 dark:text-gray-300">
                      {skill.items.map((item: string) => (
                        <li>• {item}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              ))}
            </div>
          </section>
        );
      }

      if (section.type === "projects") {
        return (
          <section class="border-t border-gray-200 dark:border-gray-700 pt-12 pb-12">
            <h2
              class={`${section.titleClass} text-xl font-bold text-gray-900 dark:text-gray-100 mb-8`}
            >
              {section.title}
            </h2>
            <PortfolioList client:load projects={section.data as any[]} />
            <div class="mt-12 flex justify-center">
              <a
                href="/en/projects"
                class="inline-flex items-center gap-2 px-6 py-3 text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 border border-gray-300 dark:border-gray-600 rounded-lg hover:border-gray-900 dark:hover:border-gray-400 transition-colors"
              >
                <span>All Projects</span>
                <svg
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M7 17L17 7M17 7H7M17 7V17" />
                </svg>
              </a>
            </div>
          </section>
        );
      }

      if (section.type === "opensource") {
        return (
          <section class="border-t border-gray-200 dark:border-gray-700 pt-12 pb-12">
            <h2
              class={`${section.titleClass} text-xl font-bold text-gray-900 dark:text-gray-100 mb-8`}
            >
              {section.title}
            </h2>
            <div class="space-y-12">
              {(section.data as any[]).map((project: any) => (
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                  <div>
                    {project.github ? (
                      <div class="flex items-center gap-2">
                        <a
                          href={project.github}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="flex items-center gap-2 text-base font-medium text-gray-900 dark:text-gray-100 hover:text-primary-600 dark:hover:text-primary-400"
                        >
                          <h3>{project.name}</h3>
                          <svg
                            class="w-[18px] h-[18px]"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            aria-hidden="true"
                          >
                            <path d="M7 17L17 7M17 7H7M17 7V17" />
                          </svg>
                        </a>
                      </div>
                    ) : (
                      <h3 class="text-base font-medium text-gray-900 dark:text-gray-100">
                        {project.name}
                      </h3>
                    )}
                    {project.role && (
                      <p class="text-gray-400 dark:text-gray-500 text-sm mt-1">
                        {project.role}
                      </p>
                    )}
                    {project.obsidianPluginId && (
                      <div class="mt-1">
                        <ObsidianDownloadCount
                          client:load
                          pluginId={project.obsidianPluginId}
                        />
                      </div>
                    )}
                  </div>
                  <div class="md:col-span-3">
                    <p class="text-gray-700 dark:text-gray-300 mb-3 whitespace-pre-line">
                      {project.description}
                    </p>
                    {project.tech && (
                      <div class="flex items-center text-sm text-gray-500 dark:text-gray-400">
                        <span>{project.tech}</span>
                        {project.stars !== null &&
                          project.stars !== undefined && (
                            <>
                              <span class="mx-4">•</span>
                              <span>
                                {project.stars.toLocaleString()} stars
                              </span>
                            </>
                          )}
                      </div>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </section>
        );
      }

      if (section.type === "experiences") {
        return (
          <section class="border-t border-gray-200 dark:border-gray-700 pt-12 pb-12">
            <h2
              class={`${section.titleClass} text-xl font-bold text-gray-900 dark:text-gray-100 mb-8`}
            >
              {section.title}
            </h2>
            <div class="space-y-12">
              {(section.data as any[]).map((exp: any) => (
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                  <div>
                    {exp.github ? (
                      <div class="flex items-center gap-2">
                        <a
                          href={exp.github}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="flex items-center gap-2 text-base font-medium text-gray-900 dark:text-gray-100 hover:text-primary-600 dark:hover:text-primary-400"
                        >
                          <h3>{exp.name}</h3>
                          <svg
                            class="w-[18px] h-[18px]"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            aria-hidden="true"
                          >
                            <path d="M7 17L17 7M17 7H7M17 7V17" />
                          </svg>
                        </a>
                      </div>
                    ) : (
                      <h3 class="text-base font-medium text-gray-900 dark:text-gray-100">
                        {exp.name}
                      </h3>
                    )}
                    {exp.role && (
                      <p class="text-gray-400 dark:text-gray-500 text-sm mt-1">
                        {exp.role}
                      </p>
                    )}
                    {exp.award && (
                      <p class="text-gray-400 dark:text-gray-500 text-sm mt-1">
                        {exp.award}
                      </p>
                    )}
                  </div>
                  <div class="md:col-span-3">
                    <p class="text-gray-700 dark:text-gray-300 mb-3 whitespace-pre-line">
                      {exp.description}
                    </p>
                    <div class="flex flex-wrap gap-3 text-sm">
                      {exp.blog && (
                        <a
                          href={exp.blog}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="flex items-center gap-1 text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400"
                        >
                          <svg
                            class="w-3.5 h-3.5 fill-current"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                          >
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm4 18H6V4h7v5h5v11z" />
                          </svg>
                          <span class="hover:underline">Blog</span>
                        </a>
                      )}
                      {exp.news && (
                        <a
                          href={exp.news}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="flex items-center gap-1 text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400"
                        >
                          <svg
                            class="w-3.5 h-3.5 fill-current"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                          >
                            <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z" />
                          </svg>
                          <span class="hover:underline">News</span>
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>
        );
      }

      if (section.type === "certifications") {
        return (
          <section class="border-t border-gray-200 dark:border-gray-700 pt-12 pb-12">
            <h2
              class={`${section.titleClass} text-xl font-bold text-gray-900 dark:text-gray-100 mb-8`}
            >
              {section.title}
            </h2>
            <div class="space-y-1">
              {(section.data as any[]).map((cert: any) => {
                const isFeatured = cert.image;
                return (
                  <div
                    class={`py-8 px-6 -mx-6 rounded-lg ${
                      isFeatured
                        ? "bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700"
                        : ""
                    }`}
                  >
                    {/* Header with Title */}
                    <div class="flex items-center justify-between gap-4 mb-3">
                      <span class="w-2 h-2 rounded-full bg-gray-900 dark:bg-gray-100" />
                      <div class="flex-1">
                        {cert.link ? (
                          <div class="flex items-center gap-3">
                            <a
                              href={cert.link}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="flex items-center gap-2 text-gray-900 dark:text-gray-100 hover:text-primary-600 dark:hover:text-primary-400"
                            >
                              <h3>{cert.name}</h3>
                              <svg
                                class="w-[18px] h-[18px]"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                aria-hidden="true"
                              >
                                <path d="M7 17L17 7M17 7H7M17 7V17" />
                              </svg>
                            </a>
                          </div>
                        ) : (
                          <h3 class="text-gray-900 dark:text-gray-100">
                            {cert.name}
                          </h3>
                        )}
                      </div>
                    </div>

                    {/* Featured Image - supports both relative paths and external URLs */}
                    {isFeatured && (
                      <div class="mb-4 rounded-lg overflow-hidden flex items-center justify-start">
                        <img
                          src={cert.image}
                          alt={cert.name}
                          class="max-h-64 w-auto object-contain"
                        />
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          </section>
        );
      }

      return null;
    })
  }
</Layout>
