---
import { Image } from "astro:assets";
import { getKoreanApp } from "@/utils/content/apps";
import { generateBreadcrumbItems } from "@/utils/breadcrumbUtils";
import {
  buildPageUrl,
  generateBreadcrumbSchema,
  generatePageSchema,
} from "@/utils/structuredData";
import pkg from "~/package.json";
import Layout from "../layouts/Layout.astro";

// Breadcrumb 항목 생성
const breadcrumbItems = generateBreadcrumbItems({
  pathname: "/about",
  origin: buildPageUrl(pkg.homepage, ""),
  lang: "ko",
  title: "About",
});

const pageSchema = generatePageSchema({
  title: "About",
  description: "About Jinmu",
  url: buildPageUrl(pkg.homepage, "/about"),
  keywords: "about, author, profile",
  inLanguage: "ko",
});

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbItems);
const jsonLd = [pageSchema, breadcrumbSchema];

const app = await getKoreanApp();
const { name, bio, avatar } = app[0].data;
const { Content } = await app[0].render();
const title = "About";
const description = "About Jinmu";
---

<Layout
  title={title}
  description={description}
  image={avatar}
  lang="ko"
  jsonLd={jsonLd}
  type="website"
>
  <section class="relative w-full mx-auto aspect-square sm:aspect-video">
    <Image src={avatar} alt={name} width={1200} height={300} loading="eager" />
    <div class="absolute bottom-6 left-6 text-white drop-shadow-lg">
      <h1
        class="text-3xl leading-9 font-extrabold tracking-tight text-gray-50 sm:text-4xl sm:leading-10 md:text-6xl md:leading-14 dark:text-gray-200"
      >
        {name}
      </h1>
      <h2
        class="text-sm sm:text-lg leading-8 font-medium text-gray-100 dark:text-gray-300"
      >
        {bio}
      </h2>
    </div>
  </section>
  {
    Content && (
      <div class="prose dark:prose-invert max-w-none pt-8 pb-8 xl:col-span-2">
        <Content />
      </div>
    )
  }

  <!-- Portfolio Link Section -->
  <a
    href="/portfolio"
    class="inline-flex items-center gap-2 px-6 py-3 bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 rounded-lg hover:bg-gray-800 dark:hover:bg-gray-200 transition-colors font-medium"
  >
    Portfolio
    <svg
      width="16"
      height="16"
      viewBox="0 0 16 16"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="rotate-45"
    >
      <path
        d="M3.13523 8.84197C3.3241 9.04343 3.64052 9.05363 3.84197 8.86477L7.5 5.43536L11.158 8.86477C11.3595 9.05363 11.6759 9.04343 11.8648 8.84197C12.0536 8.64051 12.0434 8.32409 11.842 8.13523L7.84197 4.38523C7.64964 4.20492 7.35036 4.20492 7.15803 4.38523L3.15803 8.13523C2.95657 8.32409 2.94637 8.64051 3.13523 8.84197Z"
        fill="currentColor"
        fill-rule="evenodd"
        clip-rule="evenodd"></path>
    </svg>
  </a>
</Layout>
