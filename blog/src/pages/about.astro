---
import { Image } from "astro:assets";
import { getCollection, type CollectionEntry } from "astro:content";
import { buildPageUrl, generatePageSchema } from "@/utils/structuredData";
import StructuredData from "@/utils/structuredData.astro";
import Layout from "../layouts/Layout.astro";
import siteMetadata from "@/consts";

const jsonLd = generatePageSchema({
  title: "About",
  description: "About Jinmu",
  url: buildPageUrl(siteMetadata.siteUrl, "/about"),
  keywords: "about, author, profile",
  inLanguage: "ko",
});

const pathname = Astro.url.pathname.includes("/en") ? "abouten" : "about";
const app = await getCollection(
  "app",
  (item: CollectionEntry<"app">) => item.slug === pathname,
);
const { name, bio, avatar } = app[0].data;
const { Content } = await app[0].render();
---

<Layout>
  <StructuredData schema={jsonLd} />
  <>
    <div class="relative w-full mx-auto aspect-square sm:aspect-[16/9]">
      <Image
        src={avatar}
        alt={name}
        width={1200}
        height={300}
        loading="eager"
      />
      <div class="absolute bottom-6 left-6 text-white drop-shadow-lg">
        <h1
          class="text-3xl leading-9 font-extrabold tracking-tight text-gray-50 sm:text-4xl sm:leading-10 md:text-6xl md:leading-14 dark:text-gray-200"
        >
          {name}
        </h1>
        <h2
          class="text-sm sm:text-lg leading-8 font-medium text-gray-100 dark:text-gray-300"
        >
          {bio}
        </h2>
      </div>
    </div>
    <div class="prose dark:prose-invert max-w-none pt-8 pb-8 xl:col-span-2">
      <Content />
    </div>
  </>
</Layout>
