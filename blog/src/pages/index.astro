---
import { Image } from "astro:assets"
import Bleed from "@/components/Bleed.astro"
import PostTimeline from "@/components/Timeline/PostTimeline.astro"
import { getKoreanMemos, sortMemosByDate } from "@/content-utils/memos"
import { getKoreanPosts, sortPostsByDate } from "@/content-utils/posts"
import Layout from "@/layouts/Layout.astro"
import {
  generateOrganizationSchema,
  generatePageSchema,
  generateWebsiteSchema,
} from "@/utils/structuredData"
import pkg from "~/package.json"
import Avatar from "~/public/avatar.webp"
import HeroImageSrc from "~/public/sea-boat.webp"

const posts = await getKoreanPosts()
const memos = await getKoreanMemos()
const sortedPosts = sortPostsByDate(posts)
const sortedMemos = sortMemosByDate(memos)

const title = pkg.title
const description = pkg.description
const url = pkg.homepage
// 최신 포스트와 메모를 ItemList로 구성
const recentPosts = sortedPosts.slice(0, 5)
const recentMemos = sortedMemos.slice(0, 5)

// Website 스키마
const websiteSchema = generateWebsiteSchema({
  name: title,
  url,
  description,
  inLanguage: "ko",
  potentialAction: {
    "@type": "SearchAction",
    target: `${url}/search?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
})

// Organization 스키마
const organizationSchema = generateOrganizationSchema({
  name: title,
  url,
  description,
  logo: `${url}/avatar.webp`,
  sameAs: ["https://github.com/jinmugo", "https://twitter.com/jinmugo"],
})

// 페이지 스키마
const pageSchema = generatePageSchema({
  title,
  description,
  url,
  keywords: "blog, posts, memos, timeline",
  inLanguage: "ko",
  itemListElements: [
    ...recentPosts.map((post, index) => ({
      "@type": "ListItem" as const,
      url: post.href,
      position: index + 1,
      item: {
        "@type": "BlogPosting" as const,
        name: post.data.title,
        url: post.href,
        description: post.data.summary,
      },
    })),
    ...recentMemos.map((memo, index) => ({
      "@type": "ListItem" as const,
      url: memo.href,
      position: recentPosts.length + index + 1,
      item: {
        "@type": "Article" as const,
        name: memo.data.title,
        url: memo.href,
        description: memo.data.summary,
      },
    })),
  ],
})

const jsonLd = [websiteSchema, organizationSchema, pageSchema]
---

<Layout
  title={title}
  description={description}
  image={Avatar}
  lang="ko"
  jsonLd={jsonLd}
  type="website"
>
  <Bleed>
    <Image
      src={HeroImageSrc}
      alt="boat"
      class="object-cover w-full h-full"
      loading="eager"
      fetchpriority="high"
      data-blur-src="sea-boat-blur.webp"
    />
  </Bleed>
  <PostTimeline posts={sortedPosts} memos={sortedMemos} />
</Layout>
