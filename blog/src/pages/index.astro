---
import { getKoreanPosts, sortPostsByDate } from "@/utils/posts";
import Layout from "@/layouts/Layout.astro";
import HeroImage from "@/components/HeroImage.astro";
import PostTimeline from "@/components/Timeline/PostTimeline.astro";
import Bleed from "@/components/Bleed.astro";
import HeroImageSrc from "~/public/sea-boat.webp";

const posts = await getKoreanPosts();
const sortedPosts = sortPostsByDate<"post">(posts);
---

<Layout>
  <Bleed>
    <HeroImage src={HeroImageSrc} alt="boat" blurSrc="sea-boat-blur.webp" />
  </Bleed>
  <PostTimeline posts={sortedPosts} />
</Layout>
