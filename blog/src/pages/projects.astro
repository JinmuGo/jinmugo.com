---
import Title from "@/components/Title";
import {
	Popover,
	PopoverContent,
	PopoverTrigger,
} from "@/components/ui/popover";
import siteMetadata from "@/consts";
import Layout from "@/layouts/Layout.astro";
import {
	type Project,
	type ProjectSection,
	projectsData,
} from "@/utils/projectsData";
import { generatePageSchema } from "@/utils/structuredData";
import StructuredData from "@/utils/structuredData.astro";

const cdnUrl = `${siteMetadata.siteUrl}/banner/`;

function groupBySection(projects: Project[]): ProjectSection {
	return projects.reduce((acc: ProjectSection, cur: Project) => {
		if (cur.section in acc) {
			acc[cur.section]?.push(cur);
		} else {
			acc[cur.section] = [cur];
		}
		return acc;
	}, {} as ProjectSection);
}

const projects: ProjectSection = groupBySection(projectsData);

const title = "Projects";
const description = "프로젝트 모음집입니다.";
const url = `${siteMetadata.siteUrl}/projects`;
const jsonLd = generatePageSchema({
	title,
	description,
	url,
	keywords: "projects, portfolio, collection",
	inLanguage: "ko",
});
---

<Layout title={title} description={description} lang="ko">
  <StructuredData schema={jsonLd} />
  {
    Object.entries(projects).map(([section, projects]: [string, Project[]]) => (
      <section class="my-2">
        <Title className="capitalize">{section}</Title>
        <ul class="pl-4 my-4 list-disc">
          {projects.map((project: Project) => (
            <li class="mb-3">
              {project.hasPreview ? (
                <Popover>
                  <PopoverTrigger asChild>
                    <a
                      href={project.href}
                      class="text-blue-600 dark:text-blue-500 font-bold cursor-pointer"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {project.name}
                    </a>
                  </PopoverTrigger>
                  <PopoverContent className="w-64 p-0 shadow-lg">
                    <img
                      src={cdnUrl + project.name + ".jpg"}
                      alt={project.name + " 대표 이미지"}
                      width={256}
                      height={160}
                      class="rounded-md object-cover"
                      loading="lazy"
                    />
                  </PopoverContent>
                </Popover>
              ) : (
                <a
                  href={project.href}
                  class="text-blue-600 dark:text-blue-500 font-bold"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {project.name}
                  {project.person !== undefined && project.person === 1
                    ? ""
                    : project.person !== undefined
                      ? `(${project.person} people)`
                      : ""}
                </a>
              )}
              <span class="text-gray-600 dark:text-gray-400">
                : {project.description}
              </span>
              {project.subProject && (
                <ul class="pl-4 my-4 list-disc">
                  {project.subProject.map((sub: Project) => (
                    <li class="mb-3">
                      <a
                        href={sub.href}
                        class="text-blue-600 dark:text-blue-500 font-bold"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {sub.name}
                      </a>
                      <span class="text-gray-600 dark:text-gray-400">
                        : {sub.description}
                      </span>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Layout>
